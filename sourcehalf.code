'use client'

import { useRef, useState } from 'react'
import { CircleCheck, CloudUpload, FileText, LoaderCircle, Lock, Trash2, TriangleAlert } from 'lucide-react'
import { MAX_UPLOADS, useStudyVerse } from './store'
import { DemoBadge, PageIntro, ProgressBar } from './ui'

const PIPELINE = ['Extract text from each page', 'Keep source details (file, page, heading)', 'Split text into study-sized chunks', 'Create embeddings for each chunk', 'Index for resource-specific questions']

function formatSize(bytes: number) {
  if (bytes < 1024) return `${bytes} B`
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`
}

export function UploadResources({ onNotify }: { onNotify: (message: string) => void }) {
  const { uploads, addUploads, removeUpload } = useStudyVerse()
  const inputRef = useRef<HTMLInputElement>(null)
  const [dragging, setDragging] = useState(false)
  const received = uploads.filter((u) => u.status === 'received')

  const handleFiles = async (list: FileList | null) => {
    if (!list?.length) return
    await addUploads([...list])
    if (inputRef.current) inputRef.current.value = ''
  }

  return (
    <section>
      <PageIntro eyebrow="Upload Resources" title="Bring your own study materials" description="Add class notes, worksheets or other PDFs you're allowed to use. Later, StudyVerse will be able to answer questions and build practice from them." badge={<DemoBadge>Prototype · backend pending</DemoBadge>} />

      <div className="mt-8 grid gap-6 lg:grid-cols-[1.2fr_0.8fr]">
        <div className="space-y-6">
          <div
            onDragOver={(e) => { e.preventDefault(); setDragging(true) }}
            onDragLeave={() => setDragging(false)}
            onDrop={(e) => { e.preventDefault(); setDragging(false); handleFiles(e.dataTransfer.files) }}
            className={`rounded-3xl border-2 border-dashed p-8 text-center transition ${dragging ? 'border-[#247eb7] bg-[#eaf5fb]' : 'border-[#d6e2ea] bg-white'}`}
          >
            <span className="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-[#eaf5fb] text-[#247eb7]"><CloudUpload size={26} /></span>
            <p className="mt-4 text-sm font-semibold text-[#34433b]">Drag PDFs here, or</p>
            <button onClick={() => inputRef.current?.click()} className="mt-3 rounded-xl bg-[#174a7e] px-5 py-2.5 text-sm font-semibold text-white">Choose files</button>
            <input ref={inputRef} type="file" accept="application/pdf,.pdf" multiple className="sr-only" onChange={(e) => handleFiles(e.target.files)} aria-label="Choose PDF files to upload" />
            <p className="mt-4 text-[11px] text-[#87928a]">PDF only · up to 10 MB each · up to {MAX_UPLOADS} files · only upload materials you have permission to use</p>
          </div>

          <div>
            <h2 className="font-serif text-2xl font-semibold text-[#304039]">Your resources</h2>
            <ul className="mt-4 space-y-3" aria-live="polite">
              {uploads.map((u) => (
                <li key={u.id} className={`rounded-2xl border bg-white p-4 ${u.status === 'error' ? 'border-[#f0d2bd]' : 'border-[#e5eae5]'}`}>
                  <div className="flex items-start gap-3">
                    <span className={`grid h-10 w-10 shrink-0 place-items-center rounded-xl ${u.status === 'error' ? 'bg-[#fff0e1] text-[#c6814f]' : 'bg-[#eef2f6] text-[#557086]'}`}>{u.status === 'error' ? <TriangleAlert size={18} /> : <FileText size={18} />}</span>
                    <div className="min-w-0 flex-1">
                      <p className="truncate text-sm font-semibold text-[#34433b]" title={u.name}>{u.name}</p>
                      <p className="mt-0.5 text-[11px] text-[#87928a]">{formatSize(u.size)}</p>
                      {u.status === 'validating' && <p className="mt-2 flex items-center gap-1.5 text-[11px] text-[#557086]"><LoaderCircle size={12} className="animate-spin" /> Checking file…</p>}
                      {u.status === 'uploading' && <div className="mt-2"><ProgressBar value={u.progress} barClassName="bg-[#247eb7]" trackClassName="bg-[#e3edf4]" label={`Uploading ${u.name}`} /><p className="mt-1 text-[11px] text-[#557086]">Simulated transfer {u.progress}%</p></div>}
                      {u.status === 'received' && (
                        <div className="mt-2 flex flex-wrap gap-2 text-[11px]">
                          <span className="flex items-center gap-1 rounded-full bg-[#e8f5ee] px-2 py-0.5 font-semibold text-[#2e7655]"><CircleCheck size={12} /> Validated</span>
                          <span className="rounded-full bg-[#f7f2e9] px-2 py-0.5 font-semibold text-[#94672f]">Processing: pending backend integration</span>
                        </div>
                      )}
                      {u.status === 'error' && <p className="mt-2 text-[11px] font-medium text-[#9b663c]">{u.error}</p>}
                    </div>
                    <button onClick={() => { removeUpload(u.id); onNotify(`${u.name} removed`) }} className="text-[#a0aaa3] hover:text-[#9b663c]" aria-label={`Remove ${u.name}`}><Trash2 size={16} /></button>
                  </div>
                </li>
              ))}
              {!uploads.length && <li className="rounded-2xl border border-dashed border-[#dfe5e0] p-5 text-xs text-[#87928a]">No resources yet. Add a PDF to get started.</li>}
            </ul>
          </div>
        </div>

        <aside className="h-fit space-y-5">
          <div className="rounded-2xl border border-[#e5eae5] bg-white p-5">
            <h2 className="text-sm font-semibold text-[#34433b]">What happens next</h2>
            <p className="mt-1 text-[11px] leading-5 text-[#87928a]">In this prototype, files are checked in your browser and kept only for this session. They aren&apos;t sent to a server or indexed yet.</p>
            <ol className="mt-4 space-y-2.5">
              {PIPELINE.map((step, i) => (
                <li key={step} className="flex items-center gap-3 text-xs text-[#78877e]">
                  <span className="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#f1f5f9] text-[10px] font-bold text-[#94a3b8]">{i + 1}</span>
                  <span className="flex-1">{step}</span>
                  <span className="text-[10px] font-semibold uppercase tracking-wider text-[#b0a07f]">Pending</span>
                </li>
              ))}
            </ol>
          </div>
          <div className="rounded-2xl bg-[#f7f9fb] p-5">
            <p className="flex items-center gap-2 text-sm font-semibold text-[#64748b]"><Lock size={15} /> Ask about a resource</p>
            <p className="mt-1 text-[11px] leading-5 text-[#87928a]">Questions and practice from your own files will open once the processing pipeline is connected.</p>
            <label className="mt-3 block">
              <span className="sr-only">Choose a resource</span>
              <select disabled className="w-full rounded-lg border border-[#e1e9ef] bg-white px-3 py-2 text-xs text-[#a0aaa3]">
                <option>{received.length ? `${received.length} resource${received.length > 1 ? 's' : ''} waiting for indexing` : 'No indexed resources'}</option>
              </select>
            </label>
          </div>
        </aside>
      </div>
    </section>
  )
}


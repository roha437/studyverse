export type Topic = {
  id: string
  name: string
  short: string
  subject: 'Mathematics' | 'Science'
  level: string
  prerequisites: string[]
}

export type Question = {
  id: string
  topicId: string
  concept: string
  prompt: string
  options: string[]
  answer: number
  explain: string
  traps: Record<number, string>
}

export type Confidence = 'Low' | 'Medium' | 'High'

export type QuizResponse = {
  questionId: string
  topicId: string
  choice: number
  correct: boolean
  misconception?: string
  reasoningNote?: string
  confidence?: Confidence
}

export type QuizRecord = {
  id: string
  takenAt: string
  title: string
  responses: QuizResponse[]
}

export type Activity = {
  id: string
  at: string
  minutes: number
  goalMinutes: number
  label: string
  kind: 'task' | 'quiz' | 'session'
}

export type PreferredTime = 'Morning' | 'Afternoon' | 'Evening'

export type PlannerSettings = {
  dailyMinutes: number
  studyDays: number[]
  preferredTime: PreferredTime
  weakSubjects: string[]
  goalSubjects: string[]
  goalNote: string
  timeZone: string
}

export type MasteryStatus = 'weak' | 'uncertain' | 'strength' | 'unassessed'
export type EvidenceLevel = 'None' | 'Preliminary' | 'Moderate' | 'Stronger'
export type Trend = 'improving' | 'declining' | 'steady' | 'new'

export type TopicStat = {
  topic: Topic
  attempts: number
  correct: number
  accuracy: number
  estimate: number
  status: MasteryStatus
  evidence: EvidenceLevel
  misconceptions: { label: string; count: number }[]
  notes: string[]
  history: { recordId: string; takenAt: string; correct: number; total: number }[]
  trend: Trend
  lastSeen?: string
  missingPrereqs: Topic[]
}

export type RecommendationAction = 'Strengthen foundation' | 'Targeted practice' | 'Gather more evidence' | 'Refresh'

export type Recommendation = {
  topic: Topic
  score: number
  action: RecommendationAction
  reason: string
  unlocks: Topic[]
  blockedBy: Topic[]
}

export type MasteryChange = {
  topicId: string
  name: string
  before: number
  after: number
  beforeStatus: MasteryStatus
  afterStatus: MasteryStatus
  evidence: EvidenceLevel
  attempts: number
}

export type ChangeSummary = {
  recordId: string
  title: string
  correct: number
  total: number
  message: string
  topChanged: boolean
  masteryChanges: MasteryChange[]
  newWeaknesses: string[]
  prerequisiteNotes: string[]
  added: string[]
  removed: string[]
  nextTopics: string[]
}

export type TaskKind = 'learn' | 'practice' | 'review' | 'reassess'

export type PlanTask = {
  id: string
  date: string
  kind: TaskKind
  title: string
  topicId: string
  minutes: number
  reason: string
  movedFrom?: string
}

export type PlanDay = {
  date: string
  available: boolean
  focus?: Topic
  tasks: PlanTask[]
}

export type UploadStatus = 'validating' | 'uploading' | 'received' | 'error'

export type UploadItem = {
  id: string
  name: string
  size: number
  status: UploadStatus
  progress: number
  error?: string
  addedAt: string
}


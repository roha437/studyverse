'use client'

import { useState } from 'react'
import { CalendarDays, ChevronDown, CircleCheck, Circle, Info, Play } from 'lucide-react'
import { formatDateKey, formatMinutes, TIME_ZONES, weekdayIndex, WEEKDAYS } from '@/lib/studyverse/dates'
import { MAX_PLANNED_MINUTES } from '@/lib/studyverse/plan'
import type { PlanDay, PlanTask, PreferredTime } from '@/lib/studyverse/types'
import { useStudyVerse } from './store'
import { PageIntro, ProgressBar, type Navigate } from './ui'

const PRESETS = [20, 30, 45, 60]
const SUBJECTS = ['Mathematics', 'Science']
const TIMES: PreferredTime[] = ['Morning', 'Afternoon', 'Evening']
const DAY_ORDER = [1, 2, 3, 4, 5, 6, 0]
const kindLabel = { learn: 'Revise', practice: 'Practise', review: 'Review', reassess: 'Reassess' } as const

function chip(active: boolean) {
  return `rounded-xl border px-3 py-2 text-xs font-semibold transition ${active ? 'border-[#63ad86] bg-[#eef8f1] text-[#2e7655]' : 'border-[#e1e9ef] bg-white text-[#718096] hover:border-[#c3d6cb]'}`
}

function TaskRow({ task, plan, today, onNavigate }: { task: PlanTask; plan: PlanDay[]; today: string; onNavigate: Navigate }) {
  const { isTaskDone, toggleTask, rescheduleTask } = useStudyVerse()
  const [open, setOpen] = useState(false)
  const done = isTaskDone(task.id)
  const isToday = task.date === today
  const targets = plan.filter((d) => d.date !== task.date && d.date > today)
  return (
    <li className="rounded-2xl border border-[#e5eae5] bg-white p-4">
      <div className="flex items-start gap-3">
        <button onClick={() => toggleTask(task)} disabled={!isToday} aria-pressed={done} aria-label={done ? `Mark ${task.title} as not done` : `Mark ${task.title} as complete`} className="mt-0.5 disabled:cursor-not-allowed disabled:opacity-40">
          {done ? <CircleCheck size={22} className="text-[#4e9a72]" /> : <Circle size={22} className="text-[#c3ccc6]" />}
        </button>
        <div className="min-w-0 flex-1">
          <div className="flex flex-wrap items-center gap-2">
            <span className="rounded-md bg-[#f4f6f3] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-[#78877e]">{kindLabel[task.kind]}</span>
            <span className="text-[11px] text-[#a0aaa3]">{task.minutes} min</span>
            {task.movedFrom && <span className="text-[11px] text-[#a47b3e]">Moved from {formatDateKey(task.movedFrom, { weekday: 'short' })}</span>}
          </div>
          <p className={`mt-1.5 text-sm font-semibold ${done ? 'text-[#a0aaa3] line-through' : 'text-[#34433b]'}`}>{task.title}</p>
          <button onClick={() => setOpen(!open)} aria-expanded={open} className="mt-1 flex items-center gap-1 text-[11px] font-semibold text-[#4e9a72]">Why this task? <ChevronDown size={12} className={open ? 'rotate-180' : ''} /></button>
          {open && <p className="mt-2 rounded-lg bg-[#fafbf9] p-3 text-[11px] leading-5 text-[#6f7c74]">{task.reason}</p>}
        </div>
        <div className="flex shrink-0 flex-col items-end gap-2">
          {(task.kind === 'practice' || task.kind === 'reassess') && isToday && !done && (
            <button onClick={() => onNavigate('Practice', task.topicId)} className="flex items-center gap-1 rounded-lg bg-[#174a7e] px-3 py-1.5 text-[11px] font-semibold text-white"><Play size={11} /> Start</button>
          )}
          {!done && targets.length > 0 && (
            <label className="text-[11px] text-[#78877e]">
              <span className="sr-only">Reschedule {task.title}</span>
              <select value="" onChange={(e) => e.target.value && rescheduleTask(task.id, e.target.value)} className="rounded-lg border border-[#e1e9ef] bg-white px-2 py-1.5 text-[11px]">
                <option value="">Reschedule…</option>
                {targets.map((d) => <option key={d.date} value={d.date}>{formatDateKey(d.date, { weekday: 'short', day: 'numeric', month: 'short' })}{d.available ? '' : ' (rest day)'}</option>)}
              </select>
            </label>
          )}
        </div>
      </div>
    </li>
  )
}

export function StudyPlanner({ onNavigate }: { onNavigate: Navigate }) {
  const { settings, updateSettings, plan, today, recs, streak } = useStudyVerse()
  const [customOpen, setCustomOpen] = useState(!PRESETS.includes(settings.dailyMinutes))
  const todayPlan = plan[0]
  const planned = todayPlan.tasks.reduce((s, t) => s + t.minutes, 0)
  const toggleIn = (list: string[], v: string) => (list.includes(v) ? list.filter((x) => x !== v) : [...list, v])

  return (
    <section>
      <PageIntro eyebrow="Study Planner" title="A plan that fits your day" description="Built from your quiz evidence, prerequisite links, chosen subjects and available time. It updates whenever you finish a task or take a quiz." />

      <div className="mt-8 grid gap-6 lg:grid-cols-[340px_1fr]">
        <aside className="h-fit space-y-6 rounded-2xl border border-[#e5eae5] bg-white p-5 lg:sticky lg:top-24">
          <fieldset>
            <legend className="text-xs font-semibold text-[#46544c]">Daily study time</legend>
            <div className="mt-3 flex flex-wrap gap-2">
              {PRESETS.map((m) => <button key={m} onClick={() => { setCustomOpen(false); updateSettings({ dailyMinutes: m }) }} className={chip(!customOpen && settings.dailyMinutes === m)}>{m === 60 ? '1 hour' : `${m} min`}</button>)}
              <button onClick={() => setCustomOpen(true)} className={chip(customOpen)}>Custom</button>
            </div>
            {customOpen && (
              <label className="mt-3 flex items-center gap-2 text-xs text-[#78877e]">
                <input type="number" min={10} max={180} step={5} value={settings.dailyMinutes} onChange={(e) => updateSettings({ dailyMinutes: Math.min(180, Math.max(10, Number(e.target.value) || 10)) })} className="w-20 rounded-lg border border-[#e1e9ef] px-2 py-1.5 text-sm text-[#34433b]" />
                minutes per day
              </label>
            )}
            {settings.dailyMinutes > MAX_PLANNED_MINUTES && <p className="mt-2 text-[11px] leading-5 text-[#a47b3e]">We plan up to {MAX_PLANNED_MINUTES} focused minutes so the day doesn&apos;t feel overloaded. The rest is free time.</p>}
          </fieldset>

          <fieldset>
            <legend className="text-xs font-semibold text-[#46544c]">Study days</legend>
            <div className="mt-3 flex flex-wrap gap-1.5">
              {DAY_ORDER.map((d) => <button key={d} aria-pressed={settings.studyDays.includes(d)} onClick={() => updateSettings({ studyDays: settings.studyDays.includes(d) ? settings.studyDays.filter((x) => x !== d) : [...settings.studyDays, d] })} className={`${chip(settings.studyDays.includes(d))} w-11 px-0`}>{WEEKDAYS[d]}</button>)}
            </div>
          </fieldset>

          <fieldset>
            <legend className="text-xs font-semibold text-[#46544c]">Preferred time</legend>
            <div className="mt-3 flex flex-wrap gap-2">{TIMES.map((t) => <button key={t} aria-pressed={settings.preferredTime === t} onClick={() => updateSettings({ preferredTime: t })} className={chip(settings.preferredTime === t)}>{t}</button>)}</div>
          </fieldset>

          <fieldset>
            <legend className="text-xs font-semibold text-[#46544c]">Subjects that feel tricky</legend>
            <div className="mt-3 flex flex-wrap gap-2">{SUBJECTS.map((s) => <button key={s} aria-pressed={settings.weakSubjects.includes(s)} onClick={() => updateSettings({ weakSubjects: toggleIn(settings.weakSubjects, s) })} className={chip(settings.weakSubjects.includes(s))}>{s}</button>)}</div>
          </fieldset>

          <fieldset>
            <legend className="text-xs font-semibold text-[#46544c]">Goal subjects</legend>
            <div className="mt-3 flex flex-wrap gap-2">{SUBJECTS.map((s) => <button key={s} aria-pressed={settings.goalSubjects.includes(s)} onClick={() => updateSettings({ goalSubjects: toggleIn(settings.goalSubjects, s) })} className={chip(settings.goalSubjects.includes(s))}>{s}</button>)}</div>
            <label className="mt-3 block text-[11px] text-[#78877e]">
              My learning goal
              <input value={settings.goalNote} onChange={(e) => updateSettings({ goalNote: e.target.value.slice(0, 120) })} className="mt-1 w-full rounded-lg border border-[#e1e9ef] px-3 py-2 text-xs text-[#34433b]" />
            </label>
          </fieldset>

          <label className="block text-xs font-semibold text-[#46544c]">
            Time zone
            <select value={settings.timeZone} onChange={(e) => updateSettings({ timeZone: e.target.value })} className="mt-2 w-full rounded-lg border border-[#e1e9ef] bg-white px-3 py-2 text-xs font-normal text-[#34433b]">
              {TIME_ZONES.map((tz) => <option key={tz.value} value={tz.value}>{tz.label}</option>)}
            </select>
          </label>
        </aside>

        <div className="min-w-0 space-y-8">
          <div className="rounded-2xl bg-[#174a7e] p-5 text-white md:p-6">
            <div className="flex flex-wrap items-end justify-between gap-4">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[#a9d8f0]">Today · {formatDateKey(today, { weekday: 'long', day: 'numeric', month: 'long' })} · {settings.preferredTime}</p>
                <h2 className="mt-2 font-serif text-3xl font-semibold">{todayPlan.focus ? `Focus: ${todayPlan.focus.short}` : 'No priorities right now'}</h2>
                <p className="mt-1 text-xs text-[#c6dcef]">{formatMinutes(planned)} planned · {streak.todayMinutes} of {settings.dailyMinutes} min done{streak.todayMet ? ' · goal met' : ''}</p>
              </div>
              <div className="w-full max-w-[220px]"><ProgressBar value={(streak.todayMinutes / settings.dailyMinutes) * 100} barClassName="bg-[#7fd1a6]" trackClassName="bg-white/20" label="Today's goal progress" /></div>
            </div>
            {!todayPlan.available && <p className="mt-4 flex items-start gap-2 rounded-lg bg-white/10 p-3 text-[11px] leading-5 text-[#dbe9f5]"><Info size={14} className="mt-0.5 shrink-0" />Today isn&apos;t one of your study days. These tasks are optional.</p>}
          </div>

          <ul className="space-y-3">
            {todayPlan.tasks.map((t) => <TaskRow key={t.id} task={t} plan={plan} today={today} onNavigate={onNavigate} />)}
            {!todayPlan.tasks.length && <li className="rounded-2xl border border-[#e5eae5] bg-white p-5 text-sm text-[#78877e]">Nothing scheduled today.</li>}
          </ul>

          <div className="rounded-2xl bg-[#f0f6f1] p-5">
            <h3 className="text-sm font-semibold text-[#2e5e47]">Why tasks are in this order</h3>
            <ol className="mt-3 space-y-2 text-xs leading-5 text-[#5d7a6a]">
              {recs.slice(0, 3).map((r, i) => <li key={r.topic.id}><span className="font-semibold text-[#2e5e47]">{i + 1}. {r.topic.short}</span> ({r.action.toLowerCase()}): {r.reason}</li>)}
            </ol>
            <p className="mt-3 text-[11px] text-[#7d998a]">Foundations come before the topics that depend on them when your answers point to a gap. Time splits are adjusted to your daily goal and are not fixed rules.</p>
          </div>

          <div>
            <h3 className="flex items-center gap-2 font-serif text-2xl font-semibold text-[#304039]"><CalendarDays size={20} /> This week</h3>
            <div className="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
              {plan.slice(1).map((day) => {
                const minutes = day.tasks.reduce((s, t) => s + t.minutes, 0)
                const heavy = minutes > settings.dailyMinutes
                return (
                  <div key={day.date} className={`rounded-2xl border p-4 ${day.tasks.length ? 'border-[#e5eae5] bg-white' : 'border-dashed border-[#dfe5e0] bg-transparent'}`}>
                    <p className="text-[11px] font-semibold text-[#a0aaa3]">{WEEKDAYS[weekdayIndex(day.date)]} · {formatDateKey(day.date)}</p>
                    {day.tasks.length ? (
                      <>
                        <p className="mt-2 text-sm font-semibold text-[#34433b]">{day.focus?.short ?? 'Moved tasks'}</p>
                        <ul className="mt-2 space-y-1">{day.tasks.map((t) => <li key={t.id} className="text-[11px] leading-5 text-[#78877e]">{t.minutes}m · {kindLabel[t.kind]}{t.movedFrom ? ' (moved)' : ''}</li>)}</ul>
                        <p className={`mt-2 text-[11px] font-semibold ${heavy ? 'text-[#ae7444]' : 'text-[#4e9a72]'}`}>{formatMinutes(minutes)}{heavy ? ' · more than your goal' : ''}</p>
                      </>
                    ) : <p className="mt-2 text-xs text-[#a0aaa3]">Rest day</p>}
                  </div>
                )
              })}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}


import { addDays, weekdayIndex } from './dates'
import { pct, type StatsMap } from './engine'
import type { PlanDay, PlannerSettings, PlanTask, Recommendation, TaskKind, TopicStat } from './types'

export const MAX_PLANNED_MINUTES = 90
const roundTo5 = (n: number) => Math.max(5, Math.round(n / 5) * 5)

export function allocate(minutes: number): { kind: TaskKind; minutes: number }[] {
  const total = Math.min(Math.max(minutes, 10), MAX_PLANNED_MINUTES)
  if (total < 25) {
    const reassess = 5
    const practice = total >= 15 ? 5 : 0
    const learn = total - reassess - practice
    return [{ kind: 'learn', minutes: learn }, ...(practice ? [{ kind: 'practice' as const, minutes: practice }] : []), { kind: 'reassess', minutes: reassess }]
  }
  const review = total <= 45 ? 5 : 10
  const reassess = total <= 45 ? 5 : 10
  const rest = total - review - reassess
  const learn = roundTo5(rest / 2)
  return [
    { kind: 'learn', minutes: learn },
    { kind: 'practice', minutes: rest - learn },
    { kind: 'review', minutes: review },
    { kind: 'reassess', minutes: reassess },
  ]
}

function tasksFor(date: string, rec: Recommendation, stats: StatsMap, minutes: number): PlanTask[] {
  const focus = rec.topic
  const stat = stats.get(focus.id) as TopicStat
  const prereq = rec.blockedBy[0] ?? stat.missingPrereqs.find((p) => stats.get(p.id)?.status !== 'strength' && (stats.get(p.id)?.estimate ?? 1) < 0.6)
  const topMistake = stat.misconceptions[0]
  return allocate(minutes).map(({ kind, minutes: m }) => {
    const topicId = kind === 'learn' && prereq ? prereq.id : focus.id
    const base = { id: `${date}:${kind}:${topicId}`, date, kind, topicId, minutes: m }
    if (kind === 'learn') {
      return prereq
        ? { ...base, title: `Revise prerequisite: ${prereq.short}`, reason: `${focus.short} builds on ${prereq.short}. Strengthening it first makes the practice that follows more useful.` }
        : { ...base, title: `Revise concept: ${focus.short}`, reason: rec.reason }
    }
    if (kind === 'practice') {
      return { ...base, title: `Targeted questions: ${focus.short}`, reason: stat.attempts ? `Accuracy so far is ${pct(stat.accuracy)} across ${stat.attempts} answers (${stat.evidence.toLowerCase()} evidence).` : 'No answers yet. Practice gives the first real evidence.' }
    }
    if (kind === 'review') {
      return { ...base, title: `Review mistakes: ${focus.short}`, reason: topMistake ? `Revisit "${topMistake.label}". It came up ${topMistake.count} time${topMistake.count > 1 ? 's' : ''}.` : 'Look back at explanations for any questions you missed.' }
    }
    return { ...base, title: `Short reassessment: ${focus.short}`, reason: `A 4-question check updates your mastery estimate for ${focus.short} and your next recommendation.` }
  })
}

export function buildPlan({ today, settings, recs, stats, rescheduled }: { today: string; settings: PlannerSettings; recs: Recommendation[]; stats: StatsMap; rescheduled: Record<string, string> }): PlanDay[] {
  const focusRecs = recs.slice(0, 3)
  const days: PlanDay[] = []
  let rotation = 0
  for (let i = 0; i < 7; i++) {
    const date = addDays(today, i)
    const available = settings.studyDays.includes(weekdayIndex(date))
    let tasks: PlanTask[] = []
    let focus
    if ((available || i === 0) && focusRecs.length) {
      const rec = focusRecs[rotation % focusRecs.length]
      if (available) rotation++
      focus = rec.topic
      tasks = tasksFor(date, rec, stats, settings.dailyMinutes)
    }
    days.push({ date, available, focus, tasks })
  }
  const moved: PlanTask[] = []
  for (const day of days) {
    day.tasks = day.tasks.filter((task) => {
      const target = rescheduled[task.id]
      if (!target || target === day.date) return true
      moved.push({ ...task, date: target, movedFrom: day.date })
      return false
    })
  }
  for (const task of moved) days.find((d) => d.date === task.date)?.tasks.push(task)
  return days
}


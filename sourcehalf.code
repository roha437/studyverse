'use client'

import { ArrowRight, CircleCheck, Info, ListChecks, TrendingDown, TrendingUp, Minus } from 'lucide-react'
import { topicById } from '@/lib/studyverse/content'
import { dateKeyInZone, formatDateKey } from '@/lib/studyverse/dates'
import { dependentsOf, pct } from '@/lib/studyverse/engine'
import type { Recommendation, TopicStat } from '@/lib/studyverse/types'
import { useStudyVerse } from './store'
import { DemoBadge, EvidenceBadge, PageIntro, StatusPill, type Navigate } from './ui'

function TrendIcon({ trend }: { trend: TopicStat['trend'] }) {
  if (trend === 'improving') return <span className="flex items-center gap-1 text-[11px] text-[#2e7655]"><TrendingUp size={13} /> Improving</span>
  if (trend === 'declining') return <span className="flex items-center gap-1 text-[11px] text-[#ae7444]"><TrendingDown size={13} /> Dipped recently</span>
  if (trend === 'steady') return <span className="flex items-center gap-1 text-[11px] text-[#718096]"><Minus size={13} /> Steady</span>
  return <span className="text-[11px] text-[#718096]">One quiz so far</span>
}

function HistoryDots({ stat }: { stat: TopicStat }) {
  return (
    <div className="flex flex-wrap gap-1" aria-label={`Quiz history for ${stat.topic.short}`}>
      {stat.history.map((h) => (
        <span key={h.recordId} title={`${h.correct}/${h.total}`} className={`rounded-md px-1.5 py-0.5 text-[10px] font-semibold ${h.correct === h.total ? 'bg-[#e8f5ee] text-[#2e7655]' : h.correct === 0 ? 'bg-[#fff0e1] text-[#9b663c]' : 'bg-[#eaf5fb] text-[#1f6c9e]'}`}>{h.correct}/{h.total}</span>
      ))}
    </div>
  )
}

function WeaknessCard({ stat, rec, onNavigate }: { stat: TopicStat; rec?: Recommendation; onNavigate: Navigate }) {
  const wrong = stat.attempts - stat.correct
  const prereq = stat.missingPrereqs[0]
  const nextStep = prereq
    ? `Revise ${prereq.short} first (${topicById(prereq.id).level}), then complete targeted practice on ${stat.topic.short}.`
    : `Complete a short targeted practice set on ${stat.topic.short}, then review the explanations for any missed questions.`
  return (
    <article className="rounded-2xl border border-[#efe2d3] bg-white p-5 md:p-6">
      <div className="flex flex-wrap items-center gap-2">
        <StatusPill status={stat.status} />
        <EvidenceBadge level={stat.evidence} />
        {rec && <span className="rounded-full bg-[#f4f6f3] px-2.5 py-1 text-[10px] font-semibold text-[#5f6d65]">Priority: {rec.action}</span>}
      </div>
      <h3 className="mt-3 font-serif text-2xl font-semibold text-[#34433b]">{stat.topic.name}</h3>
      <p className="mt-1 text-xs text-[#87928a]">{stat.topic.subject} · {stat.topic.level}</p>

      <div className="mt-5 rounded-xl bg-[#fffaf4] p-4">
        <p className="text-sm font-semibold text-[#755b3d]">Why is {stat.topic.short} recommended for revision?</p>
        <p className="mt-1.5 text-xs leading-5 text-[#7d6448]">
          You answered {wrong} of {stat.attempts} related question{stat.attempts === 1 ? '' : 's'} incorrectly
          {stat.notes.length ? `, and ${stat.notes[stat.notes.length - 1].charAt(0).toLowerCase()}${stat.notes[stat.notes.length - 1].slice(1)}` : ''}.
          {prereq ? ` Review ${prereq.short} and complete a short practice quiz.` : ' A short targeted practice quiz is the best next step.'}
        </p>
      </div>

      <dl className="mt-5 grid gap-4 text-xs sm:grid-cols-2">
        <div>
          <dt className="font-semibold text-[#46544c]">Evidence</dt>
          <dd className="mt-1 leading-5 text-[#78877e]">{stat.correct}/{stat.attempts} correct across {stat.history.length} quiz{stat.history.length === 1 ? '' : 'zes'} · estimate {pct(stat.estimate)}{stat.lastSeen ? ` · last seen ${formatDateKey(stat.lastSeen.slice(0, 10))}` : ''}</dd>
          <dd className="mt-2"><HistoryDots stat={stat} /></dd>
        </div>
        <div>
          <dt className="font-semibold text-[#46544c]">Errors and concepts involved</dt>
          <dd className="mt-1">
            {stat.misconceptions.length ? (
              <ul className="space-y-1">{stat.misconceptions.slice(0, 3).map((m) => <li key={m.label} className="leading-5 text-[#78877e]">{m.label} <span className="text-[#a0aaa3]">×{m.count}</span></li>)}</ul>
            ) : <span className="text-[#78877e]">No repeated error pattern yet.</span>}
          </dd>
        </div>
        <div>
          <dt className="font-semibold text-[#46544c]">Prerequisite that may be missing</dt>
          <dd className="mt-1 leading-5 text-[#78877e]">{stat.missingPrereqs.length ? stat.missingPrereqs.map((p) => p.short).join(', ') : 'Prerequisites look secure.'}</dd>
        </div>
        <div>
          <dt className="font-semibold text-[#46544c]">What to do next</dt>
          <dd className="mt-1 leading-5 text-[#78877e]">{nextStep}</dd>
        </div>
        <div className="sm:col-span-2">
          <dt className="font-semibold text-[#46544c]">How progress will be reassessed</dt>
          <dd className="mt-1 leading-5 text-[#78877e]">A 4-question check on {stat.topic.short}. The estimate updates right away, and this card moves to &ldquo;uncertain&rdquo; or &ldquo;strength&rdquo; once the evidence supports it.</dd>
        </div>
      </dl>

      {stat.evidence === 'Preliminary' && <p className="mt-4 flex items-start gap-2 rounded-lg bg-[#f7f2e9] p-3 text-[11px] leading-5 text-[#8a6534]"><Info size={14} className="mt-0.5 shrink-0" />Preliminary evidence. Based on fewer than 4 answers, so this may change quickly.</p>}

      <div className="mt-5 flex flex-wrap gap-2">
        <button onClick={() => onNavigate('Practice', stat.topic.id)} className="rounded-xl bg-[#174a7e] px-4 py-2.5 text-xs font-semibold text-white">Start targeted practice</button>
        {prereq && <button onClick={() => onNavigate('Practice', prereq.id)} className="rounded-xl border border-[#e2e8e2] px-4 py-2.5 text-xs font-semibold text-[#65756b]">Check {prereq.short}</button>}
      </div>
    </article>
  )
}

export function LearningGaps({ onNavigate }: { onNavigate: Navigate }) {
  const { stats, recs, records, settings } = useStudyVerse()
  const all = [...stats.values()]
  const recFor = (id: string) => recs.find((r) => r.topic.id === id)
  const weak = all.filter((s) => s.status === 'weak').sort((a, b) => (recFor(b.topic.id)?.score ?? 0) - (recFor(a.topic.id)?.score ?? 0))
  const uncertain = all.filter((s) => s.status === 'uncertain' || s.status === 'unassessed')
  const strengths = all.filter((s) => s.status === 'strength')
  const prereqGaps = all.flatMap((s) => s.status === 'weak' || s.status === 'uncertain' ? s.missingPrereqs.map((p) => ({ prereq: stats.get(p.id) as TopicStat, dependent: s })) : [])
  const history = [...records].sort((a, b) => b.takenAt.localeCompare(a.takenAt))

  return (
    <section>
      <PageIntro eyebrow="My Learning Gaps" title="Your learning gaps, explained" description="Every finding below comes from your recorded quiz answers. We show the evidence, how strong it is, and how each finding will be re-checked. One wrong answer never defines you." badge={<DemoBadge>Demo records</DemoBadge>} />

      <div className="mt-8 grid gap-3 sm:grid-cols-4">
        {[
          { label: 'Needs attention', value: weak.length, className: 'bg-[#fff0e1] text-[#9b663c]' },
          { label: 'Uncertain', value: uncertain.length, className: 'bg-[#eaf5fb] text-[#1f6c9e]' },
          { label: 'Strengths', value: strengths.length, className: 'bg-[#e8f5ee] text-[#2e7655]' },
          { label: 'Prerequisite gaps', value: prereqGaps.length, className: 'bg-[#eee9f9] text-[#62548e]' },
        ].map((c) => (
          <div key={c.label} className={`rounded-2xl p-4 ${c.className}`}><p className="text-xs font-semibold">{c.label}</p><p className="mt-2 text-3xl font-semibold">{c.value}</p></div>
        ))}
      </div>

      <h2 className="mt-12 font-serif text-2xl font-semibold text-[#304039]">Topics that need attention</h2>
      <div className="mt-5 grid gap-5 xl:grid-cols-2">
        {weak.length ? weak.map((s) => <WeaknessCard key={s.topic.id} stat={s} rec={recFor(s.topic.id)} onNavigate={onNavigate} />) : <p className="rounded-2xl border border-[#e5eae5] bg-white p-6 text-sm text-[#78877e]">Nothing is flagged right now. Keep practising to build stronger evidence.</p>}
      </div>

      <div className="mt-12 grid gap-5 lg:grid-cols-2">
        <div>
          <h2 className="font-serif text-2xl font-semibold text-[#304039]">Uncertain mastery</h2>
          <p className="mt-1 text-xs text-[#87928a]">Mixed or limited evidence. A quick check will tell us more.</p>
          <ul className="mt-5 space-y-3">
            {uncertain.map((s) => (
              <li key={s.topic.id} className="flex flex-wrap items-center gap-3 rounded-2xl border border-[#e5eae5] bg-white p-4">
                <div className="min-w-0 flex-1">
                  <p className="text-sm font-semibold text-[#34433b]">{s.topic.short}</p>
                  <p className="mt-1 text-[11px] text-[#87928a]">{s.attempts ? `${s.correct}/${s.attempts} correct · ${pct(s.estimate)} estimate` : 'No answers yet'}</p>
                  <div className="mt-2 flex flex-wrap items-center gap-2"><EvidenceBadge level={s.evidence} /><TrendIcon trend={s.trend} /></div>
                </div>
                <button onClick={() => onNavigate('Practice', s.topic.id)} className="rounded-xl border border-[#d6e6f1] px-3 py-2 text-xs font-semibold text-[#247eb7]">Quick check</button>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <h2 className="font-serif text-2xl font-semibold text-[#304039]">Demonstrated strengths</h2>
          <p className="mt-1 text-xs text-[#87928a]">At least 4 answers with a 70%+ estimate.</p>
          <ul className="mt-5 space-y-3">
            {strengths.length ? strengths.map((s) => (
              <li key={s.topic.id} className="flex items-center gap-3 rounded-2xl border border-[#d9ebe0] bg-[#f6fbf8] p-4">
                <CircleCheck size={20} className="shrink-0 text-[#4e9a72]" />
                <div className="min-w-0 flex-1">
                  <p className="text-sm font-semibold text-[#2e5e47]">{s.topic.short}</p>
                  <p className="mt-1 text-[11px] text-[#5d8a72]">{s.correct}/{s.attempts} correct · {pct(s.estimate)} · {dependentsOf(s.topic.id).length ? `supports ${dependentsOf(s.topic.id).map((d) => d.short).join(', ')}` : s.topic.subject}</p>
                </div>
                <EvidenceBadge level={s.evidence} />
              </li>
            )) : <li className="rounded-2xl border border-[#e5eae5] bg-white p-4 text-xs text-[#78877e]">Strengths appear once a topic has at least 4 answers.</li>}
          </ul>

          <h2 className="mt-10 font-serif text-2xl font-semibold text-[#304039]">Related prerequisite gaps</h2>
          <ul className="mt-5 space-y-3">
            {prereqGaps.map(({ prereq, dependent }) => (
              <li key={`${prereq.topic.id}-${dependent.topic.id}`} className="flex flex-wrap items-center gap-2 rounded-2xl border border-[#e5eae5] bg-white p-4 text-xs">
                <span className="rounded-lg bg-[#f7f2e9] px-2.5 py-1.5 font-semibold text-[#9a7143]">{prereq.topic.short}</span>
                <ArrowRight size={14} className="text-[#b9c3bb]" aria-label="supports" />
                <span className="rounded-lg bg-[#eaf5fb] px-2.5 py-1.5 font-semibold text-[#247eb7]">{dependent.topic.short}</span>
                <span className="ml-auto text-[11px] text-[#87928a]">{prereq.attempts ? `${prereq.correct}/${prereq.attempts} on the foundation` : 'foundation not yet assessed'}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div className="mt-12 grid gap-5 lg:grid-cols-[1.2fr_0.8fr]">
        <div className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6">
          <h2 className="font-serif text-2xl font-semibold text-[#304039]">Performance history</h2>
          <div className="mt-5 overflow-x-auto">
            <table className="w-full min-w-[480px] text-left text-xs">
              <thead className="text-[10px] uppercase tracking-[0.14em] text-[#a0aaa3]"><tr><th className="pb-3 font-semibold">Date</th><th className="pb-3 font-semibold">Quiz</th><th className="pb-3 font-semibold">Topics</th><th className="pb-3 text-right font-semibold">Score</th></tr></thead>
              <tbody className="divide-y divide-[#eef1ed]">
                {history.map((r) => {
                  const c = r.responses.filter((x) => x.correct).length
                  return (
                    <tr key={r.id}>
                      <td className="py-3 text-[#78877e]">{formatDateKey(dateKeyInZone(new Date(r.takenAt), settings.timeZone))}</td>
                      <td className="py-3 font-medium text-[#46544c]">{r.title}</td>
                      <td className="py-3 text-[#78877e]">{[...new Set(r.responses.map((x) => topicById(x.topicId).short))].join(', ')}</td>
                      <td className="py-3 text-right font-semibold text-[#34433b]">{c}/{r.responses.length}</td>
                    </tr>
                  )
                })}
              </tbody>
            </table>
          </div>
        </div>
        <div className="rounded-2xl bg-[#f0f6f1] p-5 md:p-6">
          <h2 className="flex items-center gap-2 font-serif text-2xl font-semibold text-[#2e5e47]"><ListChecks size={20} /> Suggested revision actions</h2>
          <ol className="mt-5 space-y-3">
            {recs.slice(0, 5).map((r, i) => (
              <li key={r.topic.id} className="flex gap-3 rounded-xl bg-white p-3">
                <span className="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#dff2e9] text-[11px] font-bold text-[#2e7655]">{i + 1}</span>
                <div className="min-w-0 flex-1">
                  <p className="text-xs font-semibold text-[#34433b]">{r.action}: {r.topic.short}</p>
                  <p className="mt-1 text-[11px] leading-5 text-[#78877e]">{r.reason}</p>
                  <button onClick={() => onNavigate('Practice', r.topic.id)} className="mt-2 text-[11px] font-semibold text-[#4e9a72]">Practise now</button>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )
}


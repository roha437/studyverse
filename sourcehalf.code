import type { Question, Topic } from './types'

export const topics: Topic[] = [
  { id: 'fractions', name: 'Fractions and equivalent fractions', short: 'Fractions', subject: 'Mathematics', level: 'Class 6', prerequisites: [] },
  { id: 'integers', name: 'Operations with integers', short: 'Integers', subject: 'Mathematics', level: 'Class 7', prerequisites: [] },
  { id: 'distributive', name: 'Distributive property', short: 'Distributive property', subject: 'Mathematics', level: 'Class 7', prerequisites: ['integers'] },
  { id: 'comparing-quantities', name: 'Comparing Quantities', short: 'Comparing Quantities', subject: 'Mathematics', level: 'Class 8', prerequisites: ['fractions'] },
  { id: 'algebraic-expressions', name: 'Algebraic Expressions', short: 'Algebraic Expressions', subject: 'Mathematics', level: 'Class 8', prerequisites: ['distributive', 'integers'] },
  { id: 'linear-equations', name: 'Linear Equations in One Variable', short: 'Linear Equations', subject: 'Mathematics', level: 'Class 8', prerequisites: ['integers', 'algebraic-expressions'] },
  { id: 'microorganisms', name: 'Microorganisms: Friend and Foe', short: 'Microorganisms', subject: 'Science', level: 'Class 8', prerequisites: [] },
  { id: 'coal-petroleum', name: 'Coal and Petroleum', short: 'Coal and Petroleum', subject: 'Science', level: 'Class 8', prerequisites: [] },
]

export const topicById = (id: string) => topics.find((t) => t.id === id) as Topic

function correctPosition(id: string) {
  return [...id].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % 4
}

function q(id: string, topicId: string, concept: string, prompt: string, correct: string, wrongs: [string, string][], explain: string): Question {
  const pos = correctPosition(id)
  const options = wrongs.map((w) => w[0])
  options.splice(pos, 0, correct)
  const traps: Record<number, string> = {}
  wrongs.forEach((w, i) => { traps[i < pos ? i : i + 1] = w[1] })
  return { id, topicId, concept, prompt, options, answer: pos, explain, traps }
}

export function wrongOptionIndex(question: Question, wrongIndex: number) {
  return wrongIndex < question.answer ? wrongIndex : wrongIndex + 1
}

export const questions: Question[] = [
  q('f1', 'fractions', 'Equivalent fractions', 'Which fraction is equivalent to 3/4?', '6/8', [['4/5', 'Added the same number to top and bottom'], ['9/16', 'Squared instead of scaling'], ['12/20', 'Scaled top and bottom by different factors']], 'Multiply numerator and denominator by the same number: 3×2 / 4×2 = 6/8.'),
  q('f2', 'fractions', 'Comparing fractions', 'Which is larger: 2/3 or 3/5?', '2/3', [['3/5', 'Compared denominators instead of values'], ['They are equal', 'Assumed similar-looking fractions are equal'], ['It cannot be decided', 'Unsure how to use a common denominator']], 'With denominator 15: 2/3 = 10/15 and 3/5 = 9/15, so 2/3 is larger.'),
  q('f3', 'fractions', 'Simplifying', 'Simplify 18/24 fully.', '3/4', [['9/12', 'Stopped simplifying too early'], ['2/3', 'Divided top and bottom by different numbers'], ['6/8', 'Stopped simplifying too early']], 'The highest common factor of 18 and 24 is 6, so 18/24 = 3/4.'),
  q('f4', 'fractions', 'Adding fractions', '1/2 + 1/3 = ?', '5/6', [['2/5', 'Added numerators and denominators separately'], ['2/6', 'Added numerators without a common denominator'], ['1/6', 'Multiplied instead of adding']], 'Use a common denominator: 3/6 + 2/6 = 5/6.'),

  q('i1', 'integers', 'Adding integers', '(−7) + 4 = ?', '−3', [['3', 'Sign error when adding a negative'], ['−11', 'Treated addition as subtraction of sizes'], ['11', 'Ignored the negative sign']], 'Start at −7 and move 4 steps right on the number line: −3.'),
  q('i2', 'integers', 'Multiplying integers', '(−3) × (−5) = ?', '15', [['−15', 'Sign rule for multiplying two negatives'], ['−8', 'Added instead of multiplied'], ['8', 'Added instead of multiplied']], 'A negative times a negative is positive: 3 × 5 = 15.'),
  q('i3', 'integers', 'Subtracting integers', '6 − (−2) = ?', '8', [['4', 'Subtracting a negative'], ['−8', 'Sign error when subtracting a negative'], ['−4', 'Subtracting a negative']], 'Subtracting −2 is the same as adding 2: 6 + 2 = 8.'),
  q('i4', 'integers', 'Dividing integers', '(−20) ÷ 4 = ?', '−5', [['5', 'Sign rule for division'], ['−16', 'Added instead of divided'], ['−80', 'Multiplied instead of divided']], 'A negative divided by a positive is negative: −5.'),

  q('d1', 'distributive', 'Expanding brackets', 'Expand 3(x + 4).', '3x + 12', [['3x + 4', 'Distributive property not applied to every term'], ['x + 12', 'Multiplied only the second term'], ['3x + 7', 'Added instead of multiplied']], 'Multiply each term inside the bracket by 3: 3x + 12.'),
  q('d2', 'distributive', 'Distributing a negative', 'Expand −2(a − 5).', '−2a + 10', [['−2a − 10', 'Sign error when distributing a negative'], ['2a − 10', 'Sign error when distributing a negative'], ['−2a − 5', 'Distributive property not applied to every term']], '−2 × a = −2a and −2 × −5 = +10.'),
  q('d3', 'distributive', 'Mental maths with distribution', '5 × 23 is the same as…', '5 × 20 + 5 × 3', [['5 × 20 + 3', 'Distributive property not applied to every term'], ['5 + 20 × 3', 'Mixed up the order of operations'], ['50 + 3', 'Distributive property not applied to every term']], 'Split 23 into 20 + 3 and multiply each part by 5.'),
  q('d4', 'distributive', 'Expanding brackets', 'Which is equal to 4(2y − 1)?', '8y − 4', [['8y − 1', 'Distributive property not applied to every term'], ['6y − 4', 'Added instead of multiplied'], ['8y + 4', 'Sign error when distributing a negative']], '4 × 2y = 8y and 4 × −1 = −4.'),

  q('a1', 'algebraic-expressions', 'Simplifying expressions', 'Simplify 2(x + 3) + x.', '3x + 6', [['3x + 3', 'Distributive property not applied to every term'], ['2x + 6', 'Dropped a like term'], ['3x + 5', 'Added instead of multiplied']], '2(x + 3) = 2x + 6; adding x gives 3x + 6.'),
  q('a2', 'algebraic-expressions', 'Like terms', 'Which pair are like terms?', '3xy and −5xy', [['3x and 3y', 'Matched coefficients instead of variables'], ['x² and x', 'Ignored powers when matching terms'], ['2a and 2ab', 'Matched coefficients instead of variables']], 'Like terms have exactly the same variables with the same powers.'),
  q('a3', 'algebraic-expressions', 'Subtracting expressions', 'Subtract (2a − b) from (5a + 3b).', '3a + 4b', [['3a + 2b', 'Sign error when subtracting a bracket'], ['7a + 2b', 'Added instead of subtracted'], ['3a − 4b', 'Sign error when subtracting a bracket']], '(5a + 3b) − (2a − b) = 5a − 2a + 3b + b = 3a + 4b.'),
  q('a4', 'algebraic-expressions', 'Substitution', 'What is 3m − 2 when m = −1?', '−5', [['1', 'Sign error when substituting a negative'], ['5', 'Sign error when substituting a negative'], ['−1', 'Substituted into only one term']], '3 × (−1) − 2 = −3 − 2 = −5.'),

  q('l1', 'linear-equations', 'One-step equations', 'If x + 7 = 12, what is x?', '5', [['3', 'Arithmetic slip'], ['19', 'Added instead of undoing the addition'], ['7', 'Copied a number from the question']], 'Subtract 7 from both sides: x = 5.'),
  q('l2', 'linear-equations', 'Two-step equations', 'Solve 3x − 4 = 11.', '5', [['7/3', 'Undid operations in the wrong order'], ['15', 'Stopped before dividing'], ['3', 'Arithmetic slip']], 'Add 4: 3x = 15. Divide by 3: x = 5.'),
  q('l3', 'linear-equations', 'Equations with brackets', 'Solve 2(x − 1) = 8.', '5', [['4.5', 'Distributive property not applied to every term'], ['3', 'Sign error when expanding'], ['9', 'Stopped before dividing']], 'Expand: 2x − 2 = 8, so 2x = 10 and x = 5.'),

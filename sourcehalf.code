'use client'

import { useEffect, useRef } from 'react'
import { Flame, Sparkles, Trophy, X } from 'lucide-react'
import { addDays, formatDateKey, TIME_ZONES, weekdayIndex } from '@/lib/studyverse/dates'
import { MILESTONES, type EarnedReward } from '@/lib/studyverse/streak'
import { useStudyVerse } from './store'
import { badgeText, PageIntro, ProgressBar, RewardBadge, type Navigate } from './ui'

const CONFETTI_COLORS = ['#58ad7f', '#247eb7', '#e09b69', '#9d8cca', '#e0b44a']

export function Celebration() {
  const { celebration, dismissCelebration } = useStudyVerse()
  const closeRef = useRef<HTMLButtonElement>(null)
  useEffect(() => {
    if (!celebration) return
    closeRef.current?.focus()
    const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') dismissCelebration() }
    window.addEventListener('keydown', onKey)
    return () => window.removeEventListener('keydown', onKey)
  }, [celebration, dismissCelebration])
  if (!celebration) return null
  return (
    <div className="fixed inset-0 z-[60] grid place-items-center bg-[#16263a]/40 p-5 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="celebration-title">
      <div className="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
        {Array.from({ length: 36 }).map((_, i) => (
          <span key={i} className="sv-confetti" style={{ left: `${(i * 37) % 100}%`, background: CONFETTI_COLORS[i % CONFETTI_COLORS.length], animationDelay: `${(i % 9) * 0.12}s`, animationDuration: `${2.4 + (i % 5) * 0.3}s` }} />
        ))}
      </div>
      <div className="relative w-full max-w-sm rounded-3xl bg-white p-7 text-center shadow-2xl">
        <button ref={closeRef} onClick={dismissCelebration} className="absolute right-4 top-4 text-[#a0aaa3]" aria-label="Close"><X size={18} /></button>
        <div className="flex justify-center"><RewardBadge milestone={celebration.milestone} earned size="lg" /></div>
        <p className="mt-5 text-xs font-bold uppercase tracking-[0.18em] text-[#4e9a72]">{celebration.milestone.days}-day milestone</p>
        <h2 id="celebration-title" className="mt-2 font-serif text-3xl font-semibold text-[#243b52]">{celebration.milestone.name}</h2>
        <p className="mt-3 text-sm leading-6 text-[#718096]">You met your study goal {celebration.milestone.days} days in a row. You&apos;ve unlocked the <strong>{celebration.milestone.cosmetic}</strong>.</p>
        <button onClick={dismissCelebration} className="mt-6 w-full rounded-xl bg-[#174a7e] px-4 py-3 text-sm font-semibold text-white">Keep learning</button>
      </div>
    </div>
  )
}

function RewardHistory({ rewards }: { rewards: EarnedReward[] }) {
  if (!rewards.length) return <p className="rounded-2xl border border-dashed border-[#dfe5e0] p-5 text-xs leading-5 text-[#87928a]">No rewards yet. Your first badge, Bronze Learner, unlocks after 10 days in a row of meeting your goal.</p>
  return (
    <ul className="space-y-3">
      {[...rewards].reverse().map((r) => (
        <li key={r.milestone.id} className="flex items-center gap-4 rounded-2xl border border-[#e5eae5] bg-white p-4">
          <RewardBadge milestone={r.milestone} earned />
          <div className="min-w-0 flex-1">
            <p className={`text-sm font-semibold ${badgeText(r.milestone)}`}>{r.milestone.name}</p>
            <p className="mt-0.5 text-[11px] text-[#87928a]">Earned {formatDateKey(r.earnedOn, { day: 'numeric', month: 'long', year: 'numeric' })} · {r.milestone.cosmetic}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}

export function Achievements({ onNavigate }: { onNavigate: Navigate }) {
  const { streak, today, settings } = useStudyVerse()
  const earned = new Set(streak.rewards.map((r) => r.milestone.id))
  const next = streak.next
  const prevMilestoneDays = [...MILESTONES].reverse().find((m) => m.days <= streak.current)?.days ?? 0
  const remainingToday = Math.max(0, streak.todayGoal - streak.todayMinutes)
  const missedYesterday = !streak.met(addDays(today, -1))

  const start = addDays(today, -34 - ((weekdayIndex(today) + 6) % 7))
  const calendarDays = Array.from({ length: 35 + ((weekdayIndex(today) + 6) % 7) + 1 }, (_, i) => addDays(start, i)).slice(-42)
  const tzLabel = TIME_ZONES.find((t) => t.value === settings.timeZone)?.label ?? settings.timeZone

  return (
    <section>
      <PageIntro eyebrow="Achievements" title="Streaks and rewards" description={`A day counts once you finish ${settings.dailyMinutes} minutes of planned tasks or quizzes. Just opening StudyVerse doesn't count. Days follow your time zone: ${tzLabel}.`} />

      <div className="mt-8 grid gap-4 md:grid-cols-3">
        <div className="rounded-2xl bg-[#fff0e1] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#ae7444]">Current streak</span><Flame size={18} className="text-[#d69868]" fill="currentColor" /></div>
          <p className="mt-4 text-4xl font-semibold text-[#9b663c]">{streak.current} <span className="text-base font-medium">day{streak.current === 1 ? '' : 's'}</span></p>
          <p className="mt-2 text-[11px] leading-5 text-[#ae7444]">{streak.todayMet ? 'Today is counted. Great work!' : streak.current > 0 ? `${remainingToday} more minutes today keeps it growing.` : 'One completed goal today starts a new streak.'}</p>
        </div>
        <div className="rounded-2xl bg-[#eee9f9] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#7769a1]">Longest streak</span><Trophy size={18} className="text-[#978ac2]" /></div>
          <p className="mt-4 text-4xl font-semibold text-[#62548e]">{streak.longest} <span className="text-base font-medium">days</span></p>
          <p className="mt-2 text-[11px] text-[#7769a1]">Your personal best so far.</p>
        </div>
        <div className="rounded-2xl bg-[#dff2e9] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#4c8d6b]">Today&apos;s goal</span><Sparkles size={18} className="text-[#69ae88]" /></div>
          <p className="mt-4 text-4xl font-semibold text-[#2e7655]">{streak.todayMinutes}<span className="text-base font-medium">/{streak.todayGoal} min</span></p>
          <div className="mt-3"><ProgressBar value={(streak.todayMinutes / streak.todayGoal) * 100} trackClassName="bg-[#c4e5d1]" label="Today's goal" /></div>
          {!streak.todayMet && <button onClick={() => onNavigate('Study Planner')} className="mt-3 text-[11px] font-semibold text-[#2e7655]">Open today&apos;s plan</button>}
        </div>
      </div>

      {missedYesterday && streak.longest > 0 && (
        <p className="mt-5 rounded-2xl border border-[#d9e8e0] bg-[#f6fbf8] p-4 text-xs leading-5 text-[#4c7a62]">Welcome back. Everything you&apos;ve learned is still here. A short session today is a great way to pick things up again.</p>
      )}

      <div className="mt-8 rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6">
        <div className="flex flex-wrap items-end justify-between gap-3">
          <div>
            <p className="text-xs font-semibold uppercase tracking-[0.16em] text-[#a0aaa3]">Milestones</p>
            <h2 className="mt-1 font-serif text-2xl font-semibold text-[#304039]">{next ? `${next.days - streak.current} day${next.days - streak.current === 1 ? '' : 's'} to ${next.name}` : 'All milestones reached'}</h2>
          </div>
          {next && <span className="text-xs text-[#87928a]">{streak.current}/{next.days} days</span>}
        </div>
        {next && <div className="mt-4"><ProgressBar value={((streak.current - prevMilestoneDays) / (next.days - prevMilestoneDays)) * 100} barClassName="bg-[#e0b44a]" label="Progress to next milestone" /></div>}
        <ul className="mt-6 grid gap-4 sm:grid-cols-3">
          {MILESTONES.map((m) => (
            <li key={m.id} className={`flex items-center gap-3 rounded-2xl p-4 ${earned.has(m.id) ? 'bg-[#fbf8ef]' : 'bg-[#f7f9fb]'}`}>
              <RewardBadge milestone={m} earned={earned.has(m.id)} />
              <div>
                <p className={`text-sm font-semibold ${earned.has(m.id) ? badgeText(m) : 'text-[#64748b]'}`}>{m.name}</p>
                <p className="text-[11px] text-[#87928a]">{m.days} days · {earned.has(m.id) ? 'Unlocked' : m.cosmetic}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div className="mt-8 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
        <div className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6">
          <h2 className="font-serif text-2xl font-semibold text-[#304039]">Study activity</h2>
          <div className="mt-5 grid grid-cols-7 gap-1.5 text-center text-[10px] font-semibold text-[#a0aaa3]">
            {['M', 'T', 'W', 'T', 'F', 'S', 'S'].map((d, i) => <span key={i}>{d}</span>)}
          </div>
          <div className="mt-2 grid grid-cols-7 gap-1.5">
            {calendarDays.map((d) => {
              const total = streak.totals.get(d)
              const future = d > today
              const met = streak.met(d)
              const cls = future ? 'bg-transparent text-[#d0d6d2]' : met ? 'bg-[#58ad7f] text-white' : total?.minutes ? 'bg-[#cfe9da] text-[#2e7655]' : 'bg-[#f1f4f2] text-[#a0aaa3]'
              return (
                <div key={d} title={`${formatDateKey(d, { weekday: 'short', day: 'numeric', month: 'short' })}: ${total?.minutes ?? 0} min${met ? ' · goal met' : ''}`} className={`grid aspect-square place-items-center rounded-lg text-[11px] font-semibold ${cls} ${d === today ? 'ring-2 ring-[#247eb7] ring-offset-1' : ''}`}>
                  {Number(d.slice(8))}
                </div>
              )
            })}
          </div>
          <div className="mt-4 flex flex-wrap gap-4 text-[11px] text-[#78877e]">
            <span className="flex items-center gap-1.5"><span className="h-3 w-3 rounded bg-[#58ad7f]" />Goal met</span>
            <span className="flex items-center gap-1.5"><span className="h-3 w-3 rounded bg-[#cfe9da]" />Some study</span>
            <span className="flex items-center gap-1.5"><span className="h-3 w-3 rounded bg-[#f1f4f2]" />No study</span>
            <span className="flex items-center gap-1.5"><span className="h-3 w-3 rounded ring-2 ring-[#247eb7]" />Today</span>
          </div>
        </div>
        <div>
          <h2 className="font-serif text-2xl font-semibold text-[#304039]">Reward history</h2>
          <div className="mt-5"><RewardHistory rewards={streak.rewards} /></div>
          <p className="mt-4 text-[11px] leading-5 text-[#a0aaa3]">Rewards are in-app cosmetics. Each one is awarded once, and completing the same task twice never counts twice.</p>
        </div>
      </div>
    </section>
  )
}


'use client'

import { ArrowRight, BrainCircuit, CircleCheck, Circle, Clock3, Flame, Lightbulb, MessageCircleQuestion, RefreshCw, Sparkles, Target } from 'lucide-react'
import { addDays, formatDateKey, formatMinutes, weekdayIndex, WEEKDAYS } from '@/lib/studyverse/dates'
import { pct } from '@/lib/studyverse/engine'
import { useStudyVerse } from './store'
import { EvidenceBadge, ProgressBar, statusBar, type Navigate } from './ui'

const actionTone = {
  'Strengthen foundation': 'bg-[#fff0e1] text-[#c6814f]',
  'Targeted practice': 'bg-[#eee9f9] text-[#8879b6]',
  'Gather more evidence': 'bg-[#eaf5fb] text-[#247eb7]',
  Refresh: 'bg-[#e5f2eb] text-[#5c9f7a]',
} as const

export function Overview({ onNavigate }: { onNavigate: Navigate }) {
  const { recs, stats, streak, plan, today, settings, lastChange, isTaskDone, toggleTask } = useStudyVerse()
  const assessed = [...stats.values()].filter((s) => s.attempts > 0)
  const avgMastery = assessed.reduce((sum, s) => sum + s.estimate, 0) / Math.max(1, assessed.length)
  const strengths = assessed.filter((s) => s.status === 'strength').length
  const last7 = Array.from({ length: 7 }, (_, i) => addDays(today, i - 6))
  const weekMinutes = last7.reduce((sum, d) => sum + (streak.totals.get(d)?.minutes ?? 0), 0)
  const weekGoal = settings.dailyMinutes * settings.studyDays.length
  const todayPlan = plan[0]
  const maxBar = Math.max(settings.dailyMinutes, ...last7.map((d) => streak.totals.get(d)?.minutes ?? 0))

  return (
    <>
      <section className="grid items-end gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <p className="mb-3 text-xs font-semibold uppercase tracking-[0.2em] text-[#61a981]">Good to see you, Aarav</p>
          <h1 className="font-serif text-[38px] font-semibold leading-[1.12] tracking-[-0.025em] text-[#26372f] md:text-[50px]">Let&apos;s make today<br className="hidden md:block" /> a <span className="text-[#247eb7]">great learning day.</span></h1>
          <p className="mt-5 max-w-[520px] text-sm leading-7 text-[#7d8981]">Recommendations below update after every quiz, using your real answers. Not page visits.</p>
        </div>
        <button onClick={() => onNavigate('Achievements')} className="flex items-center gap-3 rounded-2xl border border-[#e6ebe5] bg-white px-4 py-3 text-left hover:shadow-md">
          <span className="grid h-10 w-10 place-items-center rounded-full bg-[#fff0d8] text-[#cc8a3b]"><Flame size={19} fill="currentColor" /></span>
          <span>
            <span className="block text-xs font-semibold text-[#47564d]">{streak.current} day streak</span>
            <span className="mt-0.5 block text-[11px] text-[#99a39d]">{streak.todayMet ? 'Today’s goal complete' : `${Math.max(0, streak.todayGoal - streak.todayMinutes)} min to today’s goal`}</span>
          </span>
        </button>
      </section>

      {lastChange && (
        <section className="mt-8 flex flex-wrap items-start gap-3 rounded-2xl border border-[#cfe3f1] bg-[#eef6fc] p-5" aria-live="polite">
          <span className="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-white text-[#247eb7]"><RefreshCw size={17} /></span>
          <div className="min-w-0 flex-1">
            <p className="text-sm font-semibold text-[#174a7e]">Recommendations updated after &ldquo;{lastChange.title}&rdquo; ({lastChange.correct}/{lastChange.total})</p>
            <p className="mt-1 text-xs leading-5 text-[#4f6f8c]">{lastChange.message}</p>
          </div>
          <button onClick={() => onNavigate('Learning Gaps')} className="rounded-xl border border-[#cfe3f1] bg-white px-3 py-2 text-xs font-semibold text-[#247eb7]">See evidence</button>
        </section>
      )}

      <section className="mt-8 grid gap-4 md:grid-cols-3">
        <div className="rounded-2xl bg-[#dff2e9] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#4c8d6b]">Average mastery estimate</span><Target size={17} className="text-[#69ae88]" /></div>
          <div className="mt-5 flex items-end gap-2"><span className="text-3xl font-semibold text-[#2e7655]">{pct(avgMastery)}</span><span className="mb-1 text-[11px] text-[#4c8d6b]">across {assessed.length} topics</span></div>
          <div className="mt-4"><ProgressBar value={avgMastery * 100} trackClassName="bg-[#c4e5d1]" label="Average mastery" /></div>
        </div>
        <div className="rounded-2xl bg-[#eee9f9] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#7769a1]">Demonstrated strengths</span><BrainCircuit size={17} className="text-[#978ac2]" /></div>
          <div className="mt-5 flex items-end gap-2"><span className="text-3xl font-semibold text-[#62548e]">{strengths}</span><span className="mb-1 text-[11px] text-[#7769a1]">of {stats.size} topics, 4+ answers each</span></div>
          <div className="mt-4 flex gap-1.5">{[...stats.values()].map((s) => <span key={s.topic.id} className={`h-2 flex-1 rounded-full ${s.status === 'strength' ? 'bg-[#9d8cca]' : 'bg-[#d9d2eb]'}`} />)}</div>
        </div>
        <div className="rounded-2xl bg-[#fff0e1] p-5">
          <div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#ae7444]">Last 7 days</span><Clock3 size={17} className="text-[#d69868]" /></div>
          <div className="mt-5 flex items-end gap-2"><span className="text-3xl font-semibold text-[#9b663c]">{formatMinutes(weekMinutes)}</span><span className="mb-1 text-[11px] text-[#ae7444]">of {formatMinutes(weekGoal)} goal</span></div>
          <div className="mt-4"><ProgressBar value={(weekMinutes / Math.max(1, weekGoal)) * 100} barClassName="bg-[#e09b69]" trackClassName="bg-[#f4d9bf]" label="Weekly study time" /></div>
        </div>
      </section>

      <section className="mt-12">
        <div className="mb-5 flex items-end justify-between">
          <div>
            <p className="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-[#65a984]"><Sparkles size={14} /> Personalized from your quiz evidence</p>
            <h2 className="mt-2 font-serif text-2xl font-semibold text-[#2e3e35]">What should you study next?</h2>
          </div>
          <button onClick={() => onNavigate('Study Planner')} className="hidden items-center gap-2 text-xs font-semibold text-[#4e9a72] sm:flex">View full plan <ArrowRight size={15} /></button>
        </div>
        <div className="grid gap-4 lg:grid-cols-3">
          {recs.slice(0, 3).map((rec, i) => {
            const s = stats.get(rec.topic.id)
            return (
              <article key={rec.topic.id} className="group flex flex-col rounded-2xl border border-[#e5eae5] bg-white p-5 transition hover:-translate-y-0.5 hover:shadow-lg">
                <div className="flex items-start justify-between gap-2">
                  <span className={`rounded-lg px-2.5 py-1 text-[10px] font-semibold ${actionTone[rec.action]}`}>{i === 0 ? 'Top priority · ' : ''}{rec.action}</span>
                  {s && <EvidenceBadge level={s.evidence} />}
                </div>
                <p className="mt-5 text-[10px] font-bold uppercase tracking-[0.16em] text-[#a2aba5]">{rec.topic.subject} · {rec.topic.level}</p>
                <h3 className="mt-2 font-serif text-xl font-semibold leading-tight text-[#34433b]">{rec.topic.name}</h3>
                <div className="mt-4 flex flex-1 gap-2 rounded-xl bg-[#fafbf9] p-3"><Lightbulb size={15} className="mt-0.5 shrink-0 text-[#d79b4a]" /><p className="text-[11px] leading-5 text-[#6f7c74]">{rec.reason}</p></div>
                <button onClick={() => onNavigate('Practice', rec.topic.id)} className="mt-5 flex w-full items-center justify-between rounded-xl bg-[#f0f7f2] px-3 py-2.5 text-xs font-semibold text-[#418762] transition group-hover:bg-[#dff2e9]">Practise this topic<ArrowRight size={15} /></button>
              </article>
            )
          })}
        </div>
      </section>

      <section className="mt-12 grid gap-5 lg:grid-cols-[1.25fr_0.75fr]">
        <div className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6">
          <div className="flex items-start justify-between">
            <div>
              <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#a0aaa3]">Mastery by topic</p>
              <h2 className="mt-2 font-serif text-2xl font-semibold text-[#304039]">Where you stand</h2>
            </div>
            <button onClick={() => onNavigate('Learning Gaps')} className="text-xs font-semibold text-[#59a57a]">See evidence</button>
          </div>
          <ul className="mt-6 space-y-3.5">
            {[...stats.values()].sort((a, b) => a.estimate - b.estimate).map((s) => (
              <li key={s.topic.id} className="grid grid-cols-[minmax(0,9rem)_1fr_auto] items-center gap-3 text-xs sm:grid-cols-[minmax(0,12rem)_1fr_auto]">
                <span className="truncate font-medium text-[#46544c]">{s.topic.short}</span>
                <ProgressBar value={s.attempts ? s.estimate * 100 : 0} barClassName={statusBar(s.status)} label={`${s.topic.short} mastery`} />
                <span className="w-24 text-right text-[11px] text-[#89958d]">{s.attempts ? `${pct(s.estimate)} · ${s.attempts} ans` : 'Not assessed'}</span>
              </li>
            ))}
          </ul>
          <p className="mt-5 text-[11px] leading-5 text-[#a0aaa3]">Estimates are smoothed: (correct + 1) ÷ (answers + 2). With fewer than 4 answers, treat them as preliminary.</p>
        </div>

        <div className="flex flex-col gap-5">
          <div className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6">
            <div className="flex items-start justify-between">
              <div>
                <p className="text-xs font-semibold uppercase tracking-[0.18em] text-[#a0aaa3]">Today&apos;s plan</p>
                <h2 className="mt-2 font-serif text-xl font-semibold text-[#304039]">{todayPlan?.focus?.short ?? 'Rest day'}</h2>
              </div>
              <span className="text-[11px] text-[#89958d]">{streak.todayMinutes}/{streak.todayGoal} min</span>
            </div>
            <ul className="mt-4 space-y-2">
              {todayPlan?.tasks.map((task) => {
                const done = isTaskDone(task.id)
                return (
                  <li key={task.id}>
                    <button onClick={() => toggleTask(task)} className="flex w-full items-center gap-3 rounded-xl p-2 text-left text-xs hover:bg-[#f7faf7]" aria-pressed={done}>
                      {done ? <CircleCheck size={18} className="shrink-0 text-[#4e9a72]" /> : <Circle size={18} className="shrink-0 text-[#c3ccc6]" />}
                      <span className={`flex-1 ${done ? 'text-[#a0aaa3] line-through' : 'text-[#46544c]'}`}>{task.title}</span>
                      <span className="text-[#a0aaa3]">{task.minutes}m</span>
                    </button>
                  </li>
                )
              })}
            </ul>
            <div className="mt-5">
              <p className="mb-2 text-[10px] font-semibold uppercase tracking-[0.16em] text-[#a0aaa3]">Minutes, last 7 days</p>
              <div className="flex h-20 items-end gap-1.5" role="img" aria-label="Study minutes over the last 7 days">
                {last7.map((d) => {
                  const m = streak.totals.get(d)?.minutes ?? 0
                  return (
                    <div key={d} className="flex flex-1 flex-col items-center gap-1">
                      <div className={`w-full rounded-md ${streak.met(d) ? 'bg-[#64bd91]' : m ? 'bg-[#bfe0cc]' : 'bg-[#eef1ee]'}`} style={{ height: `${Math.max(6, (m / maxBar) * 64)}px` }} title={`${formatDateKey(d)}: ${m} min`} />
                      <span className={`text-[9px] ${d === today ? 'font-bold text-[#2e7655]' : 'text-[#a0aaa3]'}`}>{WEEKDAYS[weekdayIndex(d)].slice(0, 1)}</span>
                    </div>
                  )
                })}
              </div>
            </div>
          </div>

          <div className="rounded-2xl bg-[#174a7e] p-6 text-[#eef8f0]">
            <span className="grid h-10 w-10 place-items-center rounded-xl bg-white/15"><MessageCircleQuestion size={20} /></span>
            <h2 className="mt-5 font-serif text-xl font-semibold leading-tight">Stuck on something? Ask your tutor.</h2>
            <button onClick={() => onNavigate('Ask a Doubt')} className="mt-5 flex items-center gap-2 rounded-xl bg-white px-4 py-2.5 text-xs font-semibold text-[#174a7e]">Ask a doubt <ArrowRight size={14} /></button>
          </div>
        </div>
      </section>
    </>
  )
}


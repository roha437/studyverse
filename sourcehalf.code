import { topics } from './content'
import type { ChangeSummary, EvidenceLevel, MasteryStatus, PlannerSettings, QuizRecord, QuizResponse, Recommendation, Topic, TopicStat, Trend } from './types'

export type StatsMap = Map<string, TopicStat>

export const pct = (n: number) => `${Math.round(n * 100)}%`
const names = (list: Topic[]) => list.map((t) => t.short).join(' and ')

export function evidenceLevel(attempts: number): EvidenceLevel {
  if (attempts === 0) return 'None'
  if (attempts < 4) return 'Preliminary'
  if (attempts < 8) return 'Moderate'
  return 'Stronger'
}

// Fewer than 2 answers is never enough to call a topic weak or strong.
export function masteryStatus(attempts: number, estimate: number): MasteryStatus {
  if (attempts === 0) return 'unassessed'
  if (attempts < 2) return 'uncertain'
  if (estimate < 0.5) return 'weak'
  if (estimate >= 0.7 && attempts >= 4) return 'strength'
  return 'uncertain'
}

function trendOf(history: TopicStat['history']): Trend {
  if (history.length < 2) return 'new'
  const last = history[history.length - 1]
  const prior = history.slice(0, -1).reduce((acc, h) => ({ c: acc.c + h.correct, t: acc.t + h.total }), { c: 0, t: 0 })
  const diff = last.correct / last.total - prior.c / prior.t
  if (diff >= 0.2) return 'improving'
  if (diff <= -0.2) return 'declining'
  return 'steady'
}

export function computeStats(records: QuizRecord[]): StatsMap {
  const map: StatsMap = new Map()
  for (const topic of topics) {
    map.set(topic.id, { topic, attempts: 0, correct: 0, accuracy: 0, estimate: 0.5, status: 'unassessed', evidence: 'None', misconceptions: [], notes: [], history: [], trend: 'new', missingPrereqs: [] })
  }
  const misconceptionCounts = new Map<string, Map<string, number>>()
  const sorted = [...records].sort((a, b) => a.takenAt.localeCompare(b.takenAt))
  for (const record of sorted) {
    const byTopic = new Map<string, QuizResponse[]>()
    for (const r of record.responses) byTopic.set(r.topicId, [...(byTopic.get(r.topicId) ?? []), r])
    for (const [topicId, responses] of byTopic) {
      const stat = map.get(topicId)
      if (!stat) continue
      const correct = responses.filter((r) => r.correct).length
      stat.attempts += responses.length
      stat.correct += correct
      stat.history.push({ recordId: record.id, takenAt: record.takenAt, correct, total: responses.length })
      stat.lastSeen = record.takenAt
      for (const r of responses) {
        if (r.misconception) {
          const counts = misconceptionCounts.get(topicId) ?? new Map<string, number>()
          counts.set(r.misconception, (counts.get(r.misconception) ?? 0) + 1)
          misconceptionCounts.set(topicId, counts)
        }
        if (r.reasoningNote) stat.notes.push(r.reasoningNote)
      }
    }
  }
  for (const stat of map.values()) {
    stat.accuracy = stat.attempts ? stat.correct / stat.attempts : 0
    stat.estimate = (stat.correct + 1) / (stat.attempts + 2)
    stat.evidence = evidenceLevel(stat.attempts)
    stat.status = masteryStatus(stat.attempts, stat.estimate)
    stat.trend = trendOf(stat.history)
    stat.misconceptions = [...(misconceptionCounts.get(stat.topic.id) ?? new Map<string, number>()).entries()]
      .map(([label, count]) => ({ label, count }))
      .sort((a, b) => b.count - a.count)
  }
  for (const stat of map.values()) {
    stat.missingPrereqs = stat.topic.prerequisites.map((id) => map.get(id) as TopicStat).filter((p) => p.status !== 'strength').map((p) => p.topic)
  }
  return map
}

export function dependentsOf(topicId: string) {
  return topics.filter((t) => t.prerequisites.includes(topicId))
}

export function recommend(stats: StatsMap, settings: Pick<PlannerSettings, 'weakSubjects' | 'goalSubjects'>): Recommendation[] {
  const list: Recommendation[] = []
  for (const stat of stats.values()) {
    if (stat.status === 'strength') continue
    const unlocks = dependentsOf(stat.topic.id).filter((t) => stats.get(t.id)?.status === 'weak')
    if (stat.status === 'unassessed' && unlocks.length === 0) continue
    const blockedBy = stat.topic.prerequisites.map((id) => stats.get(id) as TopicStat).filter((p) => p.status === 'weak' || p.status === 'unassessed').map((p) => p.topic)

    let score = (1 - stat.estimate) * 100
    score += unlocks.length * 15
    if (settings.weakSubjects.includes(stat.topic.subject)) score += 10
    if (settings.goalSubjects.includes(stat.topic.subject)) score += 8
    if (stat.trend === 'declining') score += 10
    if (stat.attempts > 0 && stat.attempts < 3) score += 5
    if (blockedBy.length) score -= 15

    const wrong = stat.attempts - stat.correct
    const evidence = stat.evidence.toLowerCase()
    const topMistake = stat.misconceptions[0]?.label
    let action: Recommendation['action']
    let reason: string
    if (unlocks.length) {
      action = 'Strengthen foundation'
      reason = `${stat.topic.short} is a foundation for ${names(unlocks)}, and you answered ${stat.correct} of ${stat.attempts} related questions correctly (${evidence} evidence).`
    } else if (stat.status === 'weak') {
      action = 'Targeted practice'
      reason = `You answered ${wrong} of ${stat.attempts} questions incorrectly${topMistake ? `, most often: ${topMistake.toLowerCase()}` : ''}.${blockedBy.length ? ` Strengthening ${names(blockedBy)} first will help.` : ''}`
    } else if (stat.evidence === 'Preliminary' || stat.evidence === 'None') {
      action = 'Gather more evidence'
      reason = `Only ${stat.attempts} answer${stat.attempts === 1 ? '' : 's'} so far, so a short check will show where you really stand.`
    } else {
      action = 'Refresh'
      reason = `Accuracy is ${pct(stat.accuracy)}; ${stat.trend === 'declining' ? 'it dipped in your latest quiz, so a quick review will help' : 'a quick review will help it stick'}.`
    }
    list.push({ topic: stat.topic, score, action, reason, unlocks, blockedBy })
  }
  return list.sort((a, b) => b.score - a.score)
}

export function explainChange(prevStats: StatsMap, nextStats: StatsMap, prevRecs: Recommendation[], nextRecs: Recommendation[], record: QuizRecord): ChangeSummary {
  const topicIds = [...new Set(record.responses.map((r) => r.topicId))]
  const correct = record.responses.filter((r) => r.correct).length
  const total = record.responses.length

  const masteryChanges = topicIds.map((id) => {
    const before = prevStats.get(id) as TopicStat
    const after = nextStats.get(id) as TopicStat
    return { topicId: id, name: after.topic.short, before: before.estimate, after: after.estimate, beforeStatus: before.status, afterStatus: after.status, evidence: after.evidence, attempts: after.attempts }
  })

  const newWeaknesses: string[] = []
  for (const r of record.responses) {
    if (!r.misconception) continue
    const seenBefore = prevStats.get(r.topicId)?.misconceptions.some((m) => m.label === r.misconception)
    if (!seenBefore && !newWeaknesses.includes(r.misconception)) newWeaknesses.push(r.misconception)
  }

  const prerequisiteNotes = topicIds.map((id) => {
    const stat = nextStats.get(id) as TopicStat
    const dependents = dependentsOf(id)
    if (stat.missingPrereqs.length) return `${stat.topic.short} builds on ${names(stat.missingPrereqs)}, which ${stat.missingPrereqs.length > 1 ? 'are' : 'is'} not yet shown as secure.`
    return `${stat.topic.short}: prerequisites look secure${dependents.length ? `. It unlocks ${names(dependents)}` : ''}.`
  })

  const prevTop3 = prevRecs.slice(0, 3).map((r) => r.topic)
  const nextTop3 = nextRecs.slice(0, 3).map((r) => r.topic)
  const added = nextTop3.filter((t) => !prevTop3.some((p) => p.id === t.id)).map((t) => t.short)
  const removed = prevTop3.filter((t) => !nextTop3.some((n) => n.id === t.id)).map((t) => t.short)

  const prevTop = prevRecs[0]?.topic
  const nextTop = nextRecs[0]?.topic
  const improved = masteryChanges.filter((m) => m.after - m.before >= 0.04).sort((a, b) => (b.after - b.before) - (a.after - a.before))
  const declined = masteryChanges.filter((m) => m.after - m.before <= -0.04).sort((a, b) => (a.after - a.before) - (b.after - b.before))
  const topChanged = !!prevTop && !!nextTop && prevTop.id !== nextTop.id

  let message: string
  if (!nextTop) {
    message = 'No topics currently need extra attention. Keep practising to build stronger evidence.'
  } else if (topChanged && improved.length && !declined.length) {
    message = `Your recommendation changed because your latest quiz showed improvement in ${improved[0].name}, so the next priority is now ${nextTop.short}.`
  } else if (topChanged && declined.length) {
    message = `Your recommendation changed because your latest quiz showed new difficulty in ${declined[0].name}, so ${nextTop.short} is now the priority. Targeted practice has been added to your plan.`
  } else if (topChanged) {
    message = `Your recommendation changed after re-checking prerequisites, so the next priority is now ${nextTop.short}. ${nextRecs[0].reason}`
  } else if (improved.length) {
    message = `You improved in ${improved[0].name}. ${nextTop.short} stays your top priority: ${nextRecs[0].reason}`
  } else if (declined.length) {
    message = `Your latest quiz showed some difficulty in ${declined[0].name}. ${nextTop.short} remains the top priority, and targeted practice is ready.`
  } else {
    message = `${nextTop.short} stays your top priority: ${nextRecs[0].reason}`
  }
  if (total < 4) message += ' This is based on a small sample, so treat it as preliminary.'

  return { recordId: record.id, title: record.title, correct, total, message, topChanged, masteryChanges, newWeaknesses, prerequisiteNotes, added, removed, nextTopics: nextTop3.map((t) => t.short) }
}


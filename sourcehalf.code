'use client'

import { useState } from 'react'
import { ArrowRight, Check, CircleCheck, RefreshCw, X } from 'lucide-react'
import { questionsForTopic, topicById, topics, wrongOptionIndex } from '@/lib/studyverse/content'
import { pct } from '@/lib/studyverse/engine'
import type { ChangeSummary, Confidence, QuizResponse } from '@/lib/studyverse/types'
import { useStudyVerse } from './store'
import { DemoBadge, EvidenceBadge, PageIntro, statusLabel, type Navigate } from './ui'

type Answer = { choice: number; reasoning: string; confidence: Confidence }

function toResponses(topicId: string, answers: Answer[]): QuizResponse[] {
  return questionsForTopic(topicId).map((q, i) => {
    const a = answers[i]
    const correct = a.choice === q.answer
    let reasoningNote: string | undefined
    if (!correct && a.confidence === 'High') reasoningNote = 'Answered confidently but incorrectly, so this is worth reviewing'
    else if (!correct && a.reasoning.trim().length < 15) reasoningNote = `Brief explanation on "${q.concept}", so the reasoning was unclear`
    return { questionId: q.id, topicId, choice: a.choice, correct, misconception: correct ? undefined : q.traps[a.choice], reasoningNote, confidence: a.confidence }
  })
}

function ChangePanel({ summary, onNavigate }: { summary: ChangeSummary; onNavigate: Navigate }) {
  const steps: { title: string; detail: React.ReactNode }[] = [
    { title: 'Saved result', detail: `${summary.title}: ${summary.correct}/${summary.total} correct.` },
    { title: 'Updated topic-level performance', detail: summary.masteryChanges.map((m) => `${m.name}: now ${m.attempts} answers`).join(' · ') },
    {
      title: 'Re-evaluated mastery confidence',
      detail: (
        <ul className="space-y-1">
          {summary.masteryChanges.map((m) => (
            <li key={m.topicId} className="flex flex-wrap items-center gap-2">
              <span>{m.name}: {pct(m.before)} → <strong className={m.after >= m.before ? 'text-[#2e7655]' : 'text-[#9b663c]'}>{pct(m.after)}</strong> ({statusLabel(m.beforeStatus)} → {statusLabel(m.afterStatus)})</span>
              <EvidenceBadge level={m.evidence} />
            </li>
          ))}
        </ul>
      ),
    },
    { title: 'Identified newly observed weaknesses', detail: summary.newWeaknesses.length ? `${summary.newWeaknesses.join('; ')}. Seen once so far, so we'll look for it again before treating it as a pattern.` : 'No new error patterns observed.' },
    { title: 'Re-checked relevant prerequisites', detail: summary.prerequisiteNotes.join(' ') },
    { title: 'Updated recommended topics', detail: `Now: ${summary.nextTopics.join(', ') || 'none'}.${summary.added.length ? ` Added ${summary.added.join(', ')}.` : ''}${summary.removed.length ? ` No longer top 3: ${summary.removed.join(', ')}.` : ''}` },
    { title: 'Recalculated study-plan priorities', detail: 'Today’s and this week’s tasks were rebuilt from the new priorities.' },
    { title: 'Updated dashboard charts and progress', detail: 'Mastery bars, strengths and minutes on the Overview now include this quiz.' },
  ]
  return (
    <div className="rounded-2xl border border-[#cfe3f1] bg-white p-5 md:p-6" aria-live="polite">
      <p className="flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.16em] text-[#247eb7]"><RefreshCw size={14} /> What changed</p>
      <p className="mt-3 rounded-xl bg-[#eef6fc] p-4 text-sm leading-6 text-[#174a7e]">{summary.message}</p>
      <ol className="mt-5 space-y-3">
        {steps.map((s) => (
          <li key={s.title} className="flex gap-3 text-xs">
            <CircleCheck size={16} className="mt-0.5 shrink-0 text-[#4e9a72]" />
            <div className="min-w-0 leading-5 text-[#6f7c74]"><p className="font-semibold text-[#34433b]">{s.title}</p><div className="mt-0.5">{s.detail}</div></div>
          </li>
        ))}
      </ol>
      <div className="mt-6 flex flex-wrap gap-2">
        <button onClick={() => onNavigate('Overview')} className="rounded-xl bg-[#174a7e] px-4 py-2.5 text-xs font-semibold text-white">View dashboard</button>
        <button onClick={() => onNavigate('Study Planner')} className="rounded-xl border border-[#e2e8e2] px-4 py-2.5 text-xs font-semibold text-[#65756b]">See updated plan</button>
        <button onClick={() => onNavigate('Learning Gaps')} className="rounded-xl border border-[#e2e8e2] px-4 py-2.5 text-xs font-semibold text-[#65756b]">Open learning gaps</button>
      </div>
    </div>
  )
}

export function PracticeQuiz({ onNavigate }: { onNavigate: Navigate }) {
  const { practiceTopicId, recs, stats, submitQuiz } = useStudyVerse()
  const [topicId, setTopicId] = useState(practiceTopicId ?? recs[0]?.topic.id ?? topics[0].id)
  const [phase, setPhase] = useState<'setup' | 'quiz' | 'results'>('setup')
  const [index, setIndex] = useState(0)
  const [answers, setAnswers] = useState<Answer[]>([])
  const [selected, setSelected] = useState<number | null>(null)
  const [checked, setChecked] = useState(false)
  const [reasoning, setReasoning] = useState('')
  const [confidence, setConfidence] = useState<Confidence>('Medium')
  const [summary, setSummary] = useState<ChangeSummary | null>(null)

  const topic = topicById(topicId)
  const questions = questionsForTopic(topicId)
  const question = questions[index]
  const stat = stats.get(topicId)

  const finish = (final: Answer[]) => {
    setAnswers(final)
    setSummary(submitQuiz(`${topic.short} practice`, toResponses(topicId, final)))
    setPhase('results')
  }
  const start = () => { setPhase('quiz'); setIndex(0); setAnswers([]); setSelected(null); setChecked(false); setReasoning(''); setConfidence('Medium'); setSummary(null) }
  const next = () => {
    if (selected === null) return
    const final = [...answers, { choice: selected, reasoning, confidence }]
    if (index === questions.length - 1) return finish(final)
    setAnswers(final); setIndex(index + 1); setSelected(null); setChecked(false); setReasoning(''); setConfidence('Medium')
  }
  const demoFill = (mode: 'strong' | 'mixed') => finish(questions.map((q, i) => ({ choice: mode === 'strong' || i === 0 ? q.answer : wrongOptionIndex(q, 0), reasoning: mode === 'strong' ? 'Worked through each step carefully' : '', confidence: 'Medium' })))

  if (phase === 'setup') {
    return (
      <section>
        <PageIntro eyebrow="Practice" title="Practice with purpose" description="Each quiz updates your mastery estimates, recommendations and study plan straight away, and tells you why anything changed." badge={<DemoBadge>Deterministic demo engine</DemoBadge>} />
        <div className="mt-8 rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-7">
          <h2 className="text-sm font-semibold text-[#34433b]">Choose a topic</h2>
          <div className="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
            {topics.map((t) => {
              const s = stats.get(t.id)
              const recIndex = recs.findIndex((r) => r.topic.id === t.id)
              return (
                <button key={t.id} onClick={() => setTopicId(t.id)} aria-pressed={topicId === t.id} className={`rounded-xl border p-3 text-left transition ${topicId === t.id ? 'border-[#247eb7] bg-[#eaf5fb]' : 'border-[#e1e9ef] hover:border-[#a9c9dd]'}`}>
                  <p className="text-xs font-semibold text-[#34433b]">{t.short}</p>
                  <p className="mt-1 text-[11px] text-[#87928a]">{s?.attempts ? `${pct(s.estimate)} · ${s.attempts} answers` : 'Not assessed'}{recIndex > -1 && recIndex < 3 ? ` · #${recIndex + 1} priority` : ''}</p>
                </button>
              )
            })}
          </div>
          <div className="mt-6 flex flex-wrap items-center gap-3 rounded-xl bg-[#fafbf9] p-4">
            <div className="min-w-0 flex-1">
              <p className="font-serif text-xl font-semibold text-[#34433b]">{topic.name}</p>
              <p className="mt-1 text-xs text-[#87928a]">{questions.length} questions · about {questions.length * 2} minutes · counts toward today&apos;s goal</p>
            </div>
            {stat && <EvidenceBadge level={stat.evidence} />}
          </div>
          <div className="mt-6 flex flex-wrap gap-3">
            <button onClick={start} className="flex items-center gap-2 rounded-xl bg-[#174a7e] px-5 py-3 text-sm font-semibold text-white">Start quiz <ArrowRight size={16} /></button>
          </div>
          <div className="mt-6 border-t border-[#eef1ed] pt-5">
            <p className="text-[11px] font-semibold uppercase tracking-[0.14em] text-[#a0aaa3]">Demo shortcuts</p>
            <p className="mt-1 text-xs text-[#87928a]">Submit an instant result to see the engine respond to changed scores.</p>
            <div className="mt-3 flex flex-wrap gap-2">
              <button onClick={() => demoFill('strong')} className="rounded-xl border border-[#cfe6d8] bg-[#f3faf6] px-3 py-2 text-xs font-semibold text-[#2e7655]">Simulate a strong result</button>
              <button onClick={() => demoFill('mixed')} className="rounded-xl border border-[#f0dcc6] bg-[#fffaf4] px-3 py-2 text-xs font-semibold text-[#9b663c]">Simulate a result with mistakes</button>
            </div>
          </div>
        </div>
      </section>
    )
  }

  if (phase === 'results' && summary) {
    return (
      <section>
        <PageIntro eyebrow="Practice · Results" title={`${summary.correct} of ${summary.total} correct`} description={`${topic.name}. Your result is saved and everything below has been recalculated.`} />
        <div className="mt-8 grid gap-6 lg:grid-cols-[0.9fr_1.1fr]">
          <ul className="space-y-3">
            {questions.map((q, i) => {
              const a = answers[i]
              const correct = a?.choice === q.answer
              return (
                <li key={q.id} className="rounded-2xl border border-[#e5eae5] bg-white p-4">
                  <div className="flex items-start gap-3">
                    <span className={`grid h-6 w-6 shrink-0 place-items-center rounded-full ${correct ? 'bg-[#e8f5ee] text-[#2e7655]' : 'bg-[#fff0e1] text-[#9b663c]'}`}>{correct ? <Check size={13} /> : <X size={13} />}</span>
                    <div className="min-w-0 text-xs leading-5">
                      <p className="font-semibold text-[#34433b]">{q.prompt}</p>
                      {!correct && a && <p className="mt-1 text-[#9b663c]">You chose {q.options[a.choice]}. {q.traps[a.choice]}.</p>}
                      <p className="mt-1 text-[#78877e]">{q.explain}</p>
                    </div>
                  </div>
                </li>
              )
            })}
            <li><button onClick={() => setPhase('setup')} className="rounded-xl border border-[#e2e8e2] bg-white px-4 py-2.5 text-xs font-semibold text-[#65756b]">Take another quiz</button></li>
          </ul>
          <ChangePanel summary={summary} onNavigate={onNavigate} />
        </div>
      </section>
    )
  }

  return (
    <section className="mx-auto max-w-3xl">
      <div className="flex items-center justify-between text-xs font-semibold text-[#829087]"><span>Question {index + 1} of {questions.length}</span><span>{topic.short}</span></div>
      <div className="mt-3 h-2 rounded-full bg-[#dce8ef]"><div className="h-full rounded-full bg-[#247eb7] transition-all" style={{ width: `${((index + 1) / questions.length) * 100}%` }} /></div>
      <div className="mt-8 rounded-3xl border border-[#e1e9ef] bg-white p-6 shadow-sm md:p-10">
        <span className="rounded-full bg-[#f0f6f1] px-3 py-1 text-[11px] font-semibold text-[#4e9a72]">{question.concept}</span>
        <h1 className="mt-5 font-serif text-3xl font-semibold leading-tight text-[#243b52]">{question.prompt}</h1>
        <div className="mt-7 grid gap-3" role="radiogroup" aria-label="Answer options">
          {question.options.map((option, i) => {
            const isAnswer = checked && i === question.answer
            const isWrongPick = checked && selected === i && i !== question.answer
            return (
              <button key={option} role="radio" aria-checked={selected === i} disabled={checked} onClick={() => setSelected(i)} className={`flex items-center gap-3 rounded-2xl border p-4 text-left text-sm transition ${isAnswer ? 'border-[#63ad86] bg-[#eef8f1] text-[#2e7655]' : isWrongPick ? 'border-[#e3b58e] bg-[#fff6ee] text-[#9b663c]' : selected === i ? 'border-[#247eb7] bg-[#eaf5fb] text-[#174a7e]' : 'border-[#e1e9ef] text-[#5f6f7f] hover:border-[#a9c9dd]'}`}>
                <span className="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#f1f5f8] text-xs font-semibold">{String.fromCharCode(65 + i)}</span>{option}
              </button>
            )
          })}
        </div>
        <label className="mt-6 block text-xs font-semibold text-[#46544c]">
          How did you work it out? <span className="font-normal text-[#a0aaa3]">(optional, helps us understand your reasoning)</span>
          <textarea value={reasoning} onChange={(e) => setReasoning(e.target.value.slice(0, 400))} disabled={checked} rows={2} className="mt-2 w-full rounded-xl border border-[#e1e9ef] p-3 text-sm font-normal text-[#34433b]" />
        </label>
        <fieldset className="mt-4">
          <legend className="text-xs font-semibold text-[#46544c]">How confident are you?</legend>
          <div className="mt-2 flex gap-2">{(['Low', 'Medium', 'High'] as Confidence[]).map((c) => <button key={c} disabled={checked} aria-pressed={confidence === c} onClick={() => setConfidence(c)} className={`rounded-xl border px-3 py-1.5 text-xs font-semibold ${confidence === c ? 'border-[#63ad86] bg-[#eef8f1] text-[#2e7655]' : 'border-[#e1e9ef] text-[#718096]'}`}>{c}</button>)}</div>
        </fieldset>
        {checked && <p className={`mt-5 rounded-xl p-4 text-xs leading-5 ${selected === question.answer ? 'bg-[#eef8f1] text-[#2e7655]' : 'bg-[#fff6ee] text-[#8a5a32]'}`}>{selected === question.answer ? 'Correct. ' : `Not quite: ${question.traps[selected ?? 0]?.toLowerCase()}. `}{question.explain}</p>}
        <div className="mt-6 flex justify-end gap-3">
          {!checked ? (
            <button onClick={() => setChecked(true)} disabled={selected === null} className="rounded-xl bg-[#174a7e] px-5 py-3 text-sm font-semibold text-white disabled:opacity-40">Check answer</button>
          ) : (
            <button onClick={next} className="flex items-center gap-2 rounded-xl bg-[#174a7e] px-5 py-3 text-sm font-semibold text-white">{index === questions.length - 1 ? 'Finish and update my plan' : 'Next question'} <ArrowRight size={16} /></button>
          )}
        </div>
      </div>
    </section>
  )
}


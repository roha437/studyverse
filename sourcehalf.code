'use client'

import { Flame } from 'lucide-react'
import { addDays, formatDateKey } from '@/lib/studyverse/dates'
import { useStudyVerse } from './store'

export function SidebarStreak({ onOpen }: { onOpen: () => void }) {
  const { streak, today } = useStudyVerse()
  const week = Array.from({ length: 7 }, (_, i) => addDays(today, i - 6))
  return (
    <button onClick={onOpen} className="mt-auto rounded-2xl bg-[#f0f6f1] p-4 text-left">
      <span className="mb-3 flex items-center gap-2 text-[#3c815f]"><Flame size={16} fill="currentColor" /><span className="text-xs font-semibold">{streak.current} day streak</span></span>
      <span className="block text-[11px] leading-relaxed text-[#829087]">{streak.todayMet ? 'Today’s goal is done.' : `${Math.max(0, streak.todayGoal - streak.todayMinutes)} min left for today’s goal.`}</span>
      <span className="mt-3 flex gap-1.5">{week.map((d) => <span key={d} className={`h-1.5 flex-1 rounded-full ${streak.met(d) ? 'bg-[#64bd91]' : 'bg-[#d7e5da]'}`} />)}</span>
    </button>
  )
}

export function HeaderDate() {
  const { today } = useStudyVerse()
  return <span>{formatDateKey(today, { weekday: 'long', day: 'numeric', month: 'long' })}</span>
}


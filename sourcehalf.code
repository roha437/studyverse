                  </div>

                  <div className="grid grid-cols-3 gap-2 text-center pt-1">
                    <div className="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
                      <div className="text-xs text-slate-500">Daily Goal</div>
                      <div className="text-sm font-bold text-slate-900">30 mins</div>
                    </div>
                    <div className="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
                      <div className="text-xs text-slate-500">Reasoning Check</div>
                      <div className="text-sm font-bold text-emerald-700">Active</div>
                    </div>
                    <div className="p-2.5 rounded-lg bg-slate-50 border border-slate-200/80">
                      <div className="text-xs text-slate-500">Study Streak</div>
                      <div className="text-sm font-bold text-amber-600">9 Days 🔥</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      {/* Interactive 17-Step Learning Cycle Section */}
      <section className="py-14 bg-white border-y border-slate-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
          <div className="text-center max-w-3xl mx-auto space-y-2">
            <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
              How StudyVerse Works
            </span>
            <h2 className="text-2xl sm:text-3xl font-extrabold text-slate-900">
              One Continuous, Evidence-Based Learning Loop
            </h2>
            <p className="text-sm sm:text-base text-slate-600">
              Unlike standalone chatbots or static quiz banks, StudyVerse connects diagnosis, earlier-class foundations, textbook learning, and adaptive planning.
            </p>
          </div>

          <div className="grid grid-cols-1 md:grid-cols-4 gap-4">
            {cycleSteps.map((item, idx) => {
              const active = activeCyclePhase === idx;
              return (
                <button
                  key={item.phase}
                  type="button"
                  onClick={() => setActiveCyclePhase(idx)}
                  className={`text-left p-5 rounded-2xl border transition-all ${
                    active
                      ? 'bg-blue-900 text-white border-blue-900 shadow-lg shadow-blue-900/15'
                      : 'bg-slate-50 hover:bg-slate-100 text-slate-900 border-slate-200'
                  }`}
                >
                  <div className="flex items-center justify-between mb-2">
                    <span
                      className={`text-[11px] font-bold px-2 py-0.5 rounded ${
                        active ? 'bg-sky-400/20 text-sky-200' : 'bg-blue-100 text-blue-900'
                      }`}
                    >
                      {item.steps}
                    </span>
                    <span
                      className={`text-[11px] font-medium ${
                        active ? 'text-slate-300' : 'text-slate-500'
                      }`}
                    >
                      {item.badge}
                    </span>
                  </div>
                  <h3 className="font-bold text-base mb-1.5">{item.phase}</h3>
                  <p className={`text-xs leading-relaxed ${active ? 'text-slate-200' : 'text-slate-600'}`}>
                    {item.desc}
                  </p>
                </button>
              );
            })}
          </div>
        </div>
      </section>

      {/* Features Grid */}
      <section id="features-showcase" className="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
        <div className="text-center max-w-3xl mx-auto space-y-2">
          <span className="text-xs font-bold uppercase tracking-wider text-violet-600">
            Platform Capabilities
          </span>
          <h2 className="text-2xl sm:text-3xl font-extrabold text-slate-900">
            Designed Around Real Student Understanding
          </h2>
          <p className="text-sm sm:text-base text-slate-600">
            Every feature works together to identify learning gaps honestly and guide you step-by-step.
          </p>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((feat) => {
            const IconComponent = feat.icon;
            return (
              <div
                key={feat.title}
                className="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between"
              >
                <div className="space-y-3">
                  <div className={`w-11 h-11 rounded-xl border flex items-center justify-center ${feat.color}`}>
                    <IconComponent className="w-5 h-5" />
                  </div>
                  <h3 className="text-lg font-bold text-slate-900">{feat.title}</h3>
                  <p className="text-sm text-slate-600 leading-relaxed">{feat.desc}</p>
                </div>
                <div className="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-900">
                  <span>Included in Class 6–10 Workflow</span>
                  <CheckCircle2 className="w-4 h-4 text-emerald-600" />
                </div>
              </div>
            );
          })}
        </div>

        {/* Bottom CTA Card */}
        <div className="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 rounded-2xl p-8 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl">
          <div className="space-y-2 max-w-xl">
            <div className="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-sky-300">
              <ShieldCheck className="w-4 h-4" />
              Ready to Experience the Full 16-Step Journey?
            </div>
            <h3 className="text-2xl font-extrabold">
              Begin Your Personalized Diagnostic or Explore Demo Mode
            </h3>
            <p className="text-sm text-blue-100">
              Select Class 8, CBSE, Mathematics &amp; Science, set a 30-minute daily goal, and see how StudyVerse adapts to your answers and reasoning in real time.
            </p>
          </div>
          <div className="flex flex-wrap gap-3">
            <button
              type="button"
              onClick={onStartOnboarding}
              className="px-6 py-3 rounded-xl bg-white text-blue-900 font-bold text-sm hover:bg-blue-50 transition shadow"
            >
              Start Step-by-Step Onboarding
            </button>
            <button
              type="button"
              onClick={onLoadPrebuiltDemo}
              className="px-5 py-3 rounded-xl bg-sky-500/20 text-white border border-sky-400/40 font-semibold text-sm hover:bg-sky-500/30 transition"
            >
              Open Pre-Loaded Class 8 Dashboard
            </button>
          </div>
        </div>
      </section>
    </div>
  );
};

// ==========================================
// MODULE: components/OnboardingWizard.tsx
// ==========================================
interface OnboardingWizardProps {
  initialStudent: Student;
  onCompleteOnboarding: (updatedStudent: Student) => void;
  onCancelToLanding: () => void;
}

const ALL_CLASSES: ClassLevel[] = [6, 7, 8, 9, 10];
const ALL_SUBJECTS: SubjectName[] = ['Mathematics', 'Science', 'English', 'Social Science'];
const STUDY_DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
const TIME_SLOTS = [
  'Morning (6:30 AM – 8:00 AM)',
  'Afternoon (3:30 PM – 5:00 PM)',
  'Evening (5:30 PM – 7:30 PM)',
  'Night (8:00 PM – 9:30 PM)',
];

const OnboardingWizard: React.FC<OnboardingWizardProps> = ({
  initialStudent,
  onCompleteOnboarding,
  onCancelToLanding,
}) => {
  const [step, setStep] = useState<number>(1);
  const [showWeakConfirmation, setShowWeakConfirmation] = useState<boolean>(false);

  const [displayName, setDisplayName] = useState<string>(initialStudent.displayName || 'Aarav Sharma');
  const [classLevel, setClassLevel] = useState<ClassLevel>(initialStudent.classLevel || 8);
  const [board, setBoard] = useState<BoardType>('CBSE');
  const [selectedSubjects, setSelectedSubjects] = useState<SubjectName[]>(
    initialStudent.selectedSubjects.length > 0
      ? initialStudent.selectedSubjects
      : ['Mathematics', 'Science']
  );
  const [selectedWeakSubjects, setSelectedWeakSubjects] = useState<SubjectName[]>(
    initialStudent.selectedWeakSubjects
  );
  const [dailyGoalMinutes, setDailyGoalMinutes] = useState<number>(
    initialStudent.dailyGoalMinutes || 30
  );
  const [customMinutesMode, setCustomMinutesMode] = useState<boolean>(false);
  const [preferredStudyDays, setPreferredStudyDays] = useState<string[]>(
    initialStudent.preferredStudyDays.length > 0
      ? initialStudent.preferredStudyDays
      : ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
  );
  const [preferredStudyTime, setPreferredStudyTime] = useState<string>(
    initialStudent.preferredStudyTime || 'Evening (5:30 PM – 7:30 PM)'
  );
  const [learningGoal, setLearningGoal] = useState<string>(
    initialStudent.learningGoal || 'Strengthen foundations, fix weak topics, and score high in school exams'
  );

  const toggleSubject = (subj: SubjectName) => {
    if (selectedSubjects.includes(subj)) {
      if (selectedSubjects.length === 1) return; // Keep at least 1 subject
      setSelectedSubjects(selectedSubjects.filter((s) => s !== subj));
      setSelectedWeakSubjects(selectedWeakSubjects.filter((s) => s !== subj));
    } else {
      setSelectedSubjects([...selectedSubjects, subj]);
    }
  };

  const toggleWeakSubject = (subj: SubjectName) => {
    if (selectedWeakSubjects.includes(subj)) {
      setSelectedWeakSubjects(selectedWeakSubjects.filter((s) => s !== subj));
    } else {
      setSelectedWeakSubjects([...selectedWeakSubjects, subj]);
    }
  };

  const toggleStudyDay = (day: string) => {
    if (preferredStudyDays.includes(day)) {
      if (preferredStudyDays.length === 1) return;
      setPreferredStudyDays(preferredStudyDays.filter((d) => d !== day));
    } else {
      setPreferredStudyDays([...preferredStudyDays, day]);
    }
  };

  const handleFinalizeToDiagnostic = () => {
    onCompleteOnboarding({
      ...initialStudent,
      displayName: displayName.trim() || 'Student',
      classLevel,
      board,
      selectedSubjects,
      selectedWeakSubjects,
      dailyGoalMinutes,
      preferredStudyDays,
      preferredStudyTime,
      learningGoal,
      diagnosticCompleted: false,
    });
  };

  return (
    <div className="min-h-screen bg-slate-50 flex flex-col">
      {/* Header */}
      <header className="bg-white border-b border-slate-200 h-16 px-4 sm:px-8 flex items-center justify-between">
        <StudyVerseLogo size="sm" />
        <div className="flex items-center gap-4">
          <div className="hidden sm:flex items-center gap-1.5 text-xs font-semibold text-slate-600">
            <span>Onboarding Step {step} of 6</span>
          </div>
          <button
            type="button"
            onClick={onCancelToLanding}
            className="text-xs font-semibold text-slate-500 hover:text-slate-800 px-3 py-1.5 rounded-lg border border-slate-200"
          >
            Back to Home
          </button>
        </div>
      </header>

      {/* Progress Bar */}
      <div className="bg-white border-b border-slate-200 px-4 py-3">
        <div className="max-w-3xl mx-auto">
          <div className="grid grid-cols-6 gap-2">
            {[
              '1. Class',
              '2. Board',
              '3. Subjects',
              '4. Weak Areas',
              '5. Study Time',
              '6. Diagnostic',
            ].map((label, idx) => {
              const sNum = idx + 1;
              const isDone = step > sNum;
              const isCurrent = step === sNum;
              return (
                <div key={label} className="space-y-1.5">
                  <div
                    className={`h-2 rounded-full transition-all ${
                      isDone
                        ? 'bg-emerald-500'
                        : isCurrent
                        ? 'bg-blue-900'
                        : 'bg-slate-200'
                    }`}
                  />
                  <p
                    className={`text-[11px] font-semibold truncate ${
                      isCurrent
                        ? 'text-blue-900'
                        : isDone
                        ? 'text-emerald-700'
                        : 'text-slate-400'
                    }`}
                  >
                    {label}
                  </p>
                </div>
              );
            })}
          </div>
        </div>
      </div>

      {/* Main Content Card */}
      <main className="flex-1 flex items-center justify-center p-4 sm:p-8">
        <div className="w-full max-w-2xl bg-white rounded-2xl border border-slate-200 shadow-lg p-6 sm:p-8 space-y-6">
          {/* STEP 1: SELECT CLASS */}
          {step === 1 && (
            <div className="space-y-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
                  Step 1 of 6 • Academic Profile
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Welcome! Let&rsquo;s set up your class profile
                </h2>
                <p className="text-sm text-slate-600 mt-1">
                  StudyVerse tailors textbook explanations, questions, and earlier-class prerequisite bridges to your grade level.
                </p>
              </div>

              <div className="space-y-2">
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Your Name
                </label>
                <input
                  type="text"
                  value={displayName}
                  onChange={(e) => setDisplayName(e.target.value)}
                  placeholder="Enter your name"
                  className="w-full px-4 py-2.5 rounded-xl border border-slate-300 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-blue-900"
                />
              </div>

              <div className="space-y-2">
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Select Your Class
                </label>
                <div className="grid grid-cols-2 sm:grid-cols-5 gap-3">
                  {ALL_CLASSES.map((c) => {
                    const selected = classLevel === c;
                    return (
                      <button
                        key={c}
                        type="button"
                        onClick={() => setClassLevel(c)}
                        className={`p-4 rounded-xl border text-center transition-all ${
                          selected
                            ? 'bg-blue-900 text-white border-blue-900 shadow-md'
                            : 'bg-slate-50 hover:bg-slate-100 text-slate-800 border-slate-200'
                        }`}
                      >
                        <div className="text-lg font-extrabold">Class {c}</div>
                        <div
                          className={`text-[10px] mt-1 font-semibold ${
                            selected ? 'text-sky-200' : 'text-slate-500'
                          }`}
                        >
                          {c === 8 ? 'Full Demo Ready' : 'NCERT Curriculum'}
                        </div>
                      </button>
                    );
                  })}
                </div>
              </div>

              <div className="flex justify-end pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(2)}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                >
                  Continue to Education Board
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {/* STEP 2: SELECT BOARD */}
          {step === 2 && (
            <div className="space-y-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
                  Step 2 of 6 • Curriculum Alignment
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Select Your Education Board
                </h2>
                <p className="text-sm text-slate-600 mt-1">
                  StudyVerse uses official CBSE / NCERT chapters and prerequisite mappings for initial deployment.
                </p>
              </div>

              <div className="space-y-3">
                <button
                  type="button"
                  onClick={() => setBoard('CBSE')}
                  className="w-full p-5 rounded-2xl border-2 border-blue-900 bg-blue-50/50 text-left flex items-center justify-between"
                >
                  <div className="space-y-1">
                    <div className="flex items-center gap-2">
                      <span className="text-base font-extrabold text-blue-950">
                        CBSE (NCERT Curriculum)
                      </span>
                      <span className="px-2 py-0.5 text-[11px] font-bold rounded-full bg-emerald-100 text-emerald-800">
                        Active &amp; Supported
                      </span>
                    </div>
                    <p className="text-xs text-slate-600">
                      Complete chapter-wise topic graphs, NCERT textbook RAG passages, and Class 6–8 foundation links.
                    </p>
                  </div>
                  <CheckCircle2 className="w-6 h-6 text-blue-900 shrink-0" />
                </button>

                {[
                  {
                    name: 'ICSE / CISCE',
                    note: 'Planned for future release — curriculum mapping in progress',
                  },
                  {
                    name: 'State Boards (AP, Telangana, Maharashtra, Karnataka, Tamil Nadu)',
                    note: 'Planned for future release — state textbook alignment in progress',
                  },
                ].map((b) => (
                  <div
                    key={b.name}
                    className="w-full p-4 rounded-2xl border border-slate-200 bg-slate-50 text-left flex items-center justify-between opacity-75"
                  >
                    <div>
                      <div className="text-sm font-bold text-slate-700">{b.name}</div>
                      <div className="text-xs text-slate-500 mt-0.5">{b.note}</div>
                    </div>
                    <span className="px-2.5 py-1 rounded-full text-[11px] font-semibold bg-slate-200 text-slate-700">
                      Future Option
                    </span>
                  </div>
                ))}
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(1)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Back
                </button>
                <button
                  type="button"
                  onClick={() => setStep(3)}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                >
                  Continue to Subjects
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {/* STEP 3: SELECT SUBJECTS */}
          {step === 3 && (
            <div className="space-y-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
                  Step 3 of 6 • Subject Selection
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Which subjects would you like to study?
                </h2>
                <p className="text-sm text-slate-600 mt-1">
                  Select one or more subjects. Your combined diagnostic quiz will allocate questions across all selected subjects.
                </p>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                {ALL_SUBJECTS.map((subj) => {
                  const isSelected = selectedSubjects.includes(subj);
                  const subtitle =
                    subj === 'Mathematics'
                      ? 'Linear Equations, Algebraic Identities, Fractions'
                      : subj === 'Science'
                      ? 'Force & Pressure, Chemical Effects of Current'
                      : subj === 'English'
                      ? 'Active & Passive Voice, Reading & Grammar'
                      : 'The Indian Constitution, Civics & History';
                  return (
                    <button
                      key={subj}
                      type="button"
                      onClick={() => toggleSubject(subj)}
                      className={`p-4 rounded-2xl border-2 text-left transition-all flex items-start justify-between ${
                        isSelected
                          ? 'border-blue-900 bg-blue-50/60 shadow-sm'
                          : 'border-slate-200 bg-white hover:bg-slate-50'
                      }`}
                    >
                      <div className="space-y-1 pr-2">
                        <div className="text-base font-bold text-slate-900">{subj}</div>
                        <p className="text-xs text-slate-600 leading-relaxed">{subtitle}</p>
                      </div>
                      <div
                        className={`w-5 h-5 rounded-full flex items-center justify-center mt-0.5 ${
                          isSelected ? 'bg-blue-900 text-white' : 'border border-slate-300'
                        }`}
                      >
                        {isSelected && <CheckCircle2 className="w-4 h-4" />}
                      </div>
                    </button>
                  );
                })}
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(2)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Back
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setShowWeakConfirmation(false);
                    setStep(4);
                  }}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                >
                  Continue
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {/* STEP 4: SELECT WEAK SUBJECTS OR DEDICATED CONFIRMATION SCREEN */}
          {step === 4 && !showWeakConfirmation && (
            <div className="space-y-6">
              <div className="flex items-start justify-between gap-4">
                <div>
                  <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
                    Step 4 of 6 • Optional Self-Reflection
                  </span>
                  <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                    Do any subjects feel difficult right now?
                  </h2>
                  <p className="text-sm text-slate-600 mt-1">
                    Select any subjects you feel less confident in, or click <strong>Skip</strong>. StudyVerse treats this as a helpful priority preference while still assessing your actual performance independently in the diagnostic quiz.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() => {
                    setSelectedWeakSubjects([]);
                    setShowWeakConfirmation(false);
                    setStep(5);
                  }}
                  className="shrink-0 px-4 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs border border-slate-300 transition"
                >
                  Skip This Step →
                </button>
              </div>

              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                {selectedSubjects.map((subj) => {
                  const isWeak = selectedWeakSubjects.includes(subj);
                  return (
                    <button
                      key={subj}
                      type="button"
                      onClick={() => toggleWeakSubject(subj)}
                      className={`p-4 rounded-2xl border-2 text-left transition-all flex items-center justify-between ${
                        isWeak
                          ? 'border-violet-600 bg-violet-50/70'
                          : 'border-slate-200 bg-white hover:bg-slate-50'
                      }`}
                    >
                      <div>
                        <div className="text-sm font-bold text-slate-900">{subj}</div>
                        <div className="text-xs text-slate-500 mt-0.5">
                          {isWeak ? 'Marked for extra focus & priority revision' : 'Click to prioritize'}
                        </div>
                      </div>
                      <span
                        className={`px-2.5 py-1 rounded-full text-xs font-semibold ${
                          isWeak
                            ? 'bg-violet-600 text-white'
                            : 'bg-slate-100 text-slate-600'
                        }`}
                      >
                        {isWeak ? 'Selected' : 'Optional'}
                      </span>
                    </button>
                  );
                })}
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(3)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Back
                </button>
                <div className="flex items-center gap-3">
                  <button
                    type="button"
                    onClick={() => {
                      setSelectedWeakSubjects([]);
                      setShowWeakConfirmation(false);
                      setStep(5);
                    }}
                    className="px-4 py-3 rounded-xl border border-slate-300 text-slate-700 font-semibold text-sm hover:bg-slate-100 transition"
                  >
                    Skip (No Specific Weak Subject)
                  </button>
                  <button
                    type="button"
                    onClick={() => {
                      if (selectedWeakSubjects.length > 0) {
                        setShowWeakConfirmation(true);
                      } else {
                        setStep(5);
                      }
                    }}
                    className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                  >
                    Continue
                    <ArrowRight className="w-4 h-4" />
                  </button>
                </div>
              </div>
            </div>
          )}

          {/* DEDICATED WEAK SUBJECT CONFIRMATION SCREEN (Workflow Step 5) */}
          {step === 4 && showWeakConfirmation && (
            <div className="space-y-6">
              <div className="p-6 rounded-2xl bg-gradient-to-br from-blue-900 via-indigo-900 to-violet-900 text-white space-y-4">
                <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 text-sky-200 text-xs font-bold">
                  <Sparkles className="w-3.5 h-3.5" />
                  Personalized Focus Confirmation
                </div>
                <h2 className="text-2xl sm:text-3xl font-extrabold leading-tight">
                  &ldquo;Okay, then let&rsquo;s focus on those subjects more.&rdquo;
                </h2>
                <p className="text-sm text-blue-100 leading-relaxed">
                  You selected{' '}
                  <strong className="text-white underline decoration-sky-400">
                    {selectedWeakSubjects.join(' & ')}
                  </strong>{' '}
                  as areas where you want extra support. Here is how StudyVerse will use this preference:
                </p>
                <div className="flex flex-wrap gap-2 pt-1">
                  {selectedWeakSubjects.map((s) => (
                    <span
                      key={s}
                      className="px-3 py-1.5 rounded-xl bg-white/15 border border-white/25 text-sm font-bold text-white"
                    >
                      🎯 Priority Subject: {s}
                    </span>
                  ))}
                </div>
              </div>

              <div className="space-y-3 bg-slate-50 p-4 rounded-xl border border-slate-200 text-xs text-slate-700">
                <div className="flex items-start gap-2.5">
                  <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                  <span>
                    <strong>Prioritized Study Plan &amp; Revision:</strong> When two topics have similar scores, StudyVerse will schedule{' '}
                    {selectedWeakSubjects.join(', ')} first in your daily planner.
                  </span>
                </div>
                <div className="flex items-start gap-2.5">
                  <AlertCircle className="w-4 h-4 text-sky-600 shrink-0 mt-0.5" />
                  <span>
                    <strong>Independent Diagnostic Verification:</strong> Self-reported weaknesses are treated as helpful preferences, not permanent labels. Your diagnostic quiz will still evaluate all selected subjects objectively.
                  </span>
                </div>
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setShowWeakConfirmation(false)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Change Selection
                </button>
                <button
                  type="button"
                  onClick={() => {
                    setShowWeakConfirmation(false);
                    setStep(5);
                  }}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                >
                  Configure Daily Study Time
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {/* STEP 5: CONFIGURE STUDY TIME & GOALS */}
          {step === 5 && (
            <div className="space-y-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
                  Step 5 of 6 • Schedule &amp; Daily Goals
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Configure Your Available Study Time
                </h2>
                <p className="text-sm text-slate-600 mt-1">
                  StudyVerse fits your foundation lessons, practice quizzes, and revision into your realistic daily schedule without overloading you.
                </p>
              </div>

              {/* Daily Duration Options */}
              <div className="space-y-2">
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Daily Study Duration Goal
                </label>
                <div className="grid grid-cols-2 sm:grid-cols-5 gap-2.5">
                  {[
                    { label: '20 minutes', mins: 20 },
                    { label: '30 minutes', mins: 30 },
                    { label: '45 minutes', mins: 45 },
                    { label: '1 hour', mins: 60 },
                  ].map((opt) => {
                    const active = !customMinutesMode && dailyGoalMinutes === opt.mins;
                    return (
                      <button
                        key={opt.mins}
                        type="button"
                        onClick={() => {
                          setCustomMinutesMode(false);
                          setDailyGoalMinutes(opt.mins);
                        }}
                        className={`p-3 rounded-xl border text-center transition ${
                          active
                            ? 'bg-blue-900 text-white border-blue-900 font-bold shadow-sm'
                            : 'bg-slate-50 hover:bg-slate-100 text-slate-800 border-slate-200 font-semibold'
                        }`}
                      >
                        <Clock className="w-4 h-4 mx-auto mb-1 opacity-80" />
                        <div className="text-xs">{opt.label}</div>
                      </button>
                    );
                  })}
                  <button
                    type="button"
                    onClick={() => setCustomMinutesMode(true)}
                    className={`p-3 rounded-xl border text-center transition ${
                      customMinutesMode
                        ? 'bg-blue-900 text-white border-blue-900 font-bold shadow-sm'
                        : 'bg-slate-50 hover:bg-slate-100 text-slate-800 border-slate-200 font-semibold'
                    }`}
                  >
                    <Clock className="w-4 h-4 mx-auto mb-1 opacity-80" />
                    <div className="text-xs">Custom</div>
                  </button>
                </div>

                {customMinutesMode && (
                  <div className="pt-2 flex items-center gap-3">
                    <input
                      type="range"
                      min={15}
                      max={120}
                      step={5}
                      value={dailyGoalMinutes}
                      onChange={(e) => setDailyGoalMinutes(Number(e.target.value))}
                      className="flex-1 accent-blue-900"
                    />
                    <span className="px-3 py-1 rounded-lg bg-blue-50 text-blue-900 font-bold text-sm border border-blue-200">
                      {dailyGoalMinutes} mins/day
                    </span>
                  </div>
                )}
              </div>

              {/* Preferred Study Days */}
              <div className="space-y-2">
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                  Preferred Study Days
                </label>
                <div className="flex flex-wrap gap-2">
                  {STUDY_DAYS.map((day) => {
                    const active = preferredStudyDays.includes(day);
                    return (
                      <button
                        key={day}
                        type="button"
                        onClick={() => toggleStudyDay(day)}
                        className={`px-3.5 py-2 rounded-xl text-xs font-bold border transition ${
                          active
                            ? 'bg-sky-600 text-white border-sky-600'
                            : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'
                        }`}
                      >
                        {day}
                      </button>
                    );
                  })}
                </div>
              </div>

              {/* Preferred Time & Personal Goal */}
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div className="space-y-1.5">
                  <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Preferred Time Slot
                  </label>
                  <select
                    value={preferredStudyTime}
                    onChange={(e) => setPreferredStudyTime(e.target.value)}
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-semibold bg-white"
                  >
                    {TIME_SLOTS.map((slot) => (
                      <option key={slot} value={slot}>
                        {slot}
                      </option>
                    ))}
                  </select>
                </div>
                <div className="space-y-1.5">
                  <label className="block text-xs font-bold uppercase tracking-wider text-slate-700">
                    Primary Learning Goal
                  </label>
                  <input
                    type="text"
                    value={learningGoal}
                    onChange={(e) => setLearningGoal(e.target.value)}
                    className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs font-medium"
                  />
                </div>
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(4)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Back
                </button>
                <button
                  type="button"
                  onClick={() => setStep(6)}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
                >
                  Continue to Diagnostic Step
                  <ArrowRight className="w-4 h-4" />
                </button>
              </div>
            </div>
          )}

          {/* STEP 6: MANDATORY COMBINED DIAGNOSTIC LAUNCH */}
          {step === 6 && (
            <div className="space-y-6">
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-emerald-700">
                  Step 6 of 6 • Mandatory Initial Assessment
                </span>
                <h2 className="text-2xl font-extrabold text-slate-900 mt-1">
                  Ready for Your Combined Diagnostic Quiz
                </h2>
                <p className="text-sm text-slate-600 mt-1">
                  Before generating your personalized study plan, StudyVerse runs a short combined diagnostic across your selected subjects ({selectedSubjects.join(', ')}).
                </p>
              </div>

              <div className="bg-blue-50/70 border border-blue-200 rounded-2xl p-5 space-y-3">
                <h3 className="text-sm font-bold text-blue-950 flex items-center gap-2">
                  <ShieldCheck className="w-4 h-4 text-sky-600" />
                  What Makes This Diagnostic Different?
                </h3>
                <ul className="space-y-2 text-xs text-slate-700">
                  <li className="flex items-start gap-2">
                    <span className="font-bold text-blue-900">1.</span>
                    <span>
                      <strong>Progressive Hints (Hints 1–3):</strong> Stuck on a question? Use guided hints that point you toward the concept without spoiling the answer.
                    </span>
                  </li>
                  <li className="flex items-start gap-2">
                    <span className="font-bold text-blue-900">2.</span>
                    <span>
                      <strong>Lucky-Guess Detection:</strong> When you select a correct answer, StudyVerse asks <em>&ldquo;Can you explain why this answer is correct?&rdquo;</em> to separate genuine understanding from lucky guesses.
                    </span>
                  </li>
                  <li className="flex items-start gap-2">
                    <span className="font-bold text-blue-900">3.</span>
                    <span>
                      <strong>Prerequisite Discovery:</strong> If a Class {classLevel} mistake stems from an earlier Class 6 or Class 7 concept, StudyVerse automatically unlocks a foundation bridge lesson.
                    </span>
                  </li>
                </ul>
              </div>

              <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center">
                <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                  <div className="text-[11px] text-slate-500">Class &amp; Board</div>
                  <div className="text-xs font-bold text-slate-900">
                    Class {classLevel} • {board}
                  </div>
                </div>
                <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                  <div className="text-[11px] text-slate-500">Subjects</div>
                  <div className="text-xs font-bold text-slate-900">
                    {selectedSubjects.length} Selected
                  </div>
                </div>
                <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                  <div className="text-[11px] text-slate-500">Priority Focus</div>
                  <div className="text-xs font-bold text-violet-700">
                    {selectedWeakSubjects.length > 0
                      ? selectedWeakSubjects.join(', ')
                      : 'None (Skipped)'}
                  </div>
                </div>
                <div className="p-3 rounded-xl bg-slate-50 border border-slate-200">
                  <div className="text-[11px] text-slate-500">Daily Goal</div>
                  <div className="text-xs font-bold text-emerald-700">
                    {dailyGoalMinutes} mins/day
                  </div>
                </div>
              </div>

              <div className="flex items-center justify-between pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={() => setStep(5)}
                  className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 text-sm font-semibold hover:bg-slate-100"
                >
                  <ArrowLeft className="w-4 h-4" />
                  Back
                </button>
                <button
                  type="button"
                  onClick={handleFinalizeToDiagnostic}
                  className="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 text-white font-extrabold text-sm hover:bg-emerald-700 shadow-lg shadow-emerald-600/20 transition"
                >
                  <BookOpen className="w-4 h-4" />
                  Start Mandatory Combined Diagnostic Quiz
                </button>
              </div>
            </div>
          )}
        </div>
      </main>
    </div>
  );
};

// ==========================================
// MODULE: components/QuizEngine.tsx
// ==========================================
interface QuizRunnerProps {
  mode: 'diagnostic' | 'targeted';
  questions: QuizQuestion[];
  studentId: string;
  onFinishQuiz: (attempts: QuizAttempt[]) => void;
  onAutoSimulateDiagnostic?: () => void;
}

const QuizRunner: React.FC<QuizRunnerProps> = ({
  mode,
  questions,
  studentId,
  onFinishQuiz,
  onAutoSimulateDiagnostic,
}) => {
  const [currentIndex, setCurrentIndex] = useState<number>(0);
  const [selectedOption, setSelectedOption] = useState<number | null>(null);
  const [confidence, setConfidence] = useState<ConfidenceRating>('Medium');
  const [revealedHints, setRevealedHints] = useState<number>(0);
  const [reasoningText, setReasoningText] = useState<string>('');
  const [phase, setPhase] = useState<'answering' | 'reasoning_prompt' | 'feedback'>('answering');
  const [currentAttempt, setCurrentAttempt] = useState<QuizAttempt | null>(null);
  const [collectedAttempts, setCollectedAttempts] = useState<QuizAttempt[]>([]);

  const currentQuestion = questions[currentIndex];

  if (!currentQuestion) {
    return null;
  }

  const handleRevealNextHint = () => {
    if (revealedHints < 3) {
      setRevealedHints(revealedHints + 1);
    }
  };

  const handleInitialSubmit = () => {
    if (selectedOption === null) return;
    const isCorrect = selectedOption === currentQuestion.correctOptionIndex;

    // For correct answers (or any diagnostic question), prompt reasoning to detect lucky guesses
    if (phase === 'answering' && isCorrect) {
      setPhase('reasoning_prompt');
      return;
    }

    finalizeQuestionAttempt(reasoningText);
  };

  const finalizeQuestionAttempt = (finalReasoning: string) => {
    if (selectedOption === null) return;
    const isCorrect = selectedOption === currentQuestion.correctOptionIndex;
    const evalResult = evaluateResponseReasoning(
      isCorrect,
      finalReasoning,
      currentQuestion.expectedReasoningKeywords,
      currentQuestion.misconceptionKeywords,
      revealedHints
    );

    const attempt: QuizAttempt = {
      id: `att-${Date.now()}-${currentIndex}`,
      studentId,
      questionId: currentQuestion.id,
      topicId: currentQuestion.topicId,
      subject: currentQuestion.subject,
      selectedAnswer: selectedOption,
      isCorrect,
      reasoningText: finalReasoning.trim(),
      reasoningQuality: evalResult.quality,
      interpretationLabel: evalResult.interpretationLabel,
      confidenceRating: confidence,
      hintCount: revealedHints,
      timestamp: new Date().toISOString(),
    };

    setCurrentAttempt(attempt);
    setPhase('feedback');
  };

  const handleNextQuestion = () => {
    if (!currentAttempt) return;
    const updated = [...collectedAttempts, currentAttempt];
    setCollectedAttempts(updated);

    if (currentIndex + 1 < questions.length) {
      setCurrentIndex(currentIndex + 1);
      setSelectedOption(null);
      setConfidence('Medium');
      setRevealedHints(0);
      setReasoningText('');
      setCurrentAttempt(null);
      setPhase('answering');
    } else {
      onFinishQuiz(updated);
    }
  };

  const progressPct = Math.round(((currentIndex + 1) / questions.length) * 100);

  return (
    <div className="max-w-3xl mx-auto p-4 sm:p-6 space-y-6">
      {/* Header & Progress Bar */}
      <div className="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-3">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
              {mode === 'diagnostic'
                ? 'Mandatory Combined Diagnostic Quiz'
                : 'Targeted Topic Practice & Reassessment Quiz'}
            </span>
            <h2 className="text-lg font-extrabold text-slate-900">
              Question {currentIndex + 1} of {questions.length}
            </h2>
          </div>

          <div className="flex items-center gap-2">
            {mode === 'diagnostic' && onAutoSimulateDiagnostic && currentIndex === 0 && phase === 'answering' && (
              <button
                type="button"
                onClick={onAutoSimulateDiagnostic}
                className="px-3 py-1.5 rounded-xl bg-violet-50 hover:bg-violet-100 text-violet-800 border border-violet-200 text-xs font-bold transition flex items-center gap-1.5"
                title="Instantly populates realistic Class 8 demo answers (1 weak with prerequisite gap, 1 lucky guess, 2 strong) to inspect results immediately"
              >
                <Sparkles className="w-3.5 h-3.5 text-violet-600" />
                Quick-Fill Realistic Demo Diagnostic
              </button>
            )}
            <span className="px-3 py-1 rounded-full bg-blue-50 text-blue-900 font-bold text-xs border border-blue-200">
              {currentQuestion.subject} • Class {currentQuestion.classLevel}
            </span>
          </div>
        </div>

        <div className="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
          <div
            className="h-full bg-gradient-to-r from-blue-900 to-sky-500 transition-all duration-300"
            style={{ width: `${progressPct}%` }}
          />
        </div>

        <div className="flex flex-wrap items-center justify-between text-xs text-slate-500 pt-1">
          <span>
            <strong>Chapter:</strong> {currentQuestion.chapter}
          </span>
          <span>
            <strong>Topic:</strong> {currentQuestion.topicTitle}
          </span>
        </div>
      </div>

      {/* Question Card */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
        <div className="space-y-2">
          <h3 className="text-lg sm:text-xl font-bold text-slate-900 leading-snug">
            {currentQuestion.questionText}
          </h3>
        </div>

        {/* Options */}
        <div className="space-y-3">
          {currentQuestion.options.map((opt, idx) => {
            const isSelected = selectedOption === idx;
            const isCorrectOpt = idx === currentQuestion.correctOptionIndex;
            const locked = phase !== 'answering';

            let styleClass =
              'border-slate-200 bg-white hover:bg-slate-50 text-slate-800';
            if (phase === 'feedback') {
              if (isCorrectOpt) {
                styleClass = 'border-emerald-600 bg-emerald-50/80 text-emerald-950 font-semibold';
              } else if (isSelected && !isCorrectOpt) {
                styleClass = 'border-rose-500 bg-rose-50/80 text-rose-950';
              }
            } else if (isSelected) {
              styleClass = 'border-blue-900 bg-blue-50/70 text-blue-950 font-semibold shadow-sm';
            }

            return (
              <button
                key={opt}
                type="button"
                disabled={locked}
                onClick={() => setSelectedOption(idx)}
                className={`w-full p-4 rounded-xl border-2 text-left transition flex items-center justify-between gap-3 ${styleClass}`}
              >
                <div className="flex items-center gap-3">
                  <span
                    className={`w-7 h-7 rounded-lg flex items-center justify-center text-xs font-extrabold ${
                      isSelected
                        ? 'bg-blue-900 text-white'
                        : 'bg-slate-100 text-slate-700'
                    }`}
                  >
                    {String.fromCharCode(65 + idx)}
                  </span>
                  <span className="text-sm sm:text-base">{opt}</span>
                </div>
                {phase === 'feedback' && isCorrectOpt && (
                  <CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0" />
                )}
                {phase === 'feedback' && isSelected && !isCorrectOpt && (
                  <XCircle className="w-5 h-5 text-rose-600 shrink-0" />
                )}
              </button>
            );
          })}
        </div>

        {/* Confidence Selector & Progressive Hint Button */}
        {phase === 'answering' && (
          <div className="pt-2 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4">
            <div className="flex items-center gap-2">
              <span className="text-xs font-bold text-slate-600">Confidence:</span>
              {(['Low', 'Medium', 'High'] as ConfidenceRating[]).map((level) => (
                <button
                  key={level}
                  type="button"
                  onClick={() => setConfidence(level)}
                  className={`px-3 py-1 rounded-lg text-xs font-bold border transition ${
                    confidence === level
                      ? 'bg-blue-900 text-white border-blue-900'
                      : 'bg-slate-50 text-slate-600 border-slate-200 hover:bg-slate-100'
                  }`}
                >
                  {level}
                </button>
              ))}
            </div>

            <button
              type="button"
              onClick={handleRevealNextHint}
              disabled={revealedHints >= 3}
              className={`inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold border transition ${
                revealedHints >= 3
                  ? 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                  : 'bg-amber-50 hover:bg-amber-100 text-amber-900 border-amber-300'
              }`}
            >
              <Lightbulb className="w-4 h-4 text-amber-600" />
              {revealedHints === 0
                ? 'Need a Hint? (1/3)'
                : revealedHints < 3
                ? `Show Next Hint (${revealedHints + 1}/3)`
                : 'All 3 Hints Shown'}
            </button>
          </div>
        )}

        {/* Progressive Hints Display */}
        {revealedHints > 0 && (
          <div className="space-y-2 bg-amber-50/70 border border-amber-200 rounded-xl p-4">
            <div className="flex items-center justify-between">
              <span className="text-xs font-bold text-amber-900 flex items-center gap-1.5">
                <Lightbulb className="w-4 h-4 text-amber-600" />
                Progressive Guided Hints ({revealedHints} of 3 used)
              </span>
              <span className="text-[11px] text-amber-700">
                Using hints guides your thinking and is not treated as automatic weakness.
              </span>
            </div>
            <div className="space-y-1.5 pt-1">
              {currentQuestion.hints.slice(0, revealedHints).map((hText) => (
                <div
                  key={hText}
                  className="text-xs text-slate-800 bg-white/90 p-2.5 rounded-lg border border-amber-200/80"
                >
                  {hText}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* Optional reasoning box even when answering, or mandatory Lucky-Guess check after a correct selection */}
        {phase === 'answering' && selectedOption !== null && selectedOption !== currentQuestion.correctOptionIndex && (
          <div className="space-y-2 pt-2 border-t border-slate-100">
            <label className="block text-xs font-bold text-slate-700">
              Optional: Share your steps or reasoning (helps detect partial understanding even if your final choice is off)
            </label>
            <textarea
              rows={2}
              value={reasoningText}
              onChange={(e) => setReasoningText(e.target.value)}
              placeholder="Write how you approached this problem..."
              className="w-full px-3.5 py-2 rounded-xl border border-slate-300 text-xs"
            />
          </div>
        )}

        {/* LUCKY-GUESS DETECTION PROMPT AFTER CORRECT SELECTION */}
        {phase === 'reasoning_prompt' && (
          <div className="p-5 rounded-2xl bg-blue-50/90 border-2 border-blue-900 space-y-4">
            <div className="flex items-start justify-between gap-3">
              <div>
                <span className="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-100 text-emerald-800">
                  Option {String.fromCharCode(65 + (selectedOption ?? 0))} Selected • Let&rsquo;s Verify Mastery
                </span>
                <h4 className="text-base font-extrabold text-blue-950 mt-1.5">
                  &ldquo;Can you explain why this answer is correct?&rdquo;
                </h4>
                <p className="text-xs text-slate-700 mt-0.5">
                  StudyVerse checks your reasoning so a lucky guess isn&rsquo;t mistaken for deep mastery. Explain the rule, formula, or step you used in 1–2 sentences:
                </p>
              </div>
            </div>

            <textarea
              rows={3}
              value={reasoningText}
              onChange={(e) => setReasoningText(e.target.value)}
              placeholder="Explain the concept, formula, or steps that make this option correct..."
              className="w-full px-4 py-2.5 rounded-xl border border-blue-300 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-blue-900"
            />

            {/* Quick-Fill Demo Helpers for Fast Testing */}
            <div className="flex flex-wrap items-center gap-2 text-xs">
              <span className="text-slate-500 font-semibold">Quick Demo Fill:</span>
              <button
                type="button"
                onClick={() => setReasoningText(currentQuestion.sampleStrongReasoning)}
                className="px-2.5 py-1 rounded-lg bg-emerald-100 hover:bg-emerald-200 text-emerald-900 font-semibold transition"
              >
                + Fill Strong Conceptual Explanation
              </button>
              <button
                type="button"
                onClick={() => setReasoningText(currentQuestion.sampleWeakReasoning)}
                className="px-2.5 py-1 rounded-lg bg-amber-100 hover:bg-amber-200 text-amber-900 font-semibold transition"
              >
                + Fill Lucky Guess / Vague Explanation
              </button>
            </div>

            <div className="flex justify-end">
              <button
                type="button"
                onClick={() => finalizeQuestionAttempt(reasoningText)}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition"
              >
                Evaluate Answer &amp; Reasoning
                <ArrowRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        )}

        {/* COMPLETE TEACHING EXPLANATION (Shown after submission) */}
        {phase === 'feedback' && currentAttempt && (
          <div className="space-y-4 pt-2 border-t border-slate-200">
            {/* Evaluation Badge */}
            <div
              className={`p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${
                currentAttempt.isCorrect && currentAttempt.reasoningQuality === 'strong'
                  ? 'bg-emerald-50 border-emerald-200 text-emerald-950'
                  : currentAttempt.isCorrect && currentAttempt.reasoningQuality === 'weak_or_missing'
                  ? 'bg-amber-50 border-amber-300 text-amber-950'
                  : 'bg-rose-50 border-rose-200 text-rose-950'
              }`}
            >
              <div className="space-y-1">
                <div className="text-xs font-extrabold uppercase tracking-wider">
                   Independent Answer &amp; Reasoning Assessment
                </div>
                <div className="text-sm font-bold">{currentAttempt.interpretationLabel}</div>
                {currentAttempt.reasoningText && (
                  <p className="text-xs opacity-85 italic">
                    Your reasoning: &ldquo;{currentAttempt.reasoningText}&rdquo;
                  </p>
                )}
              </div>
              <div className="shrink-0 text-right">
                <span className="inline-block px-3 py-1 rounded-full text-xs font-bold bg-white/80 border border-current/20">
                  Confidence: {currentAttempt.confidenceRating} • Hints: {currentAttempt.hintCount}
                </span>
              </div>
            </div>

            {/* Complete Teaching Explanation Card */}
            <div className="bg-slate-50 rounded-2xl border border-slate-200 p-5 space-y-3 text-xs sm:text-sm">
              <h4 className="font-extrabold text-slate-900 flex items-center gap-2 text-sm">
                <BookOpen className="w-4 h-4 text-blue-900" />
                Complete Concept &amp; Answer Explanation
              </h4>

              <div className="space-y-1">
                <span className="font-bold text-emerald-800">Why the Correct Answer is Right:</span>
                <p className="text-slate-700 leading-relaxed">
                  {currentQuestion.explanation.whyCorrect}
                </p>
              </div>

              <div className="space-y-1">
                <span className="font-bold text-rose-800">Why Other Options Fail (Common Misconceptions):</span>
                <p className="text-slate-700 leading-relaxed">
                  {currentQuestion.explanation.whyWrongOptionsFail}
                </p>
              </div>

              <div className="p-3 rounded-xl bg-blue-50 border border-blue-200 text-blue-950">
                <span className="font-bold">Relevant NCERT Rule / Formula: </span>
                <span className="font-mono">{currentQuestion.explanation.coreConceptOrFormula}</span>
              </div>

              <div className="space-y-1">
                <span className="font-bold text-slate-800">Simple Worked Example:</span>
                <p className="text-slate-700">{currentQuestion.explanation.simpleExample}</p>
              </div>
            </div>

            <div className="flex justify-end">
              <button
                type="button"
                onClick={handleNextQuestion}
                className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 transition shadow"
              >
                {currentIndex + 1 < questions.length
                  ? 'Next Question'
                  : mode === 'diagnostic'
                  ? 'View Diagnostic Results & Weakness Analysis'
                  : 'Complete Practice & Update Recommendations'}
                <ArrowRight className="w-4 h-4" />
              </button>
            </div>
          </div>
        )}

        {/* Submit Answer Button during answering phase */}
        {phase === 'answering' && (
          <div className="flex justify-end pt-2">
            <button
              type="button"
              disabled={selectedOption === null}
              onClick={handleInitialSubmit}
              className={`inline-flex items-center gap-2 px-6 py-3 rounded-xl font-bold text-sm transition ${
                selectedOption === null
                  ? 'bg-slate-200 text-slate-400 cursor-not-allowed'
                  : 'bg-blue-900 text-white hover:bg-blue-800 shadow-md'
              }`}
            >
              Submit Answer
              <ArrowRight className="w-4 h-4" />
            </button>
          </div>
        )}
      </div>
    </div>
  );
};

interface DiagnosticResultsProps {
  attempts: QuizAttempt[];
  topics: Topic[];
  masteryMap: Record<string, TopicMastery>;
  onOpenFoundationLesson: (prereqTopicId: string, returnTopicId: string) => void;
  onGoToDashboard: () => void;
  onGoToLearningGaps: () => void;
}

const DiagnosticResultsView: React.FC<DiagnosticResultsProps> = ({
  attempts,
  topics,
  masteryMap,
  onOpenFoundationLesson,
  onGoToDashboard,
  onGoToLearningGaps,
}) => {
  const topicMap: Record<string, Topic> = {};
  topics.forEach((t) => {
    topicMap[t.id] = t;
  });

  const correctCount = attempts.filter((a) => a.isCorrect).length;
  const overallAccuracy = attempts.length > 0 ? Math.round((correctCount / attempts.length) * 100) : 0;

  // Group by subject
  const subjectStats: Record<string, { total: number; correct: number; avgMastery: number }> = {};
  attempts.forEach((a) => {
    if (!subjectStats[a.subject]) {
      subjectStats[a.subject] = { total: 0, correct: 0, avgMastery: 0 };
    }
    subjectStats[a.subject].total += 1;
    if (a.isCorrect) subjectStats[a.subject].correct += 1;
  });

  const assessedTopics = Object.values(masteryMap).filter((m) => m.evidenceCount > 0);
  const weakTopics = assessedTopics.filter((m) => m.status === 'weak');
  const uncertainTopics = assessedTopics.filter((m) => m.status === 'uncertain');
  const strongTopics = assessedTopics.filter((m) => m.status === 'strong');

  return (
    <div className="max-w-5xl mx-auto p-4 sm:p-6 space-y-6">
      {/* Top Banner */}
      <div className="bg-gradient-to-r from-blue-900 via-blue-800 to-indigo-900 rounded-2xl p-6 sm:p-8 text-white shadow-lg space-y-4">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <span className="px-3 py-1 rounded-full bg-sky-400/20 text-sky-200 border border-sky-400/30 text-xs font-bold">
            Preliminary Diagnostic Assessment • Evidence-Based Report
          </span>
          <span className="text-xs text-blue-200">
            Note: Results from small question samples are labeled as preliminary and refine as you practice.
          </span>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-4 gap-4 pt-2">
          <div className="bg-white/10 rounded-xl p-4 border border-white/15">
            <div className="text-xs text-blue-200">MCQ Accuracy</div>
            <div className="text-3xl font-extrabold mt-1">{overallAccuracy}%</div>
            <div className="text-[11px] text-sky-200 mt-1">
              {correctCount} of {attempts.length} correct
            </div>
          </div>
          <div className="bg-white/10 rounded-xl p-4 border border-white/15">
            <div className="text-xs text-blue-200">Demonstrated Strengths</div>
            <div className="text-3xl font-extrabold text-emerald-300 mt-1">
              {strongTopics.length}
            </div>
            <div className="text-[11px] text-blue-200 mt-1">Correct + Strong Reasoning</div>
          </div>
          <div className="bg-white/10 rounded-xl p-4 border border-white/15">
            <div className="text-xs text-blue-200">Uncertain Mastery</div>
            <div className="text-3xl font-extrabold text-amber-300 mt-1">
              {uncertainTopics.length}
            </div>
            <div className="text-[11px] text-blue-200 mt-1">Lucky Guess / Weak Reasoning</div>
          </div>
          <div className="bg-white/10 rounded-xl p-4 border border-white/15">
            <div className="text-xs text-blue-200">Weak Topics &amp; Gaps</div>
            <div className="text-3xl font-extrabold text-rose-300 mt-1">
              {weakTopics.length}
            </div>
            <div className="text-[11px] text-blue-200 mt-1">Needs Prerequisite Bridge</div>
          </div>
        </div>
      </div>

      {/* Subject-Wise Breakdown */}
      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
        {Object.entries(subjectStats).map(([subj, st]) => {
          const pct = Math.round((st.correct / st.total) * 100);
          return (
            <div
              key={subj}
              className="bg-white rounded-2xl p-5 border border-slate-200 shadow-sm flex items-center justify-between"
            >
              <div>
                <span className="text-xs font-bold uppercase tracking-wider text-slate-500">
                  Subject Performance
                </span>
                <h3 className="text-lg font-extrabold text-slate-900">{subj}</h3>
                <p className="text-xs text-slate-600 mt-0.5">
                  {st.correct} of {st.total} questions answered correctly
                </p>
              </div>
              <div className="text-right">
                <div className="text-2xl font-extrabold text-blue-900">{pct}%</div>
                <span className="text-[11px] font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600">
                  Preliminary Sample
                </span>
              </div>
            </div>
          );
        })}
      </div>

      {/* Topic-by-Topic Evidence & Prerequisite Recommendations */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <div className="flex items-center justify-between">
          <div>
            <h3 className="text-lg font-extrabold text-slate-900">
              Topic-Wise Performance, Evidence &amp; Prerequisite Gaps
            </h3>
            <p className="text-xs text-slate-600">
              See why each topic was classified as Strong, Uncertain, or Weak based on your answer and reasoning.
            </p>
          </div>
        </div>

        <div className="space-y-4">
          {assessedTopics.map((m) => {
            const t = topicMap[m.topicId];
            if (!t) return null;
            const prereq =
              m.prerequisiteGapIds.length > 0 ? topicMap[m.prerequisiteGapIds[0]] : null;

            return (
              <div
                key={m.topicId}
                className="p-5 rounded-2xl border border-slate-200 bg-slate-50/60 space-y-3"
              >
                <div className="flex flex-wrap items-center justify-between gap-2">
                  <div>
                    <span className="text-xs font-bold text-sky-700">
                      {t.subject} • {t.chapter}
                    </span>
                    <h4 className="text-base font-extrabold text-slate-900">{t.title}</h4>
                  </div>

                  <div className="flex items-center gap-2">
                    <span className="text-xs font-semibold text-slate-500">
                      {m.masteryConfidence}
                    </span>
                    <span
                      className={`px-3 py-1 rounded-full text-xs font-bold ${
                        m.status === 'strong'
                          ? 'bg-emerald-100 text-emerald-800'
                          : m.status === 'uncertain'
                          ? 'bg-amber-100 text-amber-900'
                          : 'bg-rose-100 text-rose-800'
                      }`}
                    >
                      {m.status === 'strong'
                        ? `Demonstrated Strength (${m.performanceScore}%)`
                        : m.status === 'uncertain'
                        ? `Uncertain Understanding (${m.performanceScore}%)`
                        : `Weak Topic (${m.performanceScore}%)`}
                    </span>
                  </div>
                </div>

                <p className="text-xs text-slate-700">
                  <strong>Supporting Evidence: </strong>
                  {m.observedErrors.length > 0
                    ? m.observedErrors.join(' ')
                    : 'Answered correctly and explained the underlying concept clearly.'}
                </p>

                {prereq && (
                  <div className="p-4 rounded-xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div className="space-y-1">
                      <div className="text-xs font-extrabold text-amber-950 flex items-center gap-1.5">
                        <Layers className="w-4 h-4 text-amber-700" />
                        &ldquo;Let&rsquo;s strengthen your basics first.&rdquo; — Prerequisite Gap Identified
                      </div>
                      <p className="text-xs text-amber-900">
                        <strong>Missing Foundation:</strong> {prereq.title} ({prereq.chapter} •{' '}
                        {prereq.estimatedMinutes} mins). {prereq.whyPrerequisiteMatters}
                      </p>
                    </div>
                    <button
                      type="button"
                      onClick={() => onOpenFoundationLesson(prereq.id, t.id)}
                      className="shrink-0 px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs transition"
                    >
                      Start Class {prereq.classLevel} Foundation Lesson →
                    </button>
                  </div>
                )}
              </div>
            );
          })}
        </div>

        <div className="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-200">
          <button
            type="button"
            onClick={onGoToLearningGaps}
            className="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold text-sm hover:bg-slate-100 transition"
          >
            Inspect Detailed Learning Gaps
          </button>
          <button
            type="button"
            onClick={onGoToDashboard}
            className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 text-white font-bold text-sm hover:bg-blue-800 shadow-md transition"
          >
            Open Personalized Dashboard &amp; Study Plan
            <ArrowRight className="w-4 h-4" />
          </button>
        </div>
      </div>
    </div>
  );
};

// ==========================================
// MODULE: components/LearningAndGaps.tsx
// ==========================================
interface LearningGapsViewProps {
  topics: Topic[];
  masteryMap: Record<string, TopicMastery>;
  attempts: QuizAttempt[];
  onOpenFoundationLesson: (prereqTopicId: string, returnTopicId: string) => void;
  onStartTopicLesson: (topicId: string) => void;
  onStartTargetedQuiz: (topicId: string) => void;
}

const LearningGapsView: React.FC<LearningGapsViewProps> = ({
  topics,
  masteryMap,
  attempts,
  onOpenFoundationLesson,
  onStartTopicLesson,
  onStartTargetedQuiz,
}) => {
  const topicLookup: Record<string, Topic> = {};
  topics.forEach((t) => {
    topicLookup[t.id] = t;
  });

  const coreTopics = topics.filter((t) => !t.isFoundationTopic);
  const weakList = coreTopics.filter((t) => masteryMap[t.id]?.status === 'weak');
  const uncertainList = coreTopics.filter((t) => masteryMap[t.id]?.status === 'uncertain');
  const strongList = coreTopics.filter((t) => masteryMap[t.id]?.status === 'strong');

  return (
    <div className="space-y-6">
      {/* Header Banner */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div className="space-y-1">
          <span className="text-xs font-bold uppercase tracking-wider text-violet-600">
            Explainable Weakness Detection
          </span>
          <h2 className="text-2xl font-extrabold text-slate-900">
            My Learning Gaps &amp; Mastery Evidence
          </h2>
          <p className="text-sm text-slate-600 max-w-2xl">
            StudyVerse never labels a topic weak without showing the exact evidence, reasoning quality, prerequisite links, and reassessment path.
          </p>
        </div>
        <div className="flex items-center gap-3 text-xs font-bold">
          <span className="px-3 py-1.5 rounded-xl bg-rose-50 text-rose-800 border border-rose-200">
            {weakList.length} Weak
          </span>
          <span className="px-3 py-1.5 rounded-xl bg-amber-50 text-amber-900 border border-amber-200">
            {uncertainList.length} Uncertain
          </span>
          <span className="px-3 py-1.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200">
            {strongList.length} Strong
          </span>
        </div>
      </div>

      {/* 6-Question Explainable Weakness & Uncertain Mastery Cards */}
      <div className="space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">
          Priority Attention &amp; Uncertain Mastery Cards (6-Point Evidence Breakdown)
        </h3>

        {[...weakList, ...uncertainList].length === 0 ? (
          <div className="p-8 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-center space-y-2">
            <CheckCircle2 className="w-8 h-8 text-emerald-600 mx-auto" />
            <h4 className="text-base font-bold text-emerald-950">
              All Assessed Core Topics Show Strong Understanding!
            </h4>
            <p className="text-xs text-emerald-800">
              Take another targeted quiz or explore new chapters in the Learn tab to keep challenging yourself.
            </p>
          </div>
        ) : (
          [...weakList, ...uncertainList].map((topic) => {
            const m = masteryMap[topic.id];
            const isWeak = m.status === 'weak';
            const prereqId = m.prerequisiteGapIds[0];
            const prereq = prereqId ? topicLookup[prereqId] : null;
            const topicAttempts = attempts.filter((a) => a.topicId === topic.id);
            const latestAtt = topicAttempts[topicAttempts.length - 1];

            return (
              <div
                key={topic.id}
                className={`rounded-2xl border-2 p-6 bg-white shadow-sm space-y-5 ${
                  isWeak ? 'border-rose-200' : 'border-amber-200'
                }`}
              >
                <div className="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 pb-4">
                  <div>
                    <div className="flex items-center gap-2">
                      <span
                        className={`px-2.5 py-0.5 rounded-full text-xs font-extrabold ${
                          isWeak
                            ? 'bg-rose-100 text-rose-800'
                            : 'bg-amber-100 text-amber-900'
                        }`}
                      >
                        {isWeak ? 'Weak Topic Identified' : 'Uncertain Understanding (Verify Reasoning)'}
                      </span>
                      <span className="text-xs font-semibold text-slate-500">
                        {topic.subject} • {topic.chapter}
                      </span>
                    </div>
                    <h4 className="text-xl font-extrabold text-slate-900 mt-1">
                      Why is &ldquo;{topic.title}&rdquo; recommended?
                    </h4>
                  </div>

                  <div className="text-right">
                    <div className="text-2xl font-extrabold text-slate-900">
                      {m.performanceScore}%
                    </div>
                    <div className="text-[11px] font-semibold text-slate-500">
                      {m.masteryConfidence}
                    </div>
                  </div>
                </div>

                {/* 6 Required Explainable Questions Grid */}
                <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 text-xs">
                  <div className="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div className="font-extrabold text-slate-900">
                      1. What topic needs attention?
                    </div>
                    <p className="text-slate-700 leading-relaxed">
                      <strong>{topic.title}</strong> ({topic.chapter}, Class {topic.classLevel}{' '}
                      {topic.subject}).
                    </p>
                  </div>

                  <div className="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div className="font-extrabold text-slate-900">
                      2. What evidence supports this finding?
                    </div>
                    <p className="text-slate-700 leading-relaxed">
                      Based on {m.evidenceCount} quiz observation(s) ({m.masteryConfidence}). Latest confidence:{' '}
                      <strong>{latestAtt?.confidenceRating || 'Medium'}</strong>, Hints used:{' '}
                      <strong>{latestAtt?.hintCount ?? 0}</strong>.
                    </p>
                  </div>

                  <div className="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-1">
                    <div className="font-extrabold text-slate-900">
                      3. Which errors or misconceptions were observed?
                    </div>
                    <p className="text-slate-700 leading-relaxed">
                      {m.observedErrors.length > 0
                        ? m.observedErrors.join(' ')
                        : 'Selected the right answer but reasoning did not cite the core rule or formula.'}
                    </p>
                  </div>

                  <div className="p-3.5 rounded-xl bg-amber-50/70 border border-amber-200 space-y-1">
                    <div className="font-extrabold text-amber-950">
                      4. Is a prerequisite missing?
                    </div>
                    <p className="text-amber-900 leading-relaxed">
                      {prereq ? (
                        <>
                          Yes — relies on <strong>Class {prereq.classLevel}: {prereq.title}</strong> ({prereq.chapter}).
                        </>
                      ) : m.foundationCompleted ? (
                        'Earlier-class foundation lesson completed! Ready for Class 8 practice.'
                      ) : (
                        'No earlier-class prerequisite gap flagged; focus on Class 8 concept application.'
                      )}
                    </p>
                  </div>

                  <div className="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200 space-y-1">
                    <div className="font-extrabold text-blue-950">
                      5. What should the student do next?
                    </div>
                    <p className="text-blue-900 leading-relaxed">
                      {prereq
                        ? `Complete the ${prereq.estimatedMinutes}-minute Class ${prereq.classLevel} Foundation Bridge on "${prereq.title}", then return to ${topic.title}.`
                        : `Review the NCERT worked example for ${topic.title} and complete a 2-question targeted quiz.`}
                    </p>
                  </div>

                  <div className="p-3.5 rounded-xl bg-emerald-50/70 border border-emerald-200 space-y-1">
                    <div className="font-extrabold text-emerald-950">
                      6. How will the system reassess progress?
                    </div>
                    <p className="text-emerald-900 leading-relaxed">
                      A targeted practice quiz will evaluate both your multiple-choice accuracy and your written explanation before updating mastery.
                    </p>
                  </div>
                </div>

                {/* Action Bar */}
                <div className="flex flex-wrap items-center justify-between gap-3 pt-2">
                  <div className="text-xs text-slate-500">
                    {m.evidenceCount === 1 && (
                      <span>
                        ℹ️ <strong>Uncertainty Note:</strong> Assessed from 1 question sample so far; complete a practice quiz to confirm.
                      </span>
                    )}
                  </div>
                  <div className="flex flex-wrap items-center gap-2.5">
                    {prereq && (
                      <button
                        type="button"
                        onClick={() => onOpenFoundationLesson(prereq.id, topic.id)}
                        className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow-sm transition"
                      >
                        <Layers className="w-4 h-4" />
                        Start Class {prereq.classLevel} Foundation Lesson ({prereq.estimatedMinutes}m)
                      </button>
                    )}
                    <button
                      type="button"
                      onClick={() => onStartTopicLesson(topic.id)}
                      className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition"
                    >
                      <BookOpen className="w-4 h-4" />
                      Study Class {topic.classLevel} Lesson
                    </button>
                    <button
                      type="button"
                      onClick={() => onStartTargetedQuiz(topic.id)}
                      className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs shadow-sm transition"
                    >
                      <Play className="w-3.5 h-3.5" />
                      Take Targeted Reassessment Quiz
                    </button>
                  </div>
                </div>
              </div>
            );
          })
        )}
      </div>

      {/* Strong Topics Section */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900 flex items-center gap-2">
          <CheckCircle2 className="w-5 h-5 text-emerald-600" />
          Demonstrated Strengths ({strongList.length})
        </h3>
        {strongList.length === 0 ? (
          <p className="text-xs text-slate-500">
            Complete diagnostic or targeted practice quizzes with clear reasoning to build verified strengths.
          </p>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {strongList.map((topic) => {
              const m = masteryMap[topic.id];
              return (
                <div
                  key={topic.id}
                  className="p-4 rounded-xl border border-emerald-200 bg-emerald-50/40 flex items-center justify-between gap-3"
                >
                  <div>
                    <span className="text-[11px] font-bold text-emerald-800">
                      {topic.subject} • {topic.chapter}
                    </span>
                    <h4 className="text-sm font-extrabold text-slate-900">{topic.title}</h4>
                    <p className="text-xs text-slate-600 mt-0.5">
                      Verified across {m.evidenceCount} observation(s) • Score: {m.performanceScore}%
                    </p>
                  </div>
                  <button
                    type="button"
                    onClick={() => onStartTargetedQuiz(topic.id)}
                    className="px-3 py-1.5 rounded-lg bg-white border border-emerald-300 text-emerald-900 text-xs font-bold hover:bg-emerald-100 transition"
                  >
                    Practice Again
                  </button>
                </div>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
};

interface LearnTopicViewProps {
  topics: Topic[];
  activeTopicId: string;
  returnToTopicId: string | null;
  masteryMap: Record<string, TopicMastery>;
  onSelectTopic: (topicId: string) => void;
  onOpenFoundationLesson: (prereqTopicId: string, returnTopicId: string) => void;
  onCompleteFoundationLesson: (foundationTopicId: string, parentTopicId: string | null) => void;
  onStartTargetedQuiz: (topicId: string) => void;
  onOpenDoubtWithContext: (subject: Topic['subject'], topicTitle: string, chapter: string) => void;
}

const LearnTopicView: React.FC<LearnTopicViewProps> = ({
  topics,
  activeTopicId,
  returnToTopicId,
  masteryMap,
  onSelectTopic,
  onOpenFoundationLesson,
  onCompleteFoundationLesson,
  onStartTargetedQuiz,
  onOpenDoubtWithContext,
}) => {
  const [quickCheckSelected, setQuickCheckSelected] = useState<number | null>(null);
  const [skippedRemedial, setSkippedRemedial] = useState<boolean>(false);

  const topicLookup: Record<string, Topic> = {};
  topics.forEach((t) => {
    topicLookup[t.id] = t;
  });

  const currentTopic = topicLookup[activeTopicId] || topics[0];
  const currentMastery = masteryMap[currentTopic.id];
  const parentTopic = returnToTopicId ? topicLookup[returnToTopicId] : null;

  // Check if current topic has an active prerequisite gap
  const activePrereqId =
    !skippedRemedial &&
    currentMastery?.prerequisiteGapIds &&
    currentMastery.prerequisiteGapIds.length > 0
      ? currentMastery.prerequisiteGapIds[0]
      : null;
  const activePrereqTopic = activePrereqId ? topicLookup[activePrereqId] : null;

  return (
    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {/* Left Topic & Prerequisite Graph Selector */}
      <div className="lg:col-span-4 space-y-4">
        <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
          <h3 className="text-sm font-extrabold text-slate-900 uppercase tracking-wider">
            Class 8 Core Topics (NCERT)
          </h3>
          <div className="space-y-2">
            {topics
              .filter((t) => !t.isFoundationTopic)
              .map((t) => {
                const m = masteryMap[t.id];
                const isSelected = t.id === currentTopic.id;
                return (
                  <button
                    key={t.id}
                    type="button"
                    onClick={() => {
                      setQuickCheckSelected(null);
                      setSkippedRemedial(false);
                      onSelectTopic(t.id);
                    }}
                    className={`w-full p-3 rounded-xl border text-left transition flex items-center justify-between gap-2 ${
                      isSelected
                        ? 'bg-blue-900 text-white border-blue-900 shadow-sm'
                        : 'bg-slate-50 hover:bg-slate-100 text-slate-800 border-slate-200'
                    }`}
                  >
                    <div className="min-w-0">
                      <div
                        className={`text-[10px] font-bold uppercase ${
                          isSelected ? 'text-sky-200' : 'text-slate-500'
                        }`}
                      >
                        {t.subject} • Class {t.classLevel}
                      </div>
                      <div className="text-xs font-bold truncate">{t.title}</div>
                    </div>
                    {m && m.evidenceCount > 0 && (
                      <span
                        className={`shrink-0 px-2 py-0.5 rounded text-[10px] font-bold ${
                          isSelected
                            ? 'bg-white/20 text-white'
                            : m.status === 'strong'
                            ? 'bg-emerald-100 text-emerald-800'
                            : m.status === 'uncertain'
                            ? 'bg-amber-100 text-amber-900'
                            : 'bg-rose-100 text-rose-800'
                        }`}
                      >
                        {m.performanceScore}%
                      </span>
                    )}
                  </button>
                );
              })}
          </div>
        </div>

        {/* Earlier-Class Prerequisite Bridge Topics */}
        <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
          <div className="flex items-center justify-between">
            <h3 className="text-sm font-extrabold text-amber-900 uppercase tracking-wider flex items-center gap-1.5">
              <Layers className="w-4 h-4 text-amber-600" />
              Class 6 &amp; 7 Foundation Bridges
            </h3>
          </div>
          <p className="text-xs text-slate-600">
            Explore foundational lessons from earlier classes linked to Class 8 chapters:
          </p>
          <div className="space-y-2">
            {topics
              .filter((t) => t.isFoundationTopic)
              .map((t) => {
                const isSelected = t.id === currentTopic.id;
                const done = masteryMap[t.id]?.foundationCompleted;
                return (
                  <button
                    key={t.id}
                    type="button"
                    onClick={() => {
                      setQuickCheckSelected(null);
                      onSelectTopic(t.id);
                    }}
                    className={`w-full p-3 rounded-xl border text-left transition flex items-center justify-between gap-2 ${
                      isSelected
                        ? 'bg-amber-600 text-white border-amber-600 shadow-sm'
                        : 'bg-amber-50/50 hover:bg-amber-50 text-slate-800 border-amber-200'
                    }`}
                  >
                    <div className="min-w-0">
                      <div
                        className={`text-[10px] font-bold uppercase ${
                          isSelected ? 'text-amber-100' : 'text-amber-800'
                        }`}
                      >
                        Class {t.classLevel} Prerequisite • {t.subject}
                      </div>
                      <div className="text-xs font-bold truncate">{t.title}</div>
                    </div>
                    {done && (
                      <CheckCircle2
                        className={`w-4 h-4 shrink-0 ${
                          isSelected ? 'text-white' : 'text-emerald-600'
                        }`}
                      />
                    )}
                  </button>
                );
              })}
          </div>
        </div>
      </div>

      {/* Right Active Lesson Content */}
      <div className="lg:col-span-8 space-y-6">
        {/* PREREQUISITE GAP BANNER WHEN VIEWING A WEAK CLASS 8 TOPIC */}
        {activePrereqTopic && (
          <div className="rounded-2xl bg-gradient-to-r from-amber-50 via-orange-50 to-amber-50 border-2 border-amber-300 p-6 shadow-sm space-y-4">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <span className="px-3 py-1 rounded-full bg-amber-200/80 text-amber-950 text-xs font-extrabold flex items-center gap-1.5">
                <Layers className="w-4 h-4" />
                Prerequisite-Aware Learning Recommendation
              </span>
              <span className="text-xs font-bold text-amber-900">
                Estimated Time: {activePrereqTopic.estimatedMinutes} minutes
              </span>
            </div>

            <div className="space-y-1.5">
              <h3 className="text-xl font-extrabold text-slate-900">
                &ldquo;Let&rsquo;s strengthen your basics first.&rdquo;
              </h3>
              <p className="text-sm text-slate-700 leading-relaxed">
                Before diving deeper into <strong>{currentTopic.title}</strong>, StudyVerse detected a gap in the foundational concept{' '}
                <strong className="text-amber-950">
                  {activePrereqTopic.title} ({activePrereqTopic.chapter})
                </strong>
                .
              </p>
              <p className="text-xs text-slate-600">
                <strong>Why it matters:</strong> {activePrereqTopic.whyPrerequisiteMatters}
              </p>
            </div>

            <div className="flex flex-wrap items-center gap-3 pt-1">
              <button
                type="button"
                onClick={() => onOpenFoundationLesson(activePrereqTopic.id, currentTopic.id)}
                className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-bold text-xs shadow transition"
              >
                Start Foundation Lesson (Class {activePrereqTopic.classLevel})
                <ArrowRight className="w-4 h-4" />
              </button>
              <button
                type="button"
                onClick={() => setSkippedRemedial(true)}
                className="px-4 py-2.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 border border-slate-300 font-semibold text-xs transition"
              >
                I Already Know This — Continue Current Topic
              </button>
            </div>
          </div>
        )}

        {/* IF VIEWING A CLASS 6/7 FOUNDATION LESSON, SHOW RETURN TO ORIGINAL TOPIC HEADER */}
        {currentTopic.isFoundationTopic && (
          <div className="rounded-2xl bg-amber-600 text-white p-5 shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div className="space-y-1">
              <span className="text-xs font-extrabold uppercase tracking-wider text-amber-100">
                Earlier-Class Foundation Bridge • Class {currentTopic.classLevel} {currentTopic.subject}
              </span>
              <h3 className="text-lg font-extrabold">
                Strengthening Basics: {currentTopic.title}
              </h3>
              <p className="text-xs text-amber-100">
                {parentTopic
                  ? `Completing this foundation lesson unlocks confident mastery in Class ${parentTopic.classLevel}: ${parentTopic.title}.`
                  : currentTopic.whyPrerequisiteMatters}
              </p>
            </div>
            {parentTopic && (
              <button
                type="button"
                onClick={() => onSelectTopic(parentTopic.id)}
                className="shrink-0 inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-amber-900 font-bold text-xs hover:bg-amber-50 transition"
              >
                <ArrowLeft className="w-3.5 h-3.5" />
                Return to {parentTopic.title}
              </button>
            )}
          </div>
        )}

        {/* Main Textbook Lesson Card */}
        <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-6">
          <div className="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <div className="flex items-center gap-2">
                <span className="px-2.5 py-0.5 rounded-full bg-blue-50 text-blue-900 font-bold text-xs border border-blue-200">
                  Class {currentTopic.classLevel} • {currentTopic.subject}
                </span>
                <span className="text-xs text-slate-500 font-semibold">
                  {currentTopic.ncertReference.bookTitle} ({currentTopic.ncertReference.pageRange})
                </span>
              </div>
              <h2 className="text-2xl font-extrabold text-slate-900 mt-1.5">
                {currentTopic.title}
              </h2>
              <p className="text-xs text-slate-500 mt-0.5">{currentTopic.chapter}</p>
            </div>

            <button
              type="button"
              onClick={() =>
                onOpenDoubtWithContext(
                  currentTopic.subject,
                  currentTopic.title,
                  currentTopic.chapter
                )
              }
              className="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-sky-50 hover:bg-sky-100 text-sky-900 border border-sky-200 font-bold text-xs transition"
            >
              <MessageSquarePlus className="w-4 h-4 text-sky-600" />
              Ask a Doubt on This Chapter
            </button>
          </div>

          {/* Learning Objectives */}
          <div className="space-y-2">
            <h4 className="text-xs font-extrabold uppercase tracking-wider text-slate-500">
              Learning Objectives
            </h4>
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-2">
              {currentTopic.learningObjectives.map((obj) => (
                <div
                  key={obj}
                  className="p-3 rounded-xl bg-slate-50 border border-slate-200/80 flex items-start gap-2 text-xs text-slate-700"
                >
                  <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" />
                  <span>{obj}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Core NCERT Concept Summary */}
          <div className="space-y-2">
            <h4 className="text-sm font-extrabold text-slate-900">
              Textbook Concept Explanation
            </h4>
            <p className="text-sm text-slate-700 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-200">
              {currentTopic.lessonSummary}
            </p>
          </div>

          {/* Key Rules / Formulas */}
          <div className="space-y-2">
            <h4 className="text-sm font-extrabold text-slate-900">
              Key Rules, Principles &amp; Formulas
            </h4>
            <div className="space-y-2">
              {currentTopic.keyFormulasOrRules.map((rule) => (
                <div
                  key={rule}
                  className="p-3.5 rounded-xl bg-blue-50/70 border border-blue-200 font-mono text-xs text-blue-950 font-semibold"
                >
                  {rule}
                </div>
              ))}
            </div>
          </div>

          {/* Step-by-Step Worked Example */}
          <div className="p-5 rounded-2xl bg-slate-900 text-white space-y-3">
            <div className="text-xs font-bold uppercase tracking-wider text-sky-300">
              Worked NCERT Example
            </div>
            <div className="text-sm font-bold">{currentTopic.workedExample.problem}</div>
            <ol className="space-y-1.5 text-xs text-slate-200 list-decimal list-inside">
              {currentTopic.workedExample.steps.map((s) => (
                <li key={s} className="leading-relaxed">
                  {s}
                </li>
              ))}
            </ol>
            <div className="pt-2 border-t border-slate-700 text-xs text-emerald-300 font-semibold">
              Takeaway: {currentTopic.workedExample.conclusion}
            </div>
          </div>

          {/* Interactive Foundation Concept Check & Completion Action */}
          <div className="pt-4 border-t border-slate-200 flex flex-wrap items-center justify-between gap-4">
            {currentTopic.isFoundationTopic ? (
              <div className="w-full flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-emerald-50 border border-emerald-200 p-4 rounded-xl">
                <div className="space-y-1">
                  <div className="text-xs font-extrabold text-emerald-950">
                    Ready to Apply This Foundation?
                  </div>
                  <p className="text-xs text-emerald-800">
                    Mark this Class {currentTopic.classLevel} foundation lesson complete to resolve your prerequisite gap and return to your Class 8 topic.
                  </p>
                </div>
                <button
                  type="button"
                  onClick={() =>
                    onCompleteFoundationLesson(
                      currentTopic.id,
                      parentTopic ? parentTopic.id : 'math-8-linear-eq'
                    )
                  }
                  className="shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs shadow transition"
                >
                  <CheckCircle2 className="w-4 h-4" />
                  Complete Foundation Lesson &amp; Return to Original Topic
                </button>
              </div>
            ) : (
              <>
                <div className="text-xs text-slate-600">
                  Finished reviewing <strong>{currentTopic.title}</strong>? Take a targeted quiz to update your mastery and study plan.
                </div>
                <button
                  type="button"
                  onClick={() => onStartTargetedQuiz(currentTopic.id)}
                  className="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-sm shadow-md transition"
                >
                  <Play className="w-4 h-4" />
                  Take Targeted Practice Quiz on {currentTopic.title}
                </button>
              </>
            )}
          </div>
        </div>
      </div>
    </div>
  );
};

// ==========================================
// MODULE: components/TutorPlannerResources.tsx
// ==========================================
interface ChatTurn {
  id: string;
  role: 'user' | 'tutor';
  text: string;
  citations?: TextbookPassage[];
  grounded?: boolean;
  followUps?: string[];
}

interface AITutorViewProps {
  student: Student;
  topics: Topic[];
  passages: TextbookPassage[];
  onStartTargetedQuiz: (topicId: string) => void;
}

const AITutorView: React.FC<AITutorViewProps> = ({
  student,
  topics,
  passages,
  onStartTargetedQuiz,
}) => {
  const [selectedClass, setSelectedClass] = useState<ClassLevel>(student.classLevel);
  const [selectedSubject, setSelectedSubject] = useState<SubjectName>('Mathematics');
  const [selectedTopicId, setSelectedTopicId] = useState<string>('math-8-linear-eq');
  const [inputQuery, setInputQuery] = useState<string>('');
  const [messages, setMessages] = useState<ChatTurn[]>([
    {
      id: 'init-1',
      role: 'tutor',
      text: 'Hello! I am your StudyVerse NCERT Textbook Tutor (Demo Mode • Deterministic RAG). Select a class, subject, and chapter, then ask any conceptual question, request a simpler explanation, or ask for a worked example.',
      citations: [passages[0]],
      grounded: true,
      followUps: [
        'How do I solve linear equations with variables on both sides?',
        'Why does (a - b)^2 have a middle term -2ab?',
        'How does contact area affect pressure in Pascals?',
      ],
    },
  ]);

  const currentTopic = topics.find((t) => t.id === selectedTopicId) || topics[0];

  const handleSendQuery = (
    queryText: string,
    mode: 'standard' | 'simple' | 'example' | 'why_correct' = 'standard'
  ) => {
    const trimmed = queryText.trim();
    if (!trimmed) return;

    const userMsg: ChatTurn = {
      id: `u-${Date.now()}`,
      role: 'user',
      text: trimmed,
    };

    const ragResult = queryTextbookRAG(
      trimmed,
      passages,
      selectedSubject,
      selectedClass,
      mode
    );

    const tutorMsg: ChatTurn = {
      id: `t-${Date.now() + 1}`,
      role: 'tutor',
      text: ragResult.answer,
      citations: ragResult.citations,
      grounded: ragResult.grounded,
      followUps: ragResult.followUpSuggestions,
    };

    setMessages((prev) => [...prev, userMsg, tutorMsg]);
    setInputQuery('');
  };

  return (
    <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
      {/* Left RAG Controls & Pipeline Info */}
      <div className="lg:col-span-4 space-y-4">
        <div className="bg-white rounded-2xl border border-slate-200 p-5 shadow-sm space-y-4">
          <div className="flex items-center justify-between">
            <span className="text-xs font-extrabold uppercase tracking-wider text-teal-700 flex items-center gap-1.5">
              <Brain className="w-4 h-4" />
              NCERT Textbook RAG Tutor
            </span>
            <span className="px-2 py-0.5 rounded bg-amber-100 text-amber-900 font-bold text-[10px]">
              Demo RAG Active
            </span>
          </div>

          <div className="space-y-3 text-xs">
            <div>
              <label className="block font-bold text-slate-700 mb-1">Class Level</label>
              <select
                value={selectedClass}
                onChange={(e) => setSelectedClass(Number(e.target.value) as ClassLevel)}
                className="w-full px-3 py-2 rounded-xl border border-slate-300 font-semibold bg-white"
              >
                {[6, 7, 8, 9, 10].map((c) => (
                  <option key={c} value={c}>
                    Class {c} (CBSE / NCERT)
                  </option>
                ))}
              </select>
            </div>

            <div>
              <label className="block font-bold text-slate-700 mb-1">Subject</label>
              <select
                value={selectedSubject}
                onChange={(e) => {
                  const s = e.target.value as SubjectName;
                  setSelectedSubject(s);
                  const firstMatch = topics.find((t) => t.subject === s && !t.isFoundationTopic);
                  if (firstMatch) setSelectedTopicId(firstMatch.id);
                }}
                className="w-full px-3 py-2 rounded-xl border border-slate-300 font-semibold bg-white"
              >
                {(['Mathematics', 'Science', 'English', 'Social Science'] as SubjectName[]).map(
                  (s) => (
                    <option key={s} value={s}>
                      {s}
                    </option>
                  )
                )}
              </select>
            </div>

            <div>
              <label className="block font-bold text-slate-700 mb-1">Chapter / Topic</label>
              <select
                value={selectedTopicId}
                onChange={(e) => setSelectedTopicId(e.target.value)}
                className="w-full px-3 py-2 rounded-xl border border-slate-300 font-semibold bg-white"
              >
                {topics
                  .filter((t) => t.subject === selectedSubject)
                  .map((t) => (
                    <option key={t.id} value={t.id}>
                      Class {t.classLevel}: {t.title}
                    </option>
                  ))}
              </select>
            </div>
          </div>

          {/* Quick Tutor Actions */}
          <div className="pt-2 border-t border-slate-100 space-y-2">
            <div className="text-[11px] font-bold text-slate-500 uppercase">
              One-Click Grounded Prompts
            </div>
            <div className="grid grid-cols-1 gap-2">
              <button
                type="button"
                onClick={() =>
                  handleSendQuery(`Explain ${currentTopic.title} simply`, 'simple')
                }
                className="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-left text-xs font-semibold text-slate-800 transition"
              >
                ✨ Request Simple Explanation ({currentTopic.title})
              </button>
              <button
                type="button"
                onClick={() =>
                  handleSendQuery(`Show a step-by-step worked example for ${currentTopic.title}`, 'example')
                }
                className="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-left text-xs font-semibold text-slate-800 transition"
              >
                📘 Request Worked NCERT Example
              </button>
              <button
                type="button"
                onClick={() =>
                  handleSendQuery(`Why is the core rule in ${currentTopic.title} valid?`, 'why_correct')
                }
                className="p-2.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-left text-xs font-semibold text-slate-800 transition"
              >
                🔍 Ask Why an Answer / Formula is Correct
              </button>
              <button
                type="button"
                onClick={() =>
                  handleSendQuery('Explain quantum chromodynamics and relativistic tensors', 'standard')
                }
                className="p-2.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-200 text-left text-xs font-semibold text-amber-950 transition"
              >
                🛡️ Test Insufficient-Evidence Guardrail (Out-of-Syllabus)
              </button>
            </div>
          </div>

          <div className="pt-2 border-t border-slate-100">
            <button
              type="button"
              onClick={() => onStartTargetedQuiz(currentTopic.id)}
              className="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs transition"
            >
              <Play className="w-3.5 h-3.5" />
              Open Practice Quiz on {currentTopic.title}
            </button>
          </div>
        </div>
      </div>

      {/* Right Chat & Source Citations Area */}
      <div className="lg:col-span-8 bg-white rounded-2xl border border-slate-200 shadow-sm flex flex-col h-[620px]">
        <div className="p-4 border-b border-slate-200 flex items-center justify-between">
          <div>
            <h3 className="text-base font-extrabold text-slate-900">
              Interactive Textbook RAG Conversation
            </h3>
            <p className="text-xs text-slate-500">
              Grounded in CBSE/NCERT textbook chunks with chapter &amp; page citations
            </p>
          </div>
          <span className="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg border border-emerald-200">
            {passages.length} NCERT Chunks Indexed
          </span>
        </div>

        {/* Messages */}
        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {messages.map((m) => (
            <div
              key={m.id}
              className={`flex flex-col ${
                m.role === 'user' ? 'items-end' : 'items-start'
              }`}
            >
              <div
                className={`max-w-2xl rounded-2xl p-4 text-xs sm:text-sm space-y-3 ${
                  m.role === 'user'
                    ? 'bg-blue-900 text-white'
                    : 'bg-slate-50 border border-slate-200 text-slate-800'
                }`}
              >
                <div className="whitespace-pre-line leading-relaxed">{m.text}</div>

                {/* Retrieved NCERT Source Citations */}
                {m.role === 'tutor' && m.citations && m.citations.length > 0 && (
                  <div className="pt-2 border-t border-slate-200/80 space-y-1.5">
                    <div className="text-[11px] font-extrabold uppercase tracking-wider text-sky-700">
                      Retrieved NCERT Textbook Sources:
                    </div>
                    {m.citations.map((cit) => (
                      <div
                        key={cit.id}
                        className="p-2.5 rounded-xl bg-white border border-slate-200 text-xs text-slate-700"
                      >
                        <div className="font-bold text-slate-900">
                          {cit.board} • Class {cit.classLevel} {cit.subject} • {cit.chapter} (Page {cit.pageNumber})
                        </div>
                        <p className="text-[11px] text-slate-600 mt-0.5 line-clamp-2">
                          &ldquo;{cit.content}&rdquo;
                        </p>
                      </div>
                    ))}
                  </div>
                )}

                {m.role === 'tutor' && m.grounded === false && (
                  <div className="p-2.5 rounded-xl bg-amber-100/80 border border-amber-300 text-xs text-amber-950 font-semibold">
                    ⚠️ Citation Guardrail Triggered: No matching passage found in the CBSE Class 6–10 corpus. StudyVerse refuses to fabricate citations.
                  </div>
                )}

                {/* Follow-up suggestions */}
                {m.role === 'tutor' && m.followUps && m.followUps.length > 0 && (
                  <div className="pt-2 flex flex-wrap gap-1.5">
                    {m.followUps.map((f) => (
                      <button
                        key={f}
                        type="button"
                        onClick={() => handleSendQuery(f)}
                        className="px-2.5 py-1 rounded-lg bg-blue-50 hover:bg-blue-100 text-blue-900 border border-blue-200 text-[11px] font-semibold transition"
                      >
                        {f}
                      </button>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>

        {/* Input Box */}
        <form
          onSubmit={(e) => {
            e.preventDefault();
            handleSendQuery(inputQuery);
          }}
          className="p-4 border-t border-slate-200 flex items-center gap-2"
        >
          <input
            type="text"
            value={inputQuery}
            onChange={(e) => setInputQuery(e.target.value)}
            placeholder={`Ask about ${currentTopic.title} or any NCERT concept...`}
            className="flex-1 px-4 py-2.5 rounded-xl border border-slate-300 text-sm focus:outline-none focus:ring-2 focus:ring-blue-900"
          />
          <button
            type="submit"
            className="inline-flex items-center gap-1.5 px-5 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-sm transition"
          >
            <Send className="w-4 h-4" />
            Ask
          </button>
        </form>
      </div>
    </div>
  );
};

interface StudyPlannerViewProps {
  student: Student;
  tasks: StudyTask[];
  todayMinutesCompleted: number;
  onToggleTaskComplete: (taskId: string) => void;
  onRescheduleTask: (taskId: string, newDay: string) => void;
  onUpdateDailyGoalMinutes: (minutes: number) => void;
  onNavigateToTaskTopic: (topicId: string, taskType: StudyTask['taskType']) => void;
}

const StudyPlannerView: React.FC<StudyPlannerViewProps> = ({
  student,
  tasks,
  todayMinutesCompleted,
  onToggleTaskComplete,
  onRescheduleTask,
  onUpdateDailyGoalMinutes,
  onNavigateToTaskTopic,
}) => {
  const totalPlannedMinutes = tasks.reduce((acc, t) => acc + t.estimatedMinutes, 0);
  const progressPct = Math.min(
    100,
    Math.round((todayMinutesCompleted / Math.max(1, student.dailyGoalMinutes)) * 100)
  );

  return (
    <div className="space-y-6">
      {/* Top Schedule Summary & Duration Adjuster */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span className="text-xs font-bold uppercase tracking-wider text-indigo-600">
              Adaptive Daily &amp; Weekly Study Planner
            </span>
            <h2 className="text-2xl font-extrabold text-slate-900">
              Your Time-Boxed Learning Plan ({student.dailyGoalMinutes} Mins/Day)
            </h2>
            <p className="text-xs text-slate-600 mt-0.5">
              Generated from your topic performance, reasoning evidence, prerequisite gaps, and preferred study window ({student.preferredStudyTime}).
            </p>
          </div>

          <div className="flex items-center gap-2">
            <span className="text-xs font-bold text-slate-600">Daily Goal:</span>
            {[20, 30, 45, 60].map((m) => (
              <button
                key={m}
                type="button"
                onClick={() => onUpdateDailyGoalMinutes(m)}
                className={`px-3 py-1.5 rounded-xl text-xs font-bold border transition ${
                  student.dailyGoalMinutes === m
                    ? 'bg-blue-900 text-white border-blue-900'
                    : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
                }`}
              >
                {m}m
              </button>
            ))}
          </div>
        </div>

        {/* Daily Goal Progress Bar */}
        <div className="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-2">
          <div className="flex items-center justify-between text-xs font-bold">
            <span className="text-slate-700">
              Today&rsquo;s Study Progress: {todayMinutesCompleted} / {student.dailyGoalMinutes} mins completed
            </span>
            <span className="text-emerald-700">{progressPct}% of Daily Goal</span>
          </div>
          <div className="w-full h-3 bg-slate-200 rounded-full overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-blue-900 via-sky-500 to-emerald-500 transition-all duration-300"
              style={{ width: `${progressPct}%` }}
            />
          </div>
          <p className="text-[11px] text-slate-500">
            Total allocated task time today: <strong>{totalPlannedMinutes} mins</strong> (automatically scaled to fit your {student.dailyGoalMinutes}-minute daily budget).
          </p>
        </div>
      </div>

      {/* Task Cards */}
      <div className="space-y-3">
        {tasks.map((task) => {
          const isDone = task.completionStatus === 'completed';
          return (
            <div
              key={task.id}
              className={`p-5 rounded-2xl border transition flex flex-col md:flex-row md:items-center justify-between gap-4 ${
                isDone
                  ? 'bg-emerald-50/50 border-emerald-200'
                  : 'bg-white border-slate-200 shadow-sm'
              }`}
            >
              <div className="space-y-1.5">
                <div className="flex flex-wrap items-center gap-2">
                  <span
                    className={`px-2.5 py-0.5 rounded-full text-[11px] font-bold ${
                      task.priority === 'High'
                        ? 'bg-rose-100 text-rose-800'
                        : task.priority === 'Medium'
                        ? 'bg-amber-100 text-amber-900'
                        : 'bg-blue-100 text-blue-900'
                    }`}
                  >
                    {task.priority} Priority
                  </span>
                  <span className="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-700">
                    ⏱️ {task.estimatedMinutes} mins
                  </span>
                  <span className="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-sky-50 text-sky-800 border border-sky-200">
                    📅 {task.scheduledDay}
                  </span>
                </div>

                <h3
                  className={`text-base font-extrabold ${
                    isDone ? 'line-through text-slate-500' : 'text-slate-900'
                  }`}
                >
                  {task.title}
                </h3>

                <p className="text-xs text-slate-600 leading-relaxed">
                  <strong>Why recommended:</strong> {task.recommendationReason}
                </p>
              </div>

              <div className="flex flex-wrap items-center gap-2 shrink-0">
                <select
                  value={task.scheduledDay}
                  onChange={(e) => onRescheduleTask(task.id, e.target.value)}
                  className="px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold bg-white"
                  aria-label="Reschedule task day"
                >
                  <option value="Today">Schedule: Today</option>
                  <option value="Tomorrow">Reschedule: Tomorrow</option>
                  <option value="This Weekend">Reschedule: Weekend</option>
                </select>

                <button
                  type="button"
                  onClick={() => onNavigateToTaskTopic(task.topicId, task.taskType)}
                  className="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition"
                >
                  Open Activity
                </button>

                <button
                  type="button"
                  onClick={() => onToggleTaskComplete(task.id)}
                  className={`inline-flex items-center gap-1.5 px-4 py-2 rounded-xl font-bold text-xs transition ${
                    isDone
                      ? 'bg-emerald-600 text-white'
                      : 'bg-blue-900 hover:bg-blue-800 text-white'
                  }`}
                >
                  <CheckCircle2 className="w-4 h-4" />
                  {isDone ? 'Completed (+Mins)' : 'Mark Complete'}
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  );
};

interface StreaksAchievementsViewProps {
  currentStreak: number;
  longestStreak: number;
  todayMinutesCompleted: number;
  dailyGoalMinutes: number;
  todayGoalMet: boolean;
  achievements: Achievement[];
  sessions: StudySession[];
}

const StreaksAchievementsView: React.FC<StreaksAchievementsViewProps> = ({
  currentStreak,
  longestStreak,
  todayMinutesCompleted,
  dailyGoalMinutes,
  todayGoalMet,
  achievements,
  sessions,
}) => {
  const nextMilestone =
    currentStreak < 10
      ? { title: 'Bronze Learner', target: 10 }
      : currentStreak < 50
      ? { title: 'Silver Scholar', target: 50 }
      : { title: 'Gold Scholar', target: 100 };

  return (
    <div className="space-y-6">
      {/* Top Streak Hero */}
      <div className="bg-gradient-to-r from-blue-900 via-indigo-900 to-violet-900 rounded-2xl p-6 sm:p-8 text-white shadow-lg grid grid-cols-1 md:grid-cols-4 gap-6 items-center">
        <div className="md:col-span-2 space-y-2">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-400/20 text-amber-300 text-xs font-bold">
            <Flame className="w-4 h-4" />
            Healthy, Encouraging Study Habits
          </div>
          <h2 className="text-2xl sm:text-3xl font-extrabold">
            {currentStreak} Day Study Streak 🔥
          </h2>
          <p className="text-xs sm:text-sm text-blue-100 leading-relaxed">
            {todayGoalMet
              ? "Awesome work! You completed today's daily study goal and locked in your streak for today."
              : `Complete ${Math.max(
                  0,
                  dailyGoalMinutes - todayMinutesCompleted
                )} more minutes of study tasks today to reach your ${dailyGoalMinutes}-minute daily goal!`}
          </p>
          <p className="text-[11px] text-sky-200">
            Missed a day? No worries and zero guilt—every new study session builds lasting knowledge.
          </p>
        </div>

        <div className="bg-white/10 rounded-xl p-4 border border-white/15 text-center">
          <div className="text-xs text-blue-200">Longest Streak</div>
          <div className="text-3xl font-extrabold text-amber-300 mt-1">{longestStreak} Days</div>
          <div className="text-[11px] text-blue-200 mt-1">Timezone: Asia/Kolkata</div>
        </div>

        <div className="bg-white/10 rounded-xl p-4 border border-white/15 text-center">
          <div className="text-xs text-blue-200">Next Milestone</div>
          <div className="text-lg font-extrabold text-emerald-300 mt-1">
            {nextMilestone.title}
          </div>
          <div className="text-xs text-white mt-1">
            {currentStreak} / {nextMilestone.target} consecutive days
          </div>
        </div>
      </div>

      {/* 14-Day Activity Calendar */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">
          Recent 14-Day Study Activity Calendar
        </h3>
        <div className="grid grid-cols-7 sm:grid-cols-14 gap-2">
          {sessions.map((s) => (
            <div
              key={s.id}
              className={`p-2.5 rounded-xl border text-center ${
                s.goalCompleted
                  ? 'bg-emerald-50 border-emerald-300 text-emerald-900'
                  : 'bg-slate-50 border-slate-200 text-slate-400'
              }`}
            >
              <div className="text-[10px] font-bold">{s.date.slice(5)}</div>
              <div className="text-xs font-extrabold mt-1">
                {s.goalCompleted ? '🔥' : '·'}
              </div>
              <div className="text-[10px] mt-0.5">{s.durationMinutes}m</div>
            </div>
          ))}
        </div>
      </div>

      {/* Milestone Badges */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">
          Milestone Rewards &amp; Badges (10d Bronze • 50d Silver • 100d Gold)
        </h3>
        <div className="grid grid-cols-1 md:grid-cols-3 gap-4">
          {achievements.map((ach) => (
            <div
              key={ach.id}
              className={`p-5 rounded-2xl border-2 transition ${
                ach.unlocked
                  ? 'border-emerald-400 bg-emerald-50/40'
                  : 'border-slate-200 bg-slate-50 opacity-80'
              }`}
            >
              <div className="flex items-center justify-between mb-2">
                <Award
                  className={`w-7 h-7 ${
                    ach.badgeType === 'gold'
                      ? 'text-amber-500'
                      : ach.badgeType === 'silver'
                      ? 'text-slate-500'
                      : ach.badgeType === 'bronze'
                      ? 'text-amber-700'
                      : 'text-emerald-600'
                  }`}
                />
                <span
                  className={`px-2.5 py-0.5 rounded-full text-[11px] font-bold ${
                    ach.unlocked
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-slate-200 text-slate-600'
                  }`}
                >
                  {ach.unlocked ? `Unlocked ${ach.earnedAt || ''}` : `${ach.requiredDays} Days Required`}
                </span>
              </div>
              <h4 className="text-sm font-extrabold text-slate-900">{ach.milestone}</h4>
              <p className="text-xs text-slate-600 mt-1 leading-relaxed">{ach.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};

interface MyResourcesViewProps {
  resources: UploadedResource[];
  onAddResource: (res: UploadedResource) => void;
}

const MyResourcesView: React.FC<MyResourcesViewProps> = ({
  resources,
  onAddResource,
}) => {
  const [selectedSubject, setSelectedSubject] = useState<SubjectName>('Science');
  const [selectedClass, setSelectedClass] = useState<ClassLevel>(8);

  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const isPdf = file.name.toLowerCase().endsWith('.pdf') || file.type === 'application/pdf';
    const maxBytes = 25 * 1024 * 1024;
    const isUnderLimit = file.size <= maxBytes;

    const newRes: UploadedResource = {
      id: `res-${Date.now()}`,
      fileName: file.name,
      fileSizeBytes: file.size,
      subject: selectedSubject,
      classLevel: selectedClass,
      uploadProgress: 100,
      validationStatus: !isPdf
        ? 'invalid_type'
        : !isUnderLimit
        ? 'exceeds_size'
        : 'valid',
      processingStatus:
        isPdf && isUnderLimit ? 'indexed_demo' : 'rejected',
      statusMessage: !isPdf
        ? 'Rejected: Only .pdf textbook or study note files are permitted.'
        : !isUnderLimit
        ? 'Rejected: File exceeds the 25 MB maximum upload size.'
        : 'Validated PDF structure. Demo Mode: Metadata registered (connect FastAPI backend for full PyMuPDF vector indexing).',
      uploadedAt: new Date().toISOString().slice(0, 10),
      chunksExtracted: isPdf && isUnderLimit ? Math.max(4, Math.round(file.size / 18000)) : 0,
    };

    onAddResource(newRes);
    e.target.value = '';
  };

  const simulateSampleUpload = (valid: boolean) => {
    const newRes: UploadedResource = valid
      ? {
          id: `res-${Date.now()}`,
          fileName: `NCERT_Class_${selectedClass}_${selectedSubject}_Chapter_Notes.pdf`,
          fileSizeBytes: 1843200,
          subject: selectedSubject,
          classLevel: selectedClass,
          uploadProgress: 100,
          validationStatus: 'valid',
          processingStatus: 'indexed_demo',
          statusMessage:
            'Validated PDF (1.76 MB). Demo Mode: Sample text chunks & metadata preserved for RAG retrieval.',
          uploadedAt: new Date().toISOString().slice(0, 10),
          chunksExtracted: 14,
        }
      : {
          id: `res-${Date.now()}`,
          fileName: 'Unsupported_Image_Archive.exe',
          fileSizeBytes: 512000,
          subject: selectedSubject,
          classLevel: selectedClass,
          uploadProgress: 100,
          validationStatus: 'invalid_type',
          processingStatus: 'rejected',
          statusMessage:
            'Validation Failed: Only permitted .pdf study resources are accepted (max 25 MB).',
          uploadedAt: new Date().toISOString().slice(0, 10),
          chunksExtracted: 0,
        };
    onAddResource(newRes);
  };

  return (
    <div className="space-y-6">
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <div>
          <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
            Personal Study Library &amp; RAG Ingestion
          </span>
          <h2 className="text-2xl font-extrabold text-slate-900">
            My Resources (PDF Textbook &amp; Notes Upload)
          </h2>
          <p className="text-xs text-slate-600 mt-1">
            Upload permitted CBSE/NCERT PDF chapters or school notes (max 25 MB). StudyVerse validates file type and size before preparing chunks and metadata for the AI Tutor.
          </p>
        </div>

        <div className="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
          <div>
            <label className="block text-xs font-bold text-slate-700 mb-1">
              Target Class
            </label>
            <select
              value={selectedClass}
              onChange={(e) => setSelectedClass(Number(e.target.value) as ClassLevel)}
              className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold bg-white"
            >
              {[6, 7, 8, 9, 10].map((c) => (
                <option key={c} value={c}>
                  Class {c}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="block text-xs font-bold text-slate-700 mb-1">
              Subject Tag
            </label>
            <select
              value={selectedSubject}
              onChange={(e) => setSelectedSubject(e.target.value as SubjectName)}
              className="w-full px-3 py-2 rounded-xl border border-slate-300 text-xs font-semibold bg-white"
            >
              {(['Mathematics', 'Science', 'English', 'Social Science'] as SubjectName[]).map(
                (s) => (
                  <option key={s} value={s}>
                    {s}
                  </option>
                )
              )}
            </select>
          </div>
          <div className="flex items-end">
            <label className="w-full cursor-pointer inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs transition">
              <Upload className="w-4 h-4" />
              <span>Select Local PDF File</span>
              <input
                type="file"
                accept=".pdf,application/pdf"
                onChange={handleFileChange}
                className="hidden"
              />
            </label>
          </div>
        </div>

        <div className="flex flex-wrap items-center gap-2 pt-2 border-t border-slate-100 text-xs">
          <span className="text-slate-500 font-semibold">Quick Demo Upload Tests:</span>
          <button
            type="button"
            onClick={() => simulateSampleUpload(true)}
            className="px-3 py-1.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-900 border border-emerald-200 font-bold transition"
          >
            + Simulate Valid NCERT Chapter PDF Upload
          </button>
          <button
            type="button"
            onClick={() => simulateSampleUpload(false)}
            className="px-3 py-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-900 border border-rose-200 font-bold transition"
          >
            + Test Invalid File Type Validation Error
          </button>
        </div>
      </div>

      {/* Uploaded Resource List */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">
          Uploaded Resources &amp; Processing Status ({resources.length})
        </h3>
        <div className="space-y-3">
          {resources.map((res) => (
            <div
              key={res.id}
              className={`p-4 rounded-xl border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${
                res.validationStatus === 'valid'
                  ? 'bg-slate-50 border-slate-200'
                  : 'bg-rose-50/70 border-rose-200'
              }`}
            >
              <div className="space-y-1">
                <div className="flex flex-wrap items-center gap-2">
                  <FileText className="w-4 h-4 text-blue-900" />
                  <span className="text-sm font-bold text-slate-900">{res.fileName}</span>
                  <span className="text-xs text-slate-500">
                    ({(res.fileSizeBytes / (1024 * 1024)).toFixed(2)} MB)
                  </span>
                  <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-blue-100 text-blue-900">
                    Class {res.classLevel} • {res.subject}
                  </span>
                </div>
                <p className="text-xs text-slate-600">{res.statusMessage}</p>
              </div>

              <div className="shrink-0 flex items-center gap-2">
                <span
                  className={`px-3 py-1 rounded-full text-xs font-bold ${
                    res.validationStatus === 'valid'
                      ? 'bg-emerald-100 text-emerald-800'
                      : 'bg-rose-100 text-rose-800'
                  }`}
                >
                  {res.validationStatus === 'valid'
                    ? `Demo Indexed (${res.chunksExtracted} chunks)`
                    : 'Rejected'}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  );
};

interface AskDoubtDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  defaultSubject: SubjectName;
  defaultTopicTitle: string;
  defaultChapter: string;
  classLevel: ClassLevel;
  passages: TextbookPassage[];
}

const AskDoubtDrawer: React.FC<AskDoubtDrawerProps> = ({
  isOpen,
  onClose,
  defaultSubject,
  defaultTopicTitle,
  defaultChapter,
  classLevel,
  passages,
}) => {
  const [subject, setSubject] = useState<SubjectName>(defaultSubject);
  const [question, setQuestion] = useState<string>('');
  const [history, setHistory] = useState<
    Array<{ q: string; a: string; citations: TextbookPassage[]; suggestions: string[] }>
  >([]);

  if (!isOpen) return null;

  const submitDoubt = (qText: string, mode: 'standard' | 'simple' | 'example' = 'standard') => {
    const clean = qText.trim();
    if (!clean) return;
    const res = queryTextbookRAG(clean, passages, subject, classLevel, mode);
    setHistory((prev) => [
      ...prev,
      {
        q: clean,
        a: res.answer,
        citations: res.citations,
        suggestions: res.followUpSuggestions,
      },
    ]);
    setQuestion('');
  };

  return (
    <div className="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm flex justify-end">
      <div className="w-full max-w-lg bg-white h-full shadow-2xl border-l border-slate-200 flex flex-col">
        <div className="p-5 bg-blue-900 text-white flex items-center justify-between">
          <div>
            <span className="text-[11px] font-bold uppercase tracking-wider text-sky-300">
              Instant Doubt-Solving Assistant
            </span>
            <h3 className="text-lg font-extrabold">Ask a Doubt Anytime</h3>
            <p className="text-xs text-blue-100">
              Connected to {defaultChapter} • Asking doubts never lowers your mastery score!
            </p>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="p-2 rounded-xl bg-white/10 hover:bg-white/20 text-white"
            aria-label="Close doubt panel"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        <div className="p-4 bg-slate-50 border-b border-slate-200 space-y-2 text-xs">
          <div className="flex items-center justify-between gap-2">
            <span className="font-bold text-slate-700">Active Context:</span>
            <select
              value={subject}
              onChange={(e) => setSubject(e.target.value as SubjectName)}
              className="px-2.5 py-1 rounded-lg border border-slate-300 font-semibold bg-white"
            >
              {(['Mathematics', 'Science', 'English', 'Social Science'] as SubjectName[]).map(
                (s) => (
                  <option key={s} value={s}>
                    {s}
                  </option>
                )
              )}
            </select>
          </div>
          <div className="flex flex-wrap gap-1.5">
            <button
              type="button"
              onClick={() => submitDoubt(`Can you explain ${defaultTopicTitle} more simply?`, 'simple')}
              className="px-2.5 py-1 rounded-lg bg-white hover:bg-blue-50 text-blue-900 border border-slate-200 font-semibold"
            >
              Can you explain this more simply?
            </button>
            <button
              type="button"
              onClick={() => submitDoubt(`Can you show me an example for ${defaultTopicTitle}?`, 'example')}
              className="px-2.5 py-1 rounded-lg bg-white hover:bg-blue-50 text-blue-900 border border-slate-200 font-semibold"
            >
              Can you show me an example?
            </button>
            <button
              type="button"
              onClick={() => submitDoubt(`Can you give me a practice question on ${defaultTopicTitle}?`, 'example')}
              className="px-2.5 py-1 rounded-lg bg-white hover:bg-blue-50 text-blue-900 border border-slate-200 font-semibold"
            >
              Can you give me a practice question?
            </button>
          </div>
        </div>

        <div className="flex-1 overflow-y-auto p-4 space-y-4">
          {history.length === 0 ? (
            <div className="text-center py-10 space-y-2 text-slate-500 text-xs">
              <HelpCircle className="w-8 h-8 text-sky-600 mx-auto" />
              <p className="font-semibold text-slate-700">
                Stuck on a formula, sign rule, or science concept in {defaultTopicTitle}?
              </p>
              <p>Type your question below or click one of the quick prompts above.</p>
            </div>
          ) : (
            history.map((item, idx) => (
              <div key={idx} className="space-y-2">
                <div className="bg-blue-900 text-white p-3 rounded-2xl rounded-tr-none text-xs font-semibold ml-8">
                  {item.q}
                </div>
                <div className="bg-slate-50 border border-slate-200 p-3.5 rounded-2xl rounded-tl-none text-xs text-slate-800 space-y-2 mr-4">
                  <div className="whitespace-pre-line leading-relaxed">{item.a}</div>
                  {item.citations.length > 0 && (
                    <div className="text-[11px] text-sky-800 font-semibold pt-1 border-t border-slate-200">
                      📖 Source: {item.citations[0].chapter} (p. {item.citations[0].pageNumber})
                    </div>
                  )}
                  <div className="flex flex-wrap gap-1.5 pt-1">
                    {item.suggestions.map((sug) => (
                      <button
                        key={sug}
                        type="button"
                        onClick={() => submitDoubt(sug)}
                        className="px-2 py-1 rounded bg-blue-50 hover:bg-blue-100 text-blue-900 text-[11px] font-semibold"
                      >
                        {sug}
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            ))
          )}
        </div>

        <form
          onSubmit={(e) => {
            e.preventDefault();
            submitDoubt(question);
          }}
          className="p-4 border-t border-slate-200 flex items-center gap-2"
        >
          <input
            type="text"
            value={question}
            onChange={(e) => setQuestion(e.target.value)}
            placeholder="Type your doubt here..."
            className="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-300 text-xs focus:outline-none focus:ring-2 focus:ring-blue-900"
          />
          <button
            type="submit"
            className="px-4 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs"
          >
            Ask Doubt
          </button>
        </form>
      </div>
    </div>
  );
};

// ==========================================
// MODULE: components/DashboardAndProgress.tsx
// ==========================================
interface StudentDashboardViewProps {
  student: Student;
  topics: Topic[];
  masteryMap: Record<string, TopicMastery>;
  attempts: QuizAttempt[];
  tasks: StudyTask[];
  recommendation: RecommendationSummary;
  currentStreak: number;
  totalStudyMinutes: number;
  todayMinutesCompleted: number;
  isDemoData: boolean;
  onNavigateTab: (tab: string) => void;
  onStartTopicLesson: (topicId: string) => void;
  onOpenFoundationLesson: (prereqId: string, parentTopicId: string) => void;
  onStartTargetedQuiz: (topicId: string) => void;
  onToggleTaskComplete: (taskId: string) => void;
  onOpenDoubtDrawer: () => void;
}

const StudentDashboardView: React.FC<StudentDashboardViewProps> = ({
  student,
  topics,
  masteryMap,
  attempts,
  tasks,
  recommendation,
  currentStreak,
  totalStudyMinutes,
  todayMinutesCompleted,
  isDemoData,
  onNavigateTab,
  onStartTopicLesson,
  onOpenFoundationLesson,
  onStartTargetedQuiz,
  onToggleTaskComplete,
  onOpenDoubtDrawer,
}) => {
  const [showWhyModal, setShowWhyModal] = useState<boolean>(false);

  const coreTopics = topics.filter(
    (t) => !t.isFoundationTopic && student.selectedSubjects.includes(t.subject)
  );

  // Subject-wise chart data
  const subjectChartData = student.selectedSubjects.map((subj) => {
    const subjTopics = coreTopics.filter((t) => t.subject === subj);
    const scores = subjTopics.map((t) => masteryMap[t.id]?.performanceScore ?? 0);
    const avg =
      scores.length > 0
        ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length)
        : 0;
    return {
      subject: subj,
      score: avg,
      target: 85,
    };
  });

  const topicChartData = coreTopics.map((t) => ({
    name: t.title.length > 18 ? t.title.slice(0, 18) + '…' : t.title,
    fullTitle: t.title,
    score: masteryMap[t.id]?.performanceScore ?? 0,
    subject: t.subject,
  }));

  const weakTopics = coreTopics.filter((t) => masteryMap[t.id]?.status === 'weak');
  const uncertainTopics = coreTopics.filter((t) => masteryMap[t.id]?.status === 'uncertain');
  const prereqTopic = recommendation.prerequisiteTopicId
    ? topics.find((t) => t.id === recommendation.prerequisiteTopicId)
    : null;

  const goalPct = Math.min(
    100,
    Math.round((todayMinutesCompleted / Math.max(1, student.dailyGoalMinutes)) * 100)
  );

  return (
    <div className="space-y-6">
      {/* Continuous Recommendation Shift Alert Banner */}
      {recommendation.changeNotice && (
        <div className="p-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-700 text-white shadow-md flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div className="flex items-start gap-3">
            <Sparkles className="w-5 h-5 text-emerald-200 shrink-0 mt-0.5" />
            <div>
              <div className="text-xs font-extrabold uppercase tracking-wider text-emerald-100">
                Continuous Recommendation Engine Updated
              </div>
              <p className="text-sm font-bold mt-0.5">{recommendation.changeNotice}</p>
            </div>
          </div>
          <button
            type="button"
            onClick={() => onStartTopicLesson(recommendation.nextTopicId)}
            className="shrink-0 px-4 py-2 rounded-xl bg-white text-emerald-900 font-bold text-xs hover:bg-emerald-50 transition"
          >
            Study New Priority →
          </button>
        </div>
      )}

      {/* Top Student Greeting & Quick Actions Bar */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-5">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div className="space-y-1">
            <div className="flex flex-wrap items-center gap-2">
              <span className="px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-900 font-bold text-xs">
                Class {student.classLevel} • {student.board}
              </span>
              {student.selectedSubjects.map((s) => (
                <span
                  key={s}
                  className="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 font-semibold text-xs"
                >
                  {s}
                </span>
              ))}
              {isDemoData && (
                <span className="px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-900 font-bold text-[11px] border border-amber-300">
                  Coherent Class 8 Demo Data Active
                </span>
              )}
            </div>
            <h1 className="text-2xl sm:text-3xl font-extrabold text-slate-900 pt-1">
              Welcome back, {student.displayName}! 👋
            </h1>
            <p className="text-xs sm:text-sm text-slate-600">
              Goal: <strong>{student.learningGoal}</strong>
              {student.selectedWeakSubjects.length > 0 && (
                <>
                  {' '}
                  • Priority Focus:{' '}
                  <strong className="text-violet-700">
                    {student.selectedWeakSubjects.join(', ')}
                  </strong>
                </>
              )}
            </p>
          </div>

          {/* 5 Required Primary Dashboard Actions */}
          <div className="flex flex-wrap items-center gap-2">
            <button
              type="button"
              onClick={() => onStartTopicLesson(recommendation.nextTopicId)}
              className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs shadow-sm transition"
            >
              <BookOpen className="w-3.5 h-3.5" />
              Continue Learning
            </button>
            <button
              type="button"
              onClick={() => onStartTargetedQuiz(recommendation.nextTopicId)}
              className="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-sky-600 hover:bg-sky-700 text-white font-bold text-xs shadow-sm transition"
            >
              <Play className="w-3.5 h-3.5" />
              Take Quiz
            </button>
            <button
              type="button"
              onClick={onOpenDoubtDrawer}
              className="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-violet-50 hover:bg-violet-100 text-violet-900 border border-violet-200 font-bold text-xs transition"
            >
              <MessageSquarePlus className="w-3.5 h-3.5 text-violet-600" />
              Ask a Doubt
            </button>
            <button
              type="button"
              onClick={() => onNavigateTab('progress')}
              className="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition"
            >
              <TrendingUp className="w-3.5 h-3.5" />
              View Progress
            </button>
            <button
              type="button"
              onClick={() => onNavigateTab('resources')}
              className="inline-flex items-center gap-1.5 px-3.5 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs transition"
            >
              <Upload className="w-3.5 h-3.5" />
              Upload Resources
            </button>
          </div>
        </div>

        {/* 4 Key Metric Cards */}
        <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
          <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/90 space-y-1">
            <div className="flex items-center justify-between text-xs text-slate-500 font-semibold">
              <span>Today&rsquo;s Study Goal</span>
              <Clock className="w-4 h-4 text-blue-900" />
            </div>
            <div className="text-xl font-extrabold text-slate-900">
              {todayMinutesCompleted} / {student.dailyGoalMinutes} mins
            </div>
            <div className="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden mt-1">
              <div
                className="h-full bg-emerald-500"
                style={{ width: `${goalPct}%` }}
              />
            </div>
          </div>

          <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/90 space-y-1">
            <div className="flex items-center justify-between text-xs text-slate-500 font-semibold">
              <span>Current Streak</span>
              <Flame className="w-4 h-4 text-amber-500" />
            </div>
            <div className="text-xl font-extrabold text-slate-900">
              {currentStreak} Days 🔥
            </div>
            <div className="text-[11px] text-emerald-700 font-semibold">
              Next badge at 10 days (Bronze)
            </div>
          </div>

          <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/90 space-y-1">
            <div className="flex items-center justify-between text-xs text-slate-500 font-semibold">
              <span>Total Study Time</span>
              <TrendingUp className="w-4 h-4 text-sky-600" />
            </div>
            <div className="text-xl font-extrabold text-slate-900">
              {totalStudyMinutes} mins
            </div>
            <div className="text-[11px] text-slate-500">
              Across {attempts.length} quiz observations
            </div>
          </div>

          <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/90 space-y-1">
            <div className="flex items-center justify-between text-xs text-slate-500 font-semibold">
              <span>Learning Gaps Active</span>
              <Target className="w-4 h-4 text-rose-600" />
            </div>
            <div className="text-xl font-extrabold text-slate-900">
              {weakTopics.length} Weak • {uncertainTopics.length} Uncertain
            </div>
            <button
              type="button"
              onClick={() => onNavigateTab('gaps')}
              className="text-[11px] font-bold text-blue-900 hover:underline"
            >
              Inspect Evidence →
            </button>
          </div>
        </div>
      </div>

      {/* CENTRAL QUESTION & RECOMMENDED NEXT TOPIC HERO CARD */}
      <div className="bg-gradient-to-br from-blue-900 via-blue-900 to-indigo-950 rounded-2xl p-6 text-white shadow-lg space-y-4">
        <div className="flex flex-wrap items-center justify-between gap-2">
          <div className="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-400/20 text-sky-200 text-xs font-bold border border-sky-400/30">
            <Sparkles className="w-3.5 h-3.5" />
            What Should You Study Next? (Evidence-Driven Priority #1)
          </div>
          <button
            type="button"
            onClick={() => setShowWhyModal(!showWhyModal)}
            className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 text-xs font-bold text-white border border-white/20 transition"
          >
            <HelpCircle className="w-3.5 h-3.5 text-sky-300" />
            {showWhyModal ? 'Hide Explanation' : 'Why this recommendation?'}
          </button>
        </div>

        <div className="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div className="lg:col-span-8 space-y-2">
            <div className="text-xs font-bold text-sky-300 uppercase tracking-wider">
              {recommendation.subject} • {recommendation.chapter}
            </div>
            <h2 className="text-2xl sm:text-3xl font-extrabold">
              {recommendation.nextTopicTitle}
            </h2>
            <p className="text-sm text-blue-100 leading-relaxed">
              {recommendation.whyStudyNext}
            </p>
            <p className="text-xs text-sky-200">
              <strong>Current Evidence:</strong> {recommendation.evidenceSummary} (Mastery Score:{' '}
              {recommendation.score}% • {recommendation.confidence})
            </p>
          </div>

          <div className="lg:col-span-4 flex flex-col gap-2.5">
            {prereqTopic && (
              <button
                type="button"
                onClick={() =>
                  onOpenFoundationLesson(prereqTopic.id, recommendation.nextTopicId)
                }
                className="w-full px-4 py-3 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs flex items-center justify-center gap-2 shadow transition"
              >
                <Layers className="w-4 h-4" />
                Start Class {prereqTopic.classLevel} Foundation Bridge ({prereqTopic.estimatedMinutes}m)
              </button>
            )}
            <button
              type="button"
              onClick={() => onStartTopicLesson(recommendation.nextTopicId)}
              className="w-full px-4 py-3 rounded-xl bg-white hover:bg-blue-50 text-blue-950 font-extrabold text-xs flex items-center justify-center gap-2 shadow transition"
            >
              <BookOpen className="w-4 h-4" />
              Open {recommendation.nextTopicTitle} Lesson
            </button>
            <button
              type="button"
              onClick={() => onStartTargetedQuiz(recommendation.nextTopicId)}
              className="w-full px-4 py-2.5 rounded-xl bg-sky-500/20 hover:bg-sky-500/30 text-white border border-sky-400/40 font-bold text-xs flex items-center justify-center gap-2 transition"
            >
              <Play className="w-3.5 h-3.5" />
              Take Targeted Reassessment Quiz
            </button>
          </div>
        </div>

        {/* Expandable "Why this recommendation?" Evidence Drawer */}
        {showWhyModal && (
          <div className="p-4 rounded-xl bg-white/10 border border-white/20 text-xs space-y-2 mt-2">
            <div className="font-extrabold text-sky-200 uppercase tracking-wider">
              Explainable AI Recommendation Breakdown:
            </div>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <span className="font-bold text-white">1. What to study next:</span>
                <p className="text-blue-100 mt-0.5">
                  {prereqTopic
                    ? `First review Class ${prereqTopic.classLevel} "${prereqTopic.title}", then practice Class 8 "${recommendation.nextTopicTitle}".`
                    : `Focus on "${recommendation.nextTopicTitle}" (${recommendation.chapter}).`}
                </p>
              </div>
              <div>
                <span className="font-bold text-white">2. Why study it now:</span>
                <p className="text-blue-100 mt-0.5">{recommendation.whyStudyNext}</p>
              </div>
              <div>
                <span className="font-bold text-white">3. Supporting evidence:</span>
                <p className="text-blue-100 mt-0.5">{recommendation.evidenceSummary}</p>
              </div>
            </div>
          </div>
        )}
      </div>

      {/* Charts & Today's Study Plan Grid */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* Subject & Topic Mastery Chart */}
        <div className="lg:col-span-7 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
          <div className="flex items-center justify-between">
            <div>
              <h3 className="text-base font-extrabold text-slate-900">
                Topic-Wise Mastery Overview (%)
              </h3>
              <p className="text-xs text-slate-500">
                Combines answer accuracy and written reasoning verification
              </p>
            </div>
            <span className="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-lg">
              Target: 80%+
            </span>
          </div>

          <div className="relative h-64 w-full">
            <ResponsiveContainer width="100%" height="100%">
              <BarChart data={topicChartData} margin={{ top: 10, right: 16, left: -10, bottom: 10 }}>
                <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
                <XAxis dataKey="name" tick={{ fontSize: 11, fill: '#475569' }} />
                <YAxis domain={[0, 100]} tick={{ fontSize: 11, fill: '#475569' }} />
                <Tooltip />
                <Bar dataKey="score" name="Mastery Score (%)" fill="#1e3a8a" radius={[6, 6, 0, 0]} />
              </BarChart>
            </ResponsiveContainer>
          </div>
        </div>

        {/* Today's Adaptive Study Plan */}
        <div className="lg:col-span-5 bg-white rounded-2xl border border-slate-200 p-6 shadow-sm flex flex-col justify-between space-y-4">
          <div className="space-y-3">
            <div className="flex items-center justify-between">
              <div>
                <h3 className="text-base font-extrabold text-slate-900">
                  Today&rsquo;s Study Plan ({student.dailyGoalMinutes}m)
                </h3>
                <p className="text-xs text-slate-500">
                  Check off tasks to build your daily goal &amp; streak
                </p>
              </div>
              <button
                type="button"
                onClick={() => onNavigateTab('planner')}
                className="text-xs font-bold text-blue-900 hover:underline"
              >
                Full Planner →
              </button>
            </div>

            <div className="space-y-2.5">
              {tasks.map((task) => {
                const done = task.completionStatus === 'completed';
                return (
                  <div
                    key={task.id}
                    className={`p-3 rounded-xl border flex items-center justify-between gap-3 ${
                      done
                        ? 'bg-emerald-50/60 border-emerald-200'
                        : 'bg-slate-50 border-slate-200'
                    }`}
                  >
                    <div className="min-w-0">
                      <div
                        className={`text-xs font-bold truncate ${
                          done ? 'line-through text-slate-400' : 'text-slate-900'
                        }`}
                      >
                        {task.title}
                      </div>
                      <div className="text-[11px] text-slate-500">
                        {task.estimatedMinutes} mins • {task.priority} Priority
                      </div>
                    </div>
                    <button
                      type="button"
                      onClick={() => onToggleTaskComplete(task.id)}
                      className={`shrink-0 px-3 py-1.5 rounded-lg text-xs font-bold transition ${
                        done
                          ? 'bg-emerald-600 text-white'
                          : 'bg-white hover:bg-blue-50 text-blue-900 border border-slate-300'
                      }`}
                    >
                      {done ? 'Done ✓' : 'Complete'}
                    </button>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Recent Quiz Results */}
          <div className="pt-3 border-t border-slate-100 space-y-2">
            <div className="text-xs font-extrabold uppercase tracking-wider text-slate-500">
              Latest Quiz Observations ({attempts.length})
            </div>
            <div className="space-y-1.5 max-h-32 overflow-y-auto">
              {attempts
                .slice(-3)
                .reverse()
                .map((att) => {
                  const t = topics.find((x) => x.id === att.topicId);
                  return (
                    <div
                      key={att.id}
                      className="text-xs flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-200/70"
                    >
                      <span className="font-semibold text-slate-800 truncate pr-2">
                        {t?.title || att.topicId}
                      </span>
                      <span
                        className={`shrink-0 px-2 py-0.5 rounded font-bold text-[10px] ${
                          att.isCorrect && att.reasoningQuality === 'strong'
                            ? 'bg-emerald-100 text-emerald-800'
                            : att.isCorrect
                            ? 'bg-amber-100 text-amber-900'
                            : 'bg-rose-100 text-rose-800'
                        }`}
                      >
                        {att.isCorrect
                          ? att.reasoningQuality === 'strong'
                            ? 'Correct + Strong Reasoning'
                            : 'Correct (Uncertain Reasoning)'
                          : 'Needs Review'}
                      </span>
                    </div>
                  );
                })}
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

interface ProgressAnalyticsViewProps {
  student: Student;
  topics: Topic[];
  masteryMap: Record<string, TopicMastery>;
  attempts: QuizAttempt[];
}

const ProgressAnalyticsView: React.FC<ProgressAnalyticsViewProps> = ({
  student,
  topics,
  masteryMap,
  attempts,
}) => {
  const coreTopics = topics.filter((t) => !t.isFoundationTopic);
  const subjectData = student.selectedSubjects.map((subj) => {
    const relevant = coreTopics.filter((t) => t.subject === subj);
    const avg =
      relevant.length > 0
        ? Math.round(
            relevant.reduce((acc, t) => acc + (masteryMap[t.id]?.performanceScore ?? 0), 0) /
              relevant.length
          )
        : 0;
    return { subject: subj, mastery: avg };
  });

  return (
    <div className="space-y-6">
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
          Evidence &amp; Mastery Analytics
        </span>
        <h2 className="text-2xl font-extrabold text-slate-900">
          Subject &amp; Reasoning Progress Report
        </h2>
        <div className="relative h-64 w-full">
          <ResponsiveContainer width="100%" height="100%">
            <BarChart data={subjectData} margin={{ top: 10, right: 20, left: 0, bottom: 10 }}>
              <CartesianGrid strokeDasharray="3 3" stroke="#e2e8f0" />
              <XAxis dataKey="subject" tick={{ fontSize: 12, fill: '#334155' }} />
              <YAxis domain={[0, 100]} tick={{ fontSize: 12, fill: '#334155' }} />
              <Tooltip />
              <Bar dataKey="mastery" name="Subject Mastery (%)" fill="#0284c7" radius={[8, 8, 0, 0]} />
            </BarChart>
          </ResponsiveContainer>
        </div>
      </div>

      {/* Attempt Audit Log */}
      <div className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-4">
        <h3 className="text-base font-extrabold text-slate-900">
          Complete Diagnostic &amp; Practice Reasoning Log ({attempts.length})
        </h3>
        <div className="space-y-3">
          {attempts
            .slice()
            .reverse()
            .map((a) => {
              const t = topics.find((x) => x.id === a.topicId);
              return (
                <div
                  key={a.id}
                  className="p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs"
                >
                  <div className="space-y-1">
                    <div className="font-bold text-slate-900">
                      {t?.title || a.topicId} ({a.subject})
                    </div>
                    <p className="text-slate-600">{a.interpretationLabel}</p>
                    {a.reasoningText && (
                      <p className="text-slate-500 italic">
                        Reasoning: &ldquo;{a.reasoningText}&rdquo;
                      </p>
                    )}
                  </div>
                  <div className="shrink-0 flex items-center gap-2">
                    <span className="px-2.5 py-1 rounded bg-white border border-slate-200 font-semibold">
                      Confidence: {a.confidenceRating}
                    </span>
                    <span className="px-2.5 py-1 rounded bg-white border border-slate-200 font-semibold">
                      Hints: {a.hintCount}
                    </span>
                  </div>
                </div>
              );
            })}
        </div>
      </div>
    </div>
  );
};

interface ProfileSettingsViewProps {
  student: Student;
  onUpdateStudent: (updated: Student) => void;
  onResetToOnboarding: () => void;
  onReloadClass8Demo: () => void;
}

const ProfileSettingsView: React.FC<ProfileSettingsViewProps> = ({
  student,
  onUpdateStudent,
  onResetToOnboarding,
  onReloadClass8Demo,
}) => {
  const [name, setName] = useState(student.displayName);
  const [cls, setCls] = useState<ClassLevel>(student.classLevel);
  const [mins, setMins] = useState<number>(student.dailyGoalMinutes);
  const [goal, setGoal] = useState<string>(student.learningGoal);
  const [savedBanner, setSavedBanner] = useState<boolean>(false);

  const handleSave = (e: React.FormEvent) => {
    e.preventDefault();
    onUpdateStudent({
      ...student,
      displayName: name.trim() || 'Student',
      classLevel: cls,
      dailyGoalMinutes: mins,
      learningGoal: goal,
    });
    setSavedBanner(true);
    setTimeout(() => setSavedBanner(false), 3000);
  };

  return (
    <div className="max-w-3xl space-y-6">
      <form
        onSubmit={handleSave}
        className="bg-white rounded-2xl border border-slate-200 p-6 shadow-sm space-y-5"
      >
        <div>
          <span className="text-xs font-bold uppercase tracking-wider text-sky-600">
            Student Preferences &amp; Schedule Configuration
          </span>
          <h2 className="text-2xl font-extrabold text-slate-900">
            Profile &amp; Learning Settings
          </h2>
        </div>

        {savedBanner && (
          <div className="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 text-xs font-bold">
            ✓ Settings saved! Your adaptive study plan and daily goal have been updated.
          </div>
        )}

        <div className="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div>
            <label className="block font-bold text-slate-700 mb-1">Display Name</label>
            <input
              type="text"
              value={name}
              onChange={(e) => setName(e.target.value)}
              className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-medium"
            />
          </div>
          <div>
            <label className="block font-bold text-slate-700 mb-1">Class (6–10)</label>
            <select
              value={cls}
              onChange={(e) => setCls(Number(e.target.value) as ClassLevel)}
              className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-semibold bg-white"
            >
              {[6, 7, 8, 9, 10].map((c) => (
                <option key={c} value={c}>
                  Class {c} (CBSE)
                </option>
              ))}
            </select>
          </div>
          <div>
            <label className="block font-bold text-slate-700 mb-1">
              Daily Study Duration Goal (Mins)
            </label>
            <input
              type="number"
              min={15}
              max={180}
              step={5}
              value={mins}
              onChange={(e) => setMins(Number(e.target.value))}
              className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-semibold"
            />
          </div>
          <div>
            <label className="block font-bold text-slate-700 mb-1">Learning Goal</label>
            <input
              type="text"
              value={goal}
              onChange={(e) => setGoal(e.target.value)}
              className="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 font-medium"
            />
          </div>
        </div>

        <div className="flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-slate-100">
          <div className="flex flex-wrap gap-2">
            <button
              type="button"
              onClick={onResetToOnboarding}
              className="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-bold text-xs hover:bg-slate-100"
            >
              Restart Onboarding Wizard
            </button>
            <button
              type="button"
              onClick={onReloadClass8Demo}
              className="px-4 py-2 rounded-xl bg-sky-50 text-sky-900 border border-sky-200 font-bold text-xs hover:bg-sky-100"
            >
              Reset to Default Class 8 Demo State
            </button>
          </div>
          <button
            type="submit"
            className="px-6 py-2.5 rounded-xl bg-blue-900 hover:bg-blue-800 text-white font-bold text-xs shadow"
          >
            Save Changes
          </button>
        </div>
      </form>
    </div>
  );
};


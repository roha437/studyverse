import { addDays, dateKeyInZone } from './dates'
import type { Activity } from './types'

export const MILESTONES = [
  { days: 10, id: 'bronze', name: 'Bronze Learner', cosmetic: 'Bronze profile ring', tone: 'bronze' },
  { days: 50, id: 'silver', name: 'Silver Scholar', cosmetic: 'Silver dashboard theme accent', tone: 'silver' },
  { days: 100, id: 'gold', name: 'Gold Scholar', cosmetic: 'Gold scholar crest', tone: 'gold' },
] as const

export type Milestone = (typeof MILESTONES)[number]
export type EarnedReward = { milestone: Milestone; earnedOn: string }
export type DayTotal = { minutes: number; goal: number; items: Activity[] }

export function dailyTotals(activities: Activity[], timeZone: string, today: string, currentGoal: number) {
  const totals = new Map<string, DayTotal>()
  for (const a of [...activities].sort((x, y) => x.at.localeCompare(y.at))) {
    const key = dateKeyInZone(new Date(a.at), timeZone)
    const entry = totals.get(key) ?? { minutes: 0, goal: a.goalMinutes, items: [] }
    entry.minutes += a.minutes
    entry.goal = a.goalMinutes
    entry.items.push(a)
    totals.set(key, entry)
  }
  const todayEntry = totals.get(today)
  if (todayEntry) todayEntry.goal = currentGoal
  return totals
}

export function computeStreak(activities: Activity[], timeZone: string, today: string, currentGoal: number) {
  const totals = dailyTotals(activities, timeZone, today, currentGoal)
  const met = (key: string) => {
    const d = totals.get(key)
    return !!d && d.minutes >= d.goal
  }

  let current = 0
  let cursor = met(today) ? today : addDays(today, -1)
  while (met(cursor)) {
    current++
    cursor = addDays(cursor, -1)
  }

  const metDays = [...totals.keys()].filter(met).sort()
  const runs: { start: string; end: string; length: number }[] = []
  for (const key of metDays) {
    const last = runs[runs.length - 1]
    if (last && addDays(last.end, 1) === key) {
      last.end = key
      last.length++
    } else {
      runs.push({ start: key, end: key, length: 1 })
    }
  }

  const earned = new Map<string, EarnedReward>()
  for (const run of runs) {
    for (const m of MILESTONES) {
      if (run.length >= m.days && !earned.has(m.id)) earned.set(m.id, { milestone: m, earnedOn: addDays(run.start, m.days - 1) })
    }
  }

  const todayMinutes = totals.get(today)?.minutes ?? 0
  return {
    current,
    longest: runs.reduce((max, r) => Math.max(max, r.length), 0),
    todayMinutes,
    todayGoal: currentGoal,
    todayMet: met(today),
    totals,
    met,
    rewards: [...earned.values()],
    next: MILESTONES.find((m) => m.days > current),
  }
}

export type StreakInfo = ReturnType<typeof computeStreak>


'use client'

import { useState } from 'react'
import {
  ArrowRight,
  Bell,
  BookOpen,
  BrainCircuit,
  Check,
  ChevronDown,
  CircleHelp,
  Clock3,
  Flame,
  Home,
  Lightbulb,
  Menu,
  MessageCircleQuestion,
  Play,
  Plus,
  Search,
  Sparkles,
  Target,
  Trophy,
  X,
  ScanSearch,
  CalendarDays,
  Upload,
} from 'lucide-react'
import { StudyVerseProvider, useStudyVerse } from '@/components/studyverse/store'
import { Overview } from '@/components/studyverse/overview'
import { LearningGaps } from '@/components/studyverse/learning-gaps'
import { StudyPlanner } from '@/components/studyverse/study-planner'
import { PracticeQuiz } from '@/components/studyverse/practice-quiz'
import { Achievements, Celebration } from '@/components/studyverse/achievements'
import { UploadResources } from '@/components/studyverse/upload-resources'
import { HeaderDate, SidebarStreak } from '@/components/studyverse/shell-widgets'
import type { NavLabel } from '@/components/studyverse/ui'

type NavItem = { label: string; icon: typeof Home }

const navItems: NavItem[] = [
  { label: 'Overview', icon: Home },
  { label: 'My Learning', icon: BookOpen },
  { label: 'Learning Gaps', icon: ScanSearch },
  { label: 'Study Planner', icon: CalendarDays },
  { label: 'Practice', icon: BrainCircuit },
  { label: 'Ask a Doubt', icon: MessageCircleQuestion },
  { label: 'Upload Resources', icon: Upload },
]

const chapters = [
  { name: 'Crop Production and Management', subject: 'Science', progress: 82, color: 'bg-[#e7f1ec]', accent: 'text-[#377b60]', status: 'In progress' },
  { name: 'Microorganisms: Friend and Foe', subject: 'Science', progress: 38, color: 'bg-[#eee9f9]', accent: 'text-[#7460a9]', status: 'Next up' },
  { name: 'Comparing Quantities', subject: 'Mathematics', progress: 14, color: 'bg-[#fff0e3]', accent: 'text-[#bd7640]', status: 'Needs attention' },
]

function Landing({ onStart }: { onStart: () => void }) {
  return <div className="min-h-screen bg-[#f6f9fc] text-[#26312d]"><header className="flex items-center justify-between px-6 py-5 md:px-14"><div className="flex items-center gap-3"><span className="grid h-10 w-10 place-items-center rounded-xl bg-[#dff2e9] text-[#2e8a64]"><Sparkles size={20} /></span><span className="font-serif text-2xl font-semibold">Study<span className="text-[#247eb7]">Verse</span></span></div><button onClick={onStart} className="rounded-xl bg-[#174a7e] px-4 py-2.5 text-sm font-semibold text-white">Start learning</button></header><main><section className="mx-auto grid max-w-6xl items-center gap-12 px-6 pb-20 pt-16 md:grid-cols-2 md:px-14 md:pt-24"><div><p className="mb-5 text-xs font-bold uppercase tracking-[0.2em] text-[#4e9a72]">Learn smarter. Improve faster.</p><h1 className="font-serif text-5xl font-semibold leading-[1.05] tracking-tight text-[#243b52] md:text-7xl">Know what to study <span className="text-[#247eb7]">next.</span></h1><p className="mt-6 max-w-lg text-base leading-8 text-[#718096]">StudyVerse turns your textbook, practice, and quiz patterns into a clear learning path — so every study session has a purpose.</p><div className="mt-8 flex flex-wrap gap-3"><button onClick={onStart} className="flex items-center gap-2 rounded-xl bg-[#174a7e] px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-[#174a7e]/15">Start learning <ArrowRight size={16} /></button><button onClick={() => document.getElementById('features')?.scrollIntoView({ behavior: 'smooth' })} className="rounded-xl border border-[#dce7ef] bg-white px-5 py-3.5 text-sm font-semibold text-[#557086]">Explore features</button></div></div><div className="rounded-[2rem] border border-[#dbe8e5] bg-white p-5 shadow-2xl shadow-[#174a7e]/10"><div className="rounded-2xl bg-[#f1f8f4] p-5"><div className="flex items-center justify-between"><span className="text-xs font-semibold text-[#4e9a72]">Your next best step</span><Sparkles size={16} className="text-[#63ad86]" /></div><h3 className="mt-5 font-serif text-2xl font-semibold text-[#304039]">Microorganisms: Friend and Foe</h3><p className="mt-2 text-xs leading-5 text-[#829087]">Builds on your recent work with crop production.</p><div className="mt-5 h-2 rounded-full bg-[#d7e9dc]"><div className="h-full w-[38%] rounded-full bg-[#61ae83]" /></div><button onClick={onStart} className="mt-5 flex w-full items-center justify-between rounded-xl bg-white px-4 py-3 text-xs font-semibold text-[#418762]">Continue learning <ArrowRight size={15} /></button></div><div className="mt-4 grid grid-cols-3 gap-3 text-center"><div className="rounded-xl bg-[#eee9f9] p-3"><p className="text-xl font-semibold text-[#62548e]">24</p><p className="mt-1 text-[10px] text-[#8c82ae]">mastered</p></div><div className="rounded-xl bg-[#fff0e1] p-3"><p className="text-xl font-semibold text-[#9b663c]">68%</p><p className="mt-1 text-[10px] text-[#bb8861]">progress</p></div><div className="rounded-xl bg-[#e5f2eb] p-3"><p className="text-xl font-semibold text-[#377b60]">5 days</p><p className="mt-1 text-[10px] text-[#5c9f7a]">streak</p></div></div></div></section><section id="features" className="mx-auto max-w-6xl px-6 pb-24 md:px-14"><p className="text-center text-xs font-bold uppercase tracking-[0.2em] text-[#4e9a72]">A better learning loop</p><h2 className="mx-auto mt-3 max-w-2xl text-center font-serif text-4xl font-semibold text-[#243b52]">Learn → Practise → Assess → Improve</h2><div className="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">{['AI Tutor','Smart Quizzes','Explainable weakness detection','Prerequisite learning','Adaptive study planner','Learning streaks'].map((feature, i) => <div key={feature} className="rounded-2xl border border-[#e1e9ef] bg-white p-5"><span className="grid h-9 w-9 place-items-center rounded-xl bg-[#e9f3fb] text-[#247eb7]"><Sparkles size={16} /></span><h3 className="mt-4 font-semibold text-[#304039]">{feature}</h3><p className="mt-2 text-xs leading-5 text-[#849199]">Textbook-grounded guidance that adapts to how you learn.</p></div>)}</div></section></main></div>
}

function Onboarding({ onComplete }: { onComplete: (choices: { className: string; board: string; subjects: string[] }) => void }) {
  const [step, setStep] = useState(1)
  const [selected, setSelected] = useState<string[]>(['Science'])
  const subjects = ['Mathematics', 'Science', 'English', 'Social Science']
  const titles = ['Which class are you in?', 'Choose your education board', 'What would you like to learn?', 'Which subjects feel tricky?', 'Set your learning preferences', 'Your personalized diagnostic']
  const toggle = (item: string) => setSelected((current) => current.includes(item) ? current.filter((x) => x !== item) : [...current, item])
  return <div className="min-h-screen bg-[#f6f9fc] px-5 py-8 text-[#26312d] md:px-10"><div className="mx-auto max-w-2xl"><div className="flex items-center justify-between"><div className="font-serif text-2xl font-semibold">Study<span className="text-[#247eb7]">Verse</span></div><span className="text-xs font-semibold text-[#829087]">Step {step} of 6</span></div><div className="mt-8 flex gap-2">{Array.from({ length: 6 }).map((_, i) => <span key={i} className={`h-1.5 flex-1 rounded-full ${i < step ? 'bg-[#247eb7]' : 'bg-[#dce8ef]'}`} />)}</div><section className="mt-14 rounded-3xl border border-[#e1e9ef] bg-white p-7 shadow-sm md:p-10"><p className="text-xs font-bold uppercase tracking-[0.2em] text-[#4e9a72]">Personalize your path</p><h1 className="mt-3 font-serif text-4xl font-semibold text-[#243b52]">{titles[step - 1]}</h1><p className="mt-3 text-sm leading-6 text-[#829087]">{step === 4 ? 'Choose any subjects you want us to prioritize. You can skip this and we will still detect gaps through your quizzes.' : step === 6 ? 'A short combined quiz helps us understand what you truly know before making recommendations.' : 'You can edit these choices anytime from your profile.'}</p>{step <= 2 && <div className="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">{(step === 1 ? ['Class 6','Class 7','Class 8','Class 9','Class 10'] : ['CBSE','ICSE','State board']).map((item) => <button key={item} onClick={() => toggle(item)} className={`rounded-2xl border p-4 text-left text-sm font-semibold ${selected.includes(item) || (step === 2 && item === 'CBSE') ? 'border-[#63ad86] bg-[#eef8f1] text-[#377b60]' : 'border-[#e1e9ef] text-[#718096]'}`}>{item}{step === 2 && item !== 'CBSE' && <span className="mt-1 block text-[10px] font-normal text-[#a2aba5]">Coming later</span>}</button>)}</div>}{step === 3 || step === 4 ? <div className="mt-8 grid gap-3 sm:grid-cols-2">{subjects.map((item) => <button key={item} onClick={() => toggle(item)} className={`rounded-2xl border p-4 text-left text-sm font-semibold ${selected.includes(item) ? 'border-[#63ad86] bg-[#eef8f1] text-[#377b60]' : 'border-[#e1e9ef] text-[#718096]'}`}>{selected.includes(item) && <Check size={16} className="mr-2 inline" />}{item}</button>)}</div> : null}{step === 5 && <div className="mt-8 grid gap-3 sm:grid-cols-2">{['20 minutes','30 minutes','45 minutes','1 hour'].map((item) => <button key={item} onClick={() => toggle(item)} className="rounded-2xl border border-[#e1e9ef] p-4 text-left text-sm font-semibold text-[#718096] hover:border-[#63ad86]">{item}</button>)}</div>}{step === 6 && <div className="mt-8 rounded-2xl bg-[#f1f8f4] p-5"><div className="flex items-center gap-3"><BrainCircuit className="text-[#4e9a72]" /><div><p className="font-semibold text-[#304039]">Combined Class 8 diagnostic</p><p className="mt-1 text-xs text-[#829087]">Science + Mathematics · 12 questions · about 10 minutes</p></div></div></div>}<div className="mt-10 flex items-center justify-between gap-3"><button onClick={() => step === 4 ? setStep(5) : setStep(Math.max(1, step - 1))} className="text-sm font-semibold text-[#829087]">{step === 1 ? 'Back to home' : 'Back'}</button><div className="flex items-center gap-3">{step === 4 && <button onClick={() => setStep(5)} className="text-sm font-semibold text-[#4e9a72]">Skip for now</button>}<button onClick={() => step === 6 ? onComplete({ className: 'Class 8', board: 'CBSE', subjects: selected }) : setStep(step + 1)} className="flex items-center gap-2 rounded-xl bg-[#174a7e] px-5 py-3 text-sm font-semibold text-white">{step === 6 ? 'Start diagnostic' : 'Continue'} <ArrowRight size={16} /></button></div></div></section></div></div>
}

type DiagnosticQuestion = {
  subject: string
  topic: string
  question: string
  options: string[]
  answer: number
  explanation: string
  prerequisite: string
}

const diagnosticQuestions: DiagnosticQuestion[] = [
  { subject: 'Mathematics', topic: 'Comparing quantities', question: 'Which fraction is equivalent to 3/4?', options: ['6/8', '4/6', '9/16', '12/20'], answer: 0, explanation: 'Multiplying both numerator and denominator by 2 gives 6/8, which has the same value as 3/4.', prerequisite: 'Fractions and equivalent fractions' },
  { subject: 'Science', topic: 'Microorganisms', question: 'Which microorganism is commonly used to make bread rise?', options: ['Algae', 'Yeast', 'Virus', 'Protozoa'], answer: 1, explanation: 'Yeast releases carbon dioxide during fermentation. The gas gets trapped in the dough and makes it rise.', prerequisite: 'Useful microorganisms' },
  { subject: 'Mathematics', topic: 'Linear equations', question: 'If x + 7 = 12, what is x?', options: ['3', '5', '7', '19'], answer: 1, explanation: 'Subtract 7 from both sides: x = 12 − 7 = 5.', prerequisite: 'Operations with integers' },
]

function DiagnosticQuiz({ profile, onComplete }: { profile: { className: string; board: string; subjects: string[] }; onComplete: () => void }) {
  const [questionIndex, setQuestionIndex] = useState(0)
  const [selected, setSelected] = useState<number | null>(null)
  const [submitted, setSubmitted] = useState(false)
  const [reasoning, setReasoning] = useState('')
  const [confidence, setConfidence] = useState('Medium')
  const [hintLevel, setHintLevel] = useState(0)
  const [results, setResults] = useState<{ correct: boolean; explained: boolean; hintsUsed: number }[]>([])
  const question = diagnosticQuestions[questionIndex]
  const hintSteps = [
    `Concept clue: connect this question to ${question.prerequisite.toLowerCase()}.`,
    `Principle prompt: recall the rule or relationship that helps with ${question.topic.toLowerCase()}.`,
    `Scaffold: work through the options one step at a time, then check which choice matches the principle.`,
  ]
  const hintUsed = hintLevel > 0
  const showNextHint = () => setHintLevel((level) => Math.min(level + 1, hintSteps.length))
  const answered = submitted && selected !== null
  const submit = () => { if (selected !== null) setSubmitted(true) }
  const next = () => {
    if (selected === null) return
    setResults((items) => [...items, { correct: selected === question.answer, explained: reasoning.trim().length >= 18, hintsUsed: hintLevel }])
    if (questionIndex === diagnosticQuestions.length - 1) onComplete()
    else { setQuestionIndex((value) => value + 1); setSelected(null); setSubmitted(false); setReasoning(''); setConfidence('Medium'); setHintLevel(0) }
  }
  return <div className="min-h-screen bg-[#f6f9fc] px-5 py-8 text-[#26312d] md:px-10"><div className="mx-auto max-w-3xl"><div className="flex items-center justify-between"><div className="font-serif text-2xl font-semibold">Study<span className="text-[#247eb7]">Verse</span></div><span className="rounded-full bg-[#e8f5ee] px-3 py-1 text-xs font-semibold text-[#37815e]">Demo diagnostic mode</span></div><div className="mt-10 flex items-center justify-between text-xs font-semibold text-[#829087]"><span>Question {questionIndex + 1} of {diagnosticQuestions.length}</span><span>{profile.className} · {profile.board}</span></div><div className="mt-3 h-2 rounded-full bg-[#dce8ef]"><div className="h-full rounded-full bg-[#247eb7] transition-all" style={{ width: `${((questionIndex + 1) / diagnosticQuestions.length) * 100}%` }} /></div><section className="mt-8 rounded-3xl border border-[#e1e9ef] bg-white p-7 shadow-sm md:p-10"><div className="flex flex-wrap gap-2"><span className="rounded-full bg-[#eaf5fb] px-3 py-1 text-[11px] font-semibold text-[#247eb7]">{question.subject}</span><span className="rounded-full bg-[#f0f6f1] px-3 py-1 text-[11px] font-semibold text-[#4e9a72]">{question.topic}</span></div><h1 className="mt-6 font-serif text-3xl font-semibold leading-tight text-[#243b52] md:text-4xl">{question.question}</h1><div className="mt-7 grid gap-3">{question.options.map((option, index) => <button key={option} onClick={() => !submitted && setSelected(index)} className={`flex items-center gap-3 rounded-2xl border p-4 text-left text-sm transition ${selected === index ? 'border-[#247eb7] bg-[#eaf5fb] text-[#174a7e]' : 'border-[#e1e9ef] text-[#718096] hover:border-[#a9c9dd]'} ${submitted && index === question.answer ? 'border-[#63ad86] bg-[#eef8f1] text-[#377b60]' : ''}`}><span className="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-[#f1f5f8] text-xs font-semibold">{String.fromCharCode(65 + index)}</span>{option}</button>)}</div><div className="mt-6 flex flex-wrap items-center gap-3"><button onClick={() => showNextHint()} className="flex items-center gap-2 rounded-xl border border-[#e2eaf2] px-3 py-2 text-xs font-semibold text-[#8a7653]"><Lightbulb size={14} />{hintUsed ? 'Hint used: think about the process' : 'Need a hint?'}</button><label className="ml-auto flex items-center gap-2 text-xs text-[#829087]">Confidence<select value={confidence} onChange={(event) => setConfidence(event.target.value)} className="rounded-lg border border-[#e1e9ef] bg-white px-2 py-1 text-xs"><option>Low</option><option>Medium</option><option>High</option></select></label></div>{!submitted ? <button onClick={submit} disabled={selected === null} className="mt-7 w-full rounded-xl bg-[#174a7e] px-4 py-3 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-40">Submit answer</button> : <div className="mt-7 rounded-2xl bg-[#f7faf7] p-5"><p className="text-sm font-semibold text-[#377b60]">{selected === question.answer ? 'Correct answer. Now show your thinking.' : 'Let’s inspect the misconception.'}</p><p className="mt-2 text-xs leading-5 text-[#718096]">{question.explanation}</p><label className="mt-5 block text-xs font-semibold text-[#526057]">Can you explain why this answer is correct?<textarea value={reasoning} onChange={(event) => setReasoning(event.target.value)} placeholder="Write a short explanation in your own words…" className="mt-2 min-h-24 w-full resize-none rounded-xl border border-[#dfe8e2] bg-white p-3 text-sm font-normal outline-none focus:border-[#63ad86]" /></label><p className="mt-3 text-[11px] leading-5 text-[#99a39d]">We score your answer and explanation separately. A correct choice without a clear explanation is marked as uncertain understanding.</p><button onClick={next} className="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-[#174a7e] px-4 py-3 text-sm font-semibold text-white">{questionIndex === diagnosticQuestions.length - 1 ? 'See my diagnostic report' : 'Submit reasoning'} <ArrowRight size={15} /></button></div>}</section><p className="mt-5 text-center text-[11px] leading-5 text-[#9aa49e]">Your responses, hint usage, confidence, topic, and prerequisite context are saved for this demo session. Natural-language evaluation requires an AI backend.</p></div></div>
}

function DiagnosticReport({ onContinue }: { onContinue: () => void }) {
  return <div className="min-h-screen bg-[#f6f9fc] px-5 py-8 text-[#26312d] md:px-10"><div className="mx-auto max-w-4xl"><div className="flex items-center justify-between"><div className="font-serif text-2xl font-semibold">Study<span className="text-[#247eb7]">Verse</span></div><span className="rounded-full bg-[#e8f5ee] px-3 py-1 text-xs font-semibold text-[#37815e]">Diagnostic report</span></div><section className="mt-12"><p className="text-xs font-bold uppercase tracking-[0.2em] text-[#4e9a72]">Your starting point</p><h1 className="mt-3 font-serif text-4xl font-semibold text-[#243b52] md:text-5xl">Here&apos;s what we&apos;ll focus on next.</h1><p className="mt-4 max-w-2xl text-sm leading-7 text-[#718096]">This transparent demo report uses answer correctness and explanation quality as separate signals. It does not claim definitive mastery from one question.</p><div className="mt-8 grid gap-4 md:grid-cols-3"><div className="rounded-2xl bg-[#dff2e9] p-5"><p className="text-xs font-semibold text-[#4c8d6b]">Overall score</p><p className="mt-3 text-4xl font-semibold text-[#2e7655]">67%</p><p className="mt-2 text-xs text-[#63a57e]">Moderate evidence strength</p></div><div className="rounded-2xl bg-[#eee9f9] p-5"><p className="text-xs font-semibold text-[#7769a1]">Demonstrated understanding</p><p className="mt-3 text-2xl font-semibold text-[#62548e]">1 topic</p><p className="mt-2 text-xs text-[#8c82ae]">Science · microorganisms</p></div><div className="rounded-2xl bg-[#fff0e1] p-5"><p className="text-xs font-semibold text-[#ae7444]">Needs evidence</p><p className="mt-3 text-2xl font-semibold text-[#9b663c]">2 topics</p><p className="mt-2 text-xs text-[#bb8861]">Fractions · equations</p></div></div><div className="mt-6 grid gap-4 md:grid-cols-2"><article className="rounded-2xl border border-[#e5eae5] bg-white p-6"><p className="text-xs font-bold uppercase tracking-[0.16em] text-[#b07845]">Uncertain understanding</p><h2 className="mt-3 font-serif text-2xl font-semibold text-[#34433b]">Fractions and equivalent fractions</h2><p className="mt-3 text-sm leading-6 text-[#7d8982]">We need a clearer explanation or another question before calling this mastered. Hint use and confidence are context, not penalties.</p></article><article className="rounded-2xl border border-[#e5eae5] bg-white p-6"><p className="text-xs font-bold uppercase tracking-[0.16em] text-[#247eb7]">Potential prerequisite gap</p><h2 className="mt-3 font-serif text-2xl font-semibold text-[#34433b]">Operations with integers</h2><p className="mt-3 text-sm leading-6 text-[#7d8982]">We&apos;ll revisit this foundation before linear equations and explain each recommendation as your evidence changes.</p></article></div><button onClick={onContinue} className="mt-8 flex items-center gap-2 rounded-xl bg-[#174a7e] px-5 py-3.5 text-sm font-semibold text-white">Open my personalized dashboard <ArrowRight size={16} /></button></section></div></div>
}

const prerequisiteTopics = [
  { title: 'Fractions and equivalent fractions', current: 'Comparing Quantities', foundation: 'Class 6 · Mathematics · Fractions', why: 'Percentages and ratios are built from fraction relationships.', time: '12 min', evidence: 'Quiz signal: 42% accuracy', status: 'Needs review' },
  { title: 'Operations with integers', current: 'Linear Equations', foundation: 'Class 7 · Mathematics · Integers', why: 'Balancing an equation depends on undoing operations confidently.', time: '8 min', evidence: 'Explanation signal: incomplete reasoning', status: 'Recommended' },
]

function FoundationCard({ topic, onNotify }: { topic: typeof prerequisiteTopics[number]; onNotify: (message: string) => void }) {
  const [expanded, setExpanded] = useState(false)
  return <article className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-6"><div className="flex items-start gap-3"><span className="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-[#fff0e1] text-[#c6814f]"><BrainCircuit size={19} /></span><div className="min-w-0 flex-1"><div className="flex flex-wrap items-center gap-2"><span className="text-[10px] font-bold uppercase tracking-[0.16em] text-[#b07845]">Foundation gap</span><span className="rounded-full bg-[#f7f2e9] px-2 py-1 text-[10px] font-semibold text-[#a47b3e]">{topic.status}</span></div><h3 className="mt-2 font-serif text-xl font-semibold text-[#34433b]">{topic.title}</h3><p className="mt-1 text-xs text-[#87928a]">Needed for <span className="font-semibold text-[#617168]">{topic.current}</span> · {topic.foundation}</p></div></div><div className="mt-5 rounded-xl bg-[#fffaf4] p-4"><p className="text-sm font-semibold text-[#755b3d]">Let&apos;s strengthen your basics first.</p><p className="mt-1 text-xs leading-5 text-[#927b60]">{topic.why}</p><div className="mt-3 flex flex-wrap gap-3 text-[11px] text-[#a18058]"><span>{topic.time} lesson</span><span>{topic.evidence}</span></div></div><div className="mt-4 flex flex-wrap gap-2"><button onClick={() => onNotify(`Foundation lesson started: ${topic.title}`)} className="rounded-xl bg-[#174a7e] px-4 py-2.5 text-xs font-semibold text-white">Start foundation lesson</button><button onClick={() => { setExpanded(!expanded); onNotify(expanded ? 'Foundation details hidden' : 'Evidence details opened') }} className="rounded-xl border border-[#e2e8e2] px-4 py-2.5 text-xs font-semibold text-[#65756b]">{expanded ? 'Hide evidence' : 'Why was this recommended?'}</button><button onClick={() => onNotify(`Skipped ${topic.title}; evidence saved`)} className="px-2 py-2 text-xs font-semibold text-[#6a9b7d]">I know this already</button></div>{expanded && <div className="mt-4 border-t border-[#eef1ed] pt-4 text-xs leading-5 text-[#78877e]">StudyVerse combines correctness, confidence, and explanation quality. Your saved evidence stays attached to this topic if you skip the lesson.</div>}</article>
}

function LearningWorkspace({ onNotify }: { onNotify: (message: string) => void }) {
  return <section className="min-h-[70vh]"><p className="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6aaa89]">StudyVerse · My Learning</p><h1 className="font-serif text-4xl font-semibold text-[#25332c] md:text-5xl">Your learning journey</h1><p className="mt-4 max-w-2xl text-sm leading-7 text-[#7d8982]">Go deeper than a chapter list. When a topic depends on an earlier idea, we show the connection and let you strengthen it without losing your place.</p><div className="mt-8 rounded-2xl border border-[#d9e8e0] bg-[#eef8f1] p-5"><div className="flex items-start gap-3"><span className="grid h-9 w-9 place-items-center rounded-xl bg-white text-[#3e9368]"><Sparkles size={17} /></span><div><p className="text-sm font-semibold text-[#356f53]">Two learning paths are ready</p><p className="mt-1 text-xs leading-5 text-[#6e8e7b]">Your topic graph found foundations that can unlock the next chapters. You can study them, skip them with evidence, or return later.</p></div></div></div><div className="mt-8 grid gap-4 lg:grid-cols-2">{prerequisiteTopics.map((topic) => <FoundationCard key={topic.title} topic={topic} onNotify={onNotify} />)}</div><div className="mt-8 rounded-2xl border border-[#e5eae5] bg-white p-5"><div className="flex items-center justify-between"><div><p className="text-xs font-bold uppercase tracking-[0.16em] text-[#a2aba5]">Topic relationship map</p><h2 className="mt-2 font-serif text-2xl font-semibold text-[#304039]">What unlocks what</h2></div><button onClick={() => onNotify('Topic graph expanded')} className="rounded-xl border border-[#e2e8e2] px-3 py-2 text-xs font-semibold text-[#5d9272]">Explore graph</button></div><div className="mt-6 flex flex-wrap items-center gap-2 text-xs"><span className="rounded-xl bg-[#f7f2e9] px-3 py-2 font-semibold text-[#9a7143]">Fractions</span><ArrowRight size={14} className="text-[#b9c3bb]" /><span className="rounded-xl bg-[#eaf5fb] px-3 py-2 font-semibold text-[#247eb7]">Comparing Quantities</span><ArrowRight size={14} className="text-[#b9c3bb]" /><span className="rounded-xl bg-[#eef8f1] px-3 py-2 font-semibold text-[#418762]">Algebraic Expressions</span></div></div></section>
}

function TutorWorkspace({ onNotify }: { onNotify: (message: string) => void }) {
  const [question, setQuestion] = useState('')
  const [answer, setAnswer] = useState('Try asking a question about the selected chapter.')
  const ask = () => { const text = question.trim(); if (!text) return; setAnswer(`Demo tutor response: Think of a percentage as a fraction out of 100. For example, 25% means 25/100, which simplifies to 1/4. This explanation is based on the StudyVerse sample textbook index, not a live model.`); setQuestion(''); onNotify('Demo explanation ready') }
  return <section className="min-h-[70vh]"><p className="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6aaa89]">StudyVerse · AI Tutor</p><div className="flex flex-wrap items-end justify-between gap-4"><div><h1 className="font-serif text-4xl font-semibold text-[#25332c] md:text-5xl">Ask anything, understand everything</h1><p className="mt-4 max-w-xl text-sm leading-7 text-[#7d8982]">Textbook-grounded explanations, with a clear demo label until a live AI provider is connected.</p></div><span className="rounded-full bg-[#f7f2e9] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#a47b3e]">Demo tutor mode</span></div><div className="mt-8 grid gap-5 lg:grid-cols-[1fr_300px]"><div className="rounded-2xl border border-[#e5eae5] bg-white p-5 md:p-7"><div className="flex flex-wrap gap-2"><span className="rounded-lg bg-[#eaf5fb] px-3 py-1.5 text-[11px] font-semibold text-[#247eb7]">Class 8</span><span className="rounded-lg bg-[#eef8f1] px-3 py-1.5 text-[11px] font-semibold text-[#418762]">Mathematics</span><span className="rounded-lg bg-[#f4f6f3] px-3 py-1.5 text-[11px] font-semibold text-[#78877e]">Comparing Quantities</span></div><div className="mt-8 rounded-2xl bg-[#f7faf8] p-5"><p className="text-xs font-bold uppercase tracking-[0.15em] text-[#a2aba5]">Tutor response</p><p className="mt-3 text-sm leading-7 text-[#53655b]">{answer}</p><div className="mt-4 flex flex-wrap gap-2"><button onClick={() => setAnswer('Simpler explanation: percent means “out of one hundred.” So 50% is 50 out of 100, or one half.')} className="rounded-lg border border-[#dde8df] px-3 py-2 text-[11px] font-semibold text-[#5a9070]">Make it simpler</button><button onClick={() => setAnswer('Example: If a ₹200 bag has a 10% discount, the discount is ₹20, so you pay ₹180.')} className="rounded-lg border border-[#dde8df] px-3 py-2 text-[11px] font-semibold text-[#5a9070]">Give an example</button><button onClick={() => onNotify('Quiz opened for Comparing Quantities')} className="rounded-lg bg-[#174a7e] px-3 py-2 text-[11px] font-semibold text-white">Open topic quiz</button></div></div><div className="mt-5 flex gap-2"><input value={question} onChange={(event) => setQuestion(event.target.value)} onKeyDown={(event) => { if (event.nativeEvent.isComposing || event.keyCode === 229) return; if (event.key === 'Enter') ask() }} placeholder="Ask a question about this topic..." aria-label="Ask a question" className="min-w-0 flex-1 rounded-xl border border-[#dfe8e1] px-4 py-3 text-sm outline-none focus:border-[#247eb7]" /><button onClick={ask} className="rounded-xl bg-[#174a7e] px-4 py-3 text-xs font-semibold text-white">Ask tutor</button></div></div><aside className="rounded-2xl border border-[#e5eae5] bg-white p-5"><p className="text-xs font-bold uppercase tracking-[0.16em] text-[#a2aba5]">Textbook context</p><h2 className="mt-2 font-serif text-xl font-semibold text-[#304039]">Sources used</h2><p className="mt-3 text-xs leading-5 text-[#87928a]">Sample content is available for this demo. Live PDF extraction and retrieval will plug into the same metadata contract.</p><div className="mt-5 space-y-3"><div className="rounded-xl bg-[#f7faf8] p-3"><p className="text-xs font-semibold text-[#51655a]">NCERT Class 8 Mathematics</p><p className="mt-1 text-[11px] text-[#8b968f]">Chapter 8 · Comparing Quantities · sample index</p></div><button onClick={() => onNotify('Follow-up question ready')} className="w-full rounded-xl border border-[#dde8df] px-3 py-2.5 text-xs font-semibold text-[#5a9070]">Ask a follow-up</button></div></aside></div></section>
}

export default function Page() {
  return (
    <StudyVerseProvider>
      <StudyVerseApp />
      <Celebration />
    </StudyVerseProvider>
  )
}

const TRACKED_SUBJECTS = ['Mathematics', 'Science']

function StudyVerseApp() {
  const { setPracticeTopic, updateSettings, practiceTopicId } = useStudyVerse()
  const [view, setView] = useState<'landing' | 'onboarding' | 'diagnostic' | 'report' | 'dashboard'>('landing')
  const [profile, setProfile] = useState({ className: 'Class 8', board: 'CBSE', subjects: ['Science'] })
  const [activeNav, setActiveNav] = useState<string>('Overview')
  const go = (nav: NavLabel, topicId?: string) => {
    if (topicId) setPracticeTopic(topicId)
    setActiveNav(nav)
    setMobileNav(false)
    window.scrollTo({ top: 0 })
  }
  const [showNotifications, setShowNotifications] = useState(false)
  const [mobileNav, setMobileNav] = useState(false)
  const [toast, setToast] = useState('')

  const notify = (message: string) => {
    setToast(message)
    window.setTimeout(() => setToast(''), 2400)
  }

  if (view === 'landing') return <Landing onStart={() => setView('onboarding')} />
  if (view === 'onboarding') return <Onboarding onComplete={(choices) => { setProfile(choices); const tricky = choices.subjects.filter((s) => TRACKED_SUBJECTS.includes(s)); if (tricky.length) updateSettings({ weakSubjects: tricky }); setView('diagnostic') }} />
  if (view === 'diagnostic') return <DiagnosticQuiz profile={profile} onComplete={() => setView('report')} />
  if (view === 'report') return <DiagnosticReport onContinue={() => { setView('dashboard'); setActiveNav('Overview'); setToast('Diagnostic complete — your personalized plan is ready') }} />

  return (
    <div className="min-h-screen bg-[#f6f9fc] text-[#26312d]">
      <aside className={`fixed inset-y-0 z-40 flex w-[254px] flex-col border-r border-[#e7ebe6] bg-[#fbfcfa] px-5 py-6 transition-[left] duration-200 lg:left-0 ${mobileNav ? 'left-0' : '-left-[254px]'}`}>
        <div className="mb-12 flex items-center justify-between px-2">
          <button className="flex items-center gap-3" onClick={() => setActiveNav('Overview')} aria-label="StudyVerse home">
            <span className="grid h-9 w-9 place-items-center rounded-xl bg-[#dff2e9] text-[#2e8a64]"><Sparkles size={19} strokeWidth={2.3} /></span>
            <span><span className="block font-serif text-[21px] font-semibold tracking-tight text-[#24342d]">Study<span className="text-[#38a477]">Verse</span></span><span className="block text-[9px] font-semibold uppercase tracking-[0.18em] text-[#9aa49e]">Learn smarter</span></span>
          </button>
          <button className="text-[#83908a] lg:hidden" onClick={() => setMobileNav(false)} aria-label="Close navigation"><X size={20} /></button>
        </div>
        <nav className="space-y-1" aria-label="Main navigation">
          {navItems.map(({ label, icon: Icon }) => <button key={label} onClick={() => { setActiveNav(label); setMobileNav(false) }} className={`flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-[13px] font-medium transition ${activeNav === label ? 'bg-[#e8f5ee] text-[#26835f]' : 'text-[#78837d] hover:bg-[#f0f4f0] hover:text-[#384640]'}`}><Icon size={18} strokeWidth={1.9} /><span>{label}</span>{label === 'Ask a Doubt' && <span className="ml-auto rounded-full bg-[#f0e8d7] px-2 py-0.5 text-[10px] text-[#a47b3e]">AI</span>}</button>)}
        </nav>
        <div className="mt-9 px-3 text-[10px] font-bold uppercase tracking-[0.18em] text-[#b1b9b3]">Your space</div>
        <nav className="mt-2 space-y-1"><button onClick={() => go('Achievements')} aria-current={activeNav === 'Achievements' ? 'page' : undefined} className={`flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-[13px] font-medium hover:bg-[#f0f4f0] ${activeNav === 'Achievements' ? 'bg-[#eaf5fb] text-[#174a7e]' : 'text-[#78837d]'}`}><Trophy size={18} strokeWidth={1.9} />Achievements</button><button onClick={() => go('Study Planner')} className="flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-[13px] font-medium text-[#78837d] hover:bg-[#f0f4f0]"><Target size={18} strokeWidth={1.9} />My goals</button></nav>
        <SidebarStreak onOpen={() => go('Achievements')} />
      </aside>

      <div className="lg:pl-[254px]">
        <header className="sticky top-0 z-30 flex h-[72px] items-center justify-between border-b border-[#e7ebe6] bg-[#f6f9fc]/95 px-5 backdrop-blur md:px-10">
          <div className="flex items-center gap-3"><button className="text-[#65736b] lg:hidden" onClick={() => setMobileNav(true)} aria-label="Open navigation"><Menu size={22} /></button><div className="hidden items-center gap-2 text-xs text-[#94a099] sm:flex"><HeaderDate /><span className="h-1 w-1 rounded-full bg-[#c9d1cb]" /><span>{profile.className} · {profile.board}</span></div></div>
          <div className="flex items-center gap-5"><button className="hidden rounded-xl border border-[#e2e8e2] bg-white px-3 py-2 text-xs text-[#83908a] sm:flex sm:items-center sm:gap-2"><Search size={15} /> Search anything</button><div className="relative"><button onClick={() => setShowNotifications(!showNotifications)} className="relative text-[#819088]" aria-label="Notifications"><Bell size={19} strokeWidth={1.8} /><span className="absolute -right-0.5 -top-0.5 h-1.5 w-1.5 rounded-full bg-[#ef9c70]" /></button>{showNotifications && <div className="absolute right-0 top-8 w-64 rounded-2xl border border-[#e7ebe6] bg-white p-4 text-xs shadow-xl"><p className="font-semibold text-[#34433a]">You have 2 new updates</p><p className="mt-2 text-[#87938b]">Your personalized plan is ready.</p></div>}</div><button onClick={() => notify('Profile menu opened')} className="flex items-center gap-2"><span className="grid h-9 w-9 place-items-center rounded-full bg-[#eadfc9] text-xs font-semibold text-[#806846]">AS</span><ChevronDown size={14} className="text-[#a0aaa3]" /></button></div>
        </header>

        <main className="mx-auto max-w-[1220px] px-5 py-8 md:px-10 md:py-11">
          {activeNav === 'My Learning' ? <LearningWorkspace onNotify={notify} /> : activeNav === 'Ask a Doubt' ? <TutorWorkspace onNotify={notify} /> : activeNav === 'Learning Gaps' ? <LearningGaps onNavigate={go} /> : activeNav === 'Study Planner' ? <StudyPlanner onNavigate={go} /> : activeNav === 'Practice' ? <PracticeQuiz key={practiceTopicId ?? 'practice'} onNavigate={go} /> : activeNav === 'Achievements' ? <Achievements onNavigate={go} /> : activeNav === 'Upload Resources' ? <UploadResources onNotify={notify} /> : <Overview onNavigate={go} />}
        </main>
      </div>
      {toast && <div role="status" className="fixed bottom-6 left-1/2 z-50 flex -translate-x-1/2 items-center gap-2 rounded-xl bg-[#304b3e] px-4 py-3 text-xs font-medium text-white shadow-xl"><Check size={15} className="text-[#9be0b5]" />{toast}</div>}
    </div>
  )
}


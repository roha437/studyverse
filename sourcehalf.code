import { Award, Lock } from 'lucide-react'
import type { ReactNode } from 'react'
import type { EvidenceLevel, MasteryStatus } from '@/lib/studyverse/types'
import type { Milestone } from '@/lib/studyverse/streak'

export type NavLabel = 'Overview' | 'My Learning' | 'Learning Gaps' | 'Study Planner' | 'Practice' | 'Ask a Doubt' | 'Upload Resources' | 'Achievements'
export type Navigate = (nav: NavLabel, practiceTopicId?: string) => void

export function PageIntro({ eyebrow, title, description, badge }: { eyebrow: string; title: string; description: string; badge?: ReactNode }) {
  return (
    <div className="flex flex-wrap items-end justify-between gap-4">
      <div className="max-w-2xl">
        <p className="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-[#6aaa89]">StudyVerse · {eyebrow}</p>
        <h1 className="font-serif text-4xl font-semibold text-[#25332c] md:text-5xl text-balance">{title}</h1>
        <p className="mt-4 text-sm leading-7 text-[#7d8982]">{description}</p>
      </div>
      {badge}
    </div>
  )
}

export function DemoBadge({ children = 'Demo engine' }: { children?: ReactNode }) {
  return <span className="rounded-full bg-[#f7f2e9] px-3 py-1.5 text-[10px] font-bold uppercase tracking-wider text-[#a47b3e]">{children}</span>
}

const statusStyles: Record<MasteryStatus, { label: string; className: string; bar: string }> = {
  weak: { label: 'Needs attention', className: 'bg-[#fff0e1] text-[#9b663c]', bar: 'bg-[#e09b69]' },
  uncertain: { label: 'Uncertain', className: 'bg-[#eaf5fb] text-[#1f6c9e]', bar: 'bg-[#6fb3dc]' },
  strength: { label: 'Demonstrated strength', className: 'bg-[#e8f5ee] text-[#2e7655]', bar: 'bg-[#58ad7f]' },
  unassessed: { label: 'Not yet assessed', className: 'bg-[#f1f5f9] text-[#64748b]', bar: 'bg-[#cbd5e1]' },
}

export const statusBar = (status: MasteryStatus) => statusStyles[status].bar
export const statusLabel = (status: MasteryStatus) => statusStyles[status].label

export function StatusPill({ status }: { status: MasteryStatus }) {
  const s = statusStyles[status]
  return <span className={`rounded-full px-2.5 py-1 text-[10px] font-semibold ${s.className}`}>{s.label}</span>
}

const evidenceStyles: Record<EvidenceLevel, string> = {
  None: 'bg-[#f1f5f9] text-[#64748b]',
  Preliminary: 'bg-[#f7f2e9] text-[#94672f]',
  Moderate: 'bg-[#eee9f9] text-[#62548e]',
  Stronger: 'bg-[#e8f5ee] text-[#2e7655]',
}

export function EvidenceBadge({ level }: { level: EvidenceLevel }) {
  return <span className={`rounded-full px-2.5 py-1 text-[10px] font-semibold ${evidenceStyles[level]}`}>{level === 'None' ? 'No evidence yet' : `${level} evidence`}</span>
}

export function ProgressBar({ value, barClassName = 'bg-[#58ad7f]', trackClassName = 'bg-[#edf0ed]', label }: { value: number; barClassName?: string; trackClassName?: string; label?: string }) {
  const clamped = Math.max(0, Math.min(100, value))
  return (
    <div className={`h-2 overflow-hidden rounded-full ${trackClassName}`} role="progressbar" aria-valuenow={Math.round(clamped)} aria-valuemin={0} aria-valuemax={100} aria-label={label}>
      <div className={`h-full rounded-full transition-all duration-500 ${barClassName}`} style={{ width: `${clamped}%` }} />
    </div>
  )
}

const badgeTones: Record<Milestone['tone'], { ring: string; icon: string; text: string }> = {
  bronze: { ring: 'bg-gradient-to-br from-[#f6dcc2] to-[#d9a273]', icon: 'text-[#7a4a22]', text: 'text-[#8a5a32]' },
  silver: { ring: 'bg-gradient-to-br from-[#f1f4f7] to-[#b8c2cc]', icon: 'text-[#4b5866]', text: 'text-[#5b6875]' },
  gold: { ring: 'bg-gradient-to-br from-[#fbefc4] to-[#e0b44a]', icon: 'text-[#7a5a0c]', text: 'text-[#8a6a14]' },
}

export function RewardBadge({ milestone, earned, size = 'md' }: { milestone: Milestone; earned: boolean; size?: 'md' | 'lg' }) {
  const tone = badgeTones[milestone.tone]
  const dims = size === 'lg' ? 'h-24 w-24' : 'h-14 w-14'
  return (
    <span className={`relative grid shrink-0 place-items-center rounded-full ${dims} ${earned ? tone.ring : 'bg-[#eef1f4]'} shadow-inner`} aria-hidden="true">
      <span className={`grid place-items-center rounded-full bg-white/60 ${size === 'lg' ? 'h-16 w-16' : 'h-10 w-10'}`}>
        {earned ? <Award size={size === 'lg' ? 34 : 20} className={tone.icon} /> : <Lock size={size === 'lg' ? 26 : 16} className="text-[#a0aab4]" />}
      </span>
    </span>
  )
}

export const badgeText = (milestone: Milestone) => badgeTones[milestone.tone].text


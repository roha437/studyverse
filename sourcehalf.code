FILE: components/studyverse/store.tsx
================================================================================
'use client'

import { createContext, useCallback, useContext, useMemo, useState, type ReactNode } from 'react'
import { computeStats, explainChange, recommend, type StatsMap } from '@/lib/studyverse/engine'
import { buildPlan } from '@/lib/studyverse/plan'
import { computeStreak, type EarnedReward, type StreakInfo } from '@/lib/studyverse/streak'
import { createSeed } from '@/lib/studyverse/seed'
import { dateKeyInZone, DEFAULT_TIME_ZONE } from '@/lib/studyverse/dates'
import type { Activity, ChangeSummary, PlanDay, PlannerSettings, PlanTask, QuizRecord, QuizResponse, Recommendation, UploadItem } from '@/lib/studyverse/types'

export const MAX_UPLOAD_BYTES = 10 * 1024 * 1024
export const MAX_UPLOADS = 10

type State = {
  records: QuizRecord[]
  activities: Activity[]
  settings: PlannerSettings
  rescheduled: Record<string, string>
  uploads: UploadItem[]
  lastChange: ChangeSummary | null
  practiceTopicId: string | null
}

type Store = State & {
  today: string
  stats: StatsMap
  recs: Recommendation[]
  streak: StreakInfo
  plan: PlanDay[]
  celebration: EarnedReward | null
  dismissCelebration: () => void
  submitQuiz: (title: string, responses: QuizResponse[]) => ChangeSummary
  toggleTask: (task: PlanTask) => void
  isTaskDone: (taskId: string) => boolean
  rescheduleTask: (taskId: string, toDate: string) => void
  updateSettings: (patch: Partial<PlannerSettings>) => void
  setPracticeTopic: (topicId: string | null) => void
  addUploads: (files: File[]) => Promise<void>
  removeUpload: (id: string) => void
}

const StoreContext = createContext<Store | null>(null)

const defaultSettings: PlannerSettings = {
  dailyMinutes: 30,
  studyDays: [1, 2, 3, 4, 5, 6],
  preferredTime: 'Evening',
  weakSubjects: ['Mathematics'],
  goalSubjects: [],
  goalNote: 'Feel confident in Class 8 Mathematics before the half-yearly exam',
  timeZone: DEFAULT_TIME_ZONE,
}

async function validatePdf(file: File, existing: UploadItem[]): Promise<string | null> {
  if (!/\.pdf$/i.test(file.name)) return 'Only PDF files are supported.'
  if (file.type && file.type !== 'application/pdf') return 'This file does not look like a PDF.'
  if (file.size === 0) return 'This file is empty.'
  if (file.size > MAX_UPLOAD_BYTES) return 'Files must be 10 MB or smaller.'
  if (existing.some((u) => u.name === file.name && u.size === file.size && u.status !== 'error')) return 'This file has already been added.'
  const header = new Uint8Array(await file.slice(0, 5).arrayBuffer())
  if (String.fromCharCode(...header) !== '%PDF-') return 'The file contents are not a valid PDF.'
  return null
}

export function StudyVerseProvider({ children }: { children: ReactNode }) {
  const [state, setState] = useState<State>(() => {
    const seed = createSeed(dateKeyInZone(new Date(), DEFAULT_TIME_ZONE))
    return { ...seed, settings: defaultSettings, rescheduled: {}, uploads: [], lastChange: null, practiceTopicId: null }
  })
  const [celebration, setCelebration] = useState<EarnedReward | null>(null)

  const { settings } = state
  const today = dateKeyInZone(new Date(), settings.timeZone)
  const stats = useMemo(() => computeStats(state.records), [state.records])
  const recs = useMemo(() => recommend(stats, settings), [stats, settings])
  const streak = useMemo(() => computeStreak(state.activities, settings.timeZone, today, settings.dailyMinutes), [state.activities, settings.timeZone, settings.dailyMinutes, today])
  const plan = useMemo(() => buildPlan({ today, settings, recs, stats, rescheduled: state.rescheduled }), [today, settings, recs, stats, state.rescheduled])

  const celebrateNewRewards = useCallback((nextActivities: Activity[]) => {
    const before = new Set(streak.rewards.map((r) => r.milestone.id))
    const after = computeStreak(nextActivities, settings.timeZone, today, settings.dailyMinutes).rewards
    const fresh = after.find((r) => !before.has(r.milestone.id))
    if (fresh) setCelebration(fresh)
  }, [streak.rewards, settings.timeZone, settings.dailyMinutes, today])

  const submitQuiz = useCallback((title: string, responses: QuizResponse[]) => {
    const record: QuizRecord = { id: `quiz-${Date.now()}`, takenAt: new Date().toISOString(), title, responses }
    const nextRecords = [...state.records, record]
    const nextStats = computeStats(nextRecords)
    const nextRecs = recommend(nextStats, settings)
    const summary = explainChange(stats, nextStats, recs, nextRecs, record)
    const activity: Activity = { id: `quiz:${record.id}`, at: record.takenAt, minutes: responses.length * 2, goalMinutes: settings.dailyMinutes, label: title, kind: 'quiz' }
    const nextActivities = state.activities.some((a) => a.id === activity.id) ? state.activities : [...state.activities, activity]
    celebrateNewRewards(nextActivities)
    setState((prev) => ({ ...prev, records: [...prev.records, record], activities: prev.activities.some((a) => a.id === activity.id) ? prev.activities : [...prev.activities, activity], lastChange: summary }))
    return summary
  }, [state.records, state.activities, settings, stats, recs, celebrateNewRewards])

  const isTaskDone = useCallback((taskId: string) => state.activities.some((a) => a.id === `task:${taskId}`), [state.activities])

  const toggleTask = useCallback((task: PlanTask) => {
    const activityId = `task:${task.id}`
    const done = state.activities.some((a) => a.id === activityId)
    if (done) {
      setState((prev) => ({ ...prev, activities: prev.activities.filter((a) => a.id !== activityId) }))
      return
    }
    const activity: Activity = { id: activityId, at: new Date().toISOString(), minutes: task.minutes, goalMinutes: settings.dailyMinutes, label: task.title, kind: 'task' }
    celebrateNewRewards([...state.activities, activity])
    setState((prev) => prev.activities.some((a) => a.id === activityId) ? prev : { ...prev, activities: [...prev.activities, activity] })
  }, [state.activities, settings.dailyMinutes, celebrateNewRewards])

  const rescheduleTask = useCallback((taskId: string, toDate: string) => {
    setState((prev) => ({ ...prev, rescheduled: { ...prev.rescheduled, [taskId]: toDate } }))
  }, [])

  const updateSettings = useCallback((patch: Partial<PlannerSettings>) => {
    setState((prev) => ({ ...prev, settings: { ...prev.settings, ...patch } }))
  }, [])

  const setPracticeTopic = useCallback((topicId: string | null) => {
    setState((prev) => ({ ...prev, practiceTopicId: topicId }))
  }, [])

  const patchUpload = useCallback((id: string, patch: Partial<UploadItem>) => {
    setState((prev) => ({ ...prev, uploads: prev.uploads.map((u) => (u.id === id ? { ...u, ...patch } : u)) }))
  }, [])

  const addUploads = useCallback(async (files: File[]) => {
    const slots = Math.max(0, MAX_UPLOADS - state.uploads.filter((u) => u.status !== 'error').length)
    const accepted: UploadItem[] = []
    for (const [index, file] of files.entries()) {
      const id = `upload-${Date.now()}-${index}`
      const item: UploadItem = { id, name: file.name, size: file.size, status: 'validating', progress: 0, addedAt: new Date().toISOString() }
      setState((prev) => ({ ...prev, uploads: [item, ...prev.uploads] }))
      const error = index >= slots ? `You can keep up to ${MAX_UPLOADS} resources in this prototype.` : await validatePdf(file, [...state.uploads, ...accepted])
      if (error) {
        patchUpload(id, { status: 'error', error })
        continue
      }
      accepted.push(item)
      patchUpload(id, { status: 'uploading' })
      let progress = 0
      const timer = window.setInterval(() => {
        progress = Math.min(100, progress + 9 + Math.round(Math.random() * 8))
        patchUpload(id, progress >= 100 ? { progress: 100, status: 'received' } : { progress })
        if (progress >= 100) window.clearInterval(timer)
      }, 160)
    }
  }, [state.uploads, patchUpload])

  const removeUpload = useCallback((id: string) => {
    setState((prev) => ({ ...prev, uploads: prev.uploads.filter((u) => u.id !== id) }))
  }, [])

  const value: Store = {
    ...state,
    today,
    stats,
    recs,
    streak,
    plan,
    celebration,
    dismissCelebration: () => setCelebration(null),
    submitQuiz,
    toggleTask,
    isTaskDone,
    rescheduleTask,
    updateSettings,
    setPracticeTopic,
    addUploads,
    removeUpload,
  }

  return <StoreContext.Provider value={value}>{children}</StoreContext.Provider>
}

export function useStudyVerse() {
  const ctx = useContext(StoreContext)
  if (!ctx) throw new Error('useStudyVerse must be used inside StudyVerseProvider')
  return ctx
}


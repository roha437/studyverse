import { questionById, wrongOptionIndex } from './content'
import { addDays } from './dates'
import type { Activity, QuizRecord, QuizResponse } from './types'

type Pick = 'c' | 0 | 1 | 2

export function buildResponse(questionId: string, pick: Pick, reasoningNote?: string): QuizResponse {
  const question = questionById(questionId)
  const choice = pick === 'c' ? question.answer : wrongOptionIndex(question, pick)
  const correct = choice === question.answer
  return { questionId, topicId: question.topicId, choice, correct, misconception: correct ? undefined : question.traps[choice], reasoningNote }
}

const seedQuizzes: { daysAgo: number; title: string; answers: [string, Pick, string?][] }[] = [
  { daysAgo: 20, title: 'Diagnostic quiz', answers: [['f1', 0], ['m1', 'c'], ['l1', 'c'], ['i1', 'c'], ['a1', 0, 'Explanation skipped multiplying the second term in the bracket']] },
  { daysAgo: 14, title: 'Fractions & percentages check', answers: [['f2', 0], ['f3', 'c'], ['c1', 0], ['c2', 'c']] },
  { daysAgo: 9, title: 'Integers & brackets practice', answers: [['i2', 'c'], ['i3', 'c'], ['i4', 0], ['d1', 'c'], ['d2', 0, 'Reasoning showed a sign error when distributing −2']] },
  { daysAgo: 6, title: 'Mixed Class 8 practice', answers: [['a2', 'c'], ['a3', 0, 'Explanation suggests difficulty applying the distributive property to a subtracted bracket'], ['m2', 'c'], ['m3', 'c'], ['p1', 'c'], ['p2', 0]] },
  { daysAgo: 3, title: 'Weekly review quiz', answers: [['f4', 'c'], ['f2', 1], ['c3', 1], ['c4', 2], ['l2', 'c'], ['l3', 0], ['m4', 'c'], ['m1', 'c'], ['p3', 'c'], ['p4', 1]] },
]

const studyMinutesByDaysAgo: Record<number, number> = {
  30: 35, 29: 40, 28: 30, 27: 45, 26: 35, 25: 30,
  23: 15, 21: 20, 20: 40, 18: 10, 15: 35, 14: 45, 12: 15,
  9: 35, 8: 40, 7: 30, 6: 50, 5: 35, 4: 30, 3: 45, 2: 35, 1: 40,
}

export function createSeed(today: string) {
  const at = (daysAgo: number) => `${addDays(today, -daysAgo)}T12:00:00.000Z`
  const records: QuizRecord[] = seedQuizzes.map((quiz, i) => ({
    id: `seed-quiz-${i + 1}`,
    takenAt: at(quiz.daysAgo),
    title: quiz.title,
    responses: quiz.answers.map(([id, pick, note]) => buildResponse(id, pick, note)),
  }))
  const activities: Activity[] = Object.entries(studyMinutesByDaysAgo).map(([daysAgo, minutes]) => ({
    id: `seed-session-${daysAgo}`,
    at: at(Number(daysAgo)),
    minutes,
    goalMinutes: 30,
    label: 'Planned study session',
    kind: 'session',
  }))
  return { records, activities }
}

